---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { createEvent, type EventFormValues, type FieldErrors } from "@/lib/services/events";
import { SPORTS } from "@/lib/sports";
import { nowLocalDateTime } from "@/lib/time";

// Trasa jest chroniona w middleware, więc użytkownik jest zalogowany.
const user = Astro.locals.user;

let values: EventFormValues = {
  sport: "",
  area: "",
  place: "",
  startsAt: "",
  spots: "",
  description: "",
};
let errors: FieldErrors = {};

if (Astro.request.method === "POST" && user) {
  const form = await Astro.request.formData();
  const field = (name: string) => {
    const value = form.get(name);
    return typeof value === "string" ? value : "";
  };
  values = {
    sport: field("sport"),
    area: field("area"),
    place: field("place"),
    startsAt: field("startsAt"),
    spots: field("spots"),
    description: field("description"),
  };

  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    errors = { form: "Brak konfiguracji bazy danych." };
  } else {
    const result = await createEvent(supabase, user.id, values);
    if (result.ok) {
      return Astro.redirect("/events?created=1");
    }
    errors = result.errors;
    Astro.response.status = 400;
  }
}

const minStartsAt = nowLocalDateTime();
const inputClass =
  "mt-1 w-full rounded-lg border bg-white/10 px-3 py-2 text-white placeholder-white/40 focus:ring-2 focus:outline-none";
const borderClass = (name: keyof FieldErrors) =>
  errors[name] ? "border-red-400/60 focus:ring-red-400" : "border-white/20 focus:ring-purple-400";
---

<Layout title="Dodaj ogłoszenie · DoItNow">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h1 class="mb-4 text-2xl font-bold">Dodaj ogłoszenie</h1>

        {errors.form && <p class="mb-4 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-200">{errors.form}</p>}

        <form method="POST" class="grid gap-4" novalidate>
          <label class="text-sm text-blue-100/80">
            Sport
            <select name="sport" required class:list={[inputClass, borderClass("sport")]}>
              <option value="" class="text-black">
                Wybierz…
              </option>
              {SPORTS.map((s) => (
                <option value={s.id} selected={s.id === values.sport} class="text-black">
                  {s.label}
                </option>
              ))}
            </select>
            {errors.sport && <span class="mt-1 block text-xs text-red-300">{errors.sport}</span>}
          </label>

          <label class="text-sm text-blue-100/80">
            Data i godzina
            <input
              type="datetime-local"
              name="startsAt"
              required
              min={minStartsAt}
              value={values.startsAt}
              class:list={[inputClass, borderClass("startsAt")]}
            />
            {errors.startsAt && <span class="mt-1 block text-xs text-red-300">{errors.startsAt}</span>}
          </label>

          <label class="text-sm text-blue-100/80">
            Okolica / dzielnica
            <input
              type="text"
              name="area"
              required
              maxlength="80"
              placeholder="np. Mokotów"
              value={values.area}
              class:list={[inputClass, borderClass("area")]}
            />
            <span class="mt-1 block text-xs text-blue-100/50">Widoczna dla wszystkich, także niezalogowanych.</span>
            {errors.area && <span class="mt-1 block text-xs text-red-300">{errors.area}</span>}
          </label>

          <label class="text-sm text-blue-100/80">
            Dokładne miejsce
            <input
              type="text"
              name="place"
              required
              maxlength="200"
              placeholder="np. Orlik przy ul. Dolnej 5"
              value={values.place}
              class:list={[inputClass, borderClass("place")]}
            />
            <span class="mt-1 block text-xs text-blue-100/50">Widoczne tylko dla zalogowanych.</span>
            {errors.place && <span class="mt-1 block text-xs text-red-300">{errors.place}</span>}
          </label>

          <label class="text-sm text-blue-100/80">
            Ile osób potrzebujesz (bez Ciebie)
            <input
              type="number"
              name="spots"
              required
              min="1"
              max="50"
              value={values.spots}
              class:list={[inputClass, borderClass("spots")]}
            />
            {errors.spots && <span class="mt-1 block text-xs text-red-300">{errors.spots}</span>}
          </label>

          <label class="text-sm text-blue-100/80">
            Opis (opcjonalnie)
            <textarea
              name="description"
              rows="3"
              maxlength="1000"
              placeholder="Poziom gry, co zabrać, jak się rozpoznać…"
              class:list={[inputClass, borderClass("description")]}
            >{values.description}</textarea>
            {errors.description && <span class="mt-1 block text-xs text-red-300">{errors.description}</span>}
          </label>

          <button
            type="submit"
            class="rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
          >
            Opublikuj ogłoszenie
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
