---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EventForm from "@/components/events/EventForm.astro";
import { EMPTY_EVENT_FORM, readEventForm } from "@/lib/event-form";
import { createClient } from "@/lib/supabase";
import { createEvent, organizerHome, type EventFormValues, type FieldErrors } from "@/lib/services/events";
import { NEAR_COOKIE, parseNear } from "@/lib/near";
import { listVenues } from "@/lib/services/venues";
import type { VenueWithHours } from "@/types";

// Trasa jest chroniona w middleware, więc użytkownik jest zalogowany.
const user = Astro.locals.user;

let values: EventFormValues = EMPTY_EVENT_FORM;
let errors: FieldErrors = {};

const venueClient = createClient(Astro.request.headers, Astro.cookies);
const venues: VenueWithHours[] = venueClient ? await listVenues(venueClient) : [];
const home =
  venueClient && user
    ? await organizerHome(venueClient, user.id, parseNear(Astro.cookies.get(NEAR_COOKIE)?.value))
    : null;

if (Astro.request.method === "POST" && user) {
  values = await readEventForm(Astro.request);
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    errors = { form: "Brak konfiguracji bazy danych." };
  } else {
    const result = await createEvent(supabase, user.id, values);
    if (result.ok) {
      return Astro.redirect(`/events/${result.event.id}?ok=created`);
    }
    errors = result.errors;
    Astro.response.status = 400;
  }
}
---

<Layout title="Dodaj ogłoszenie · Metando">
  <div class="bg-app min-h-screen p-4 pb-32">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="rounded-3xl border border-line bg-card shadow-card p-6 text-ink backdrop-blur-xl">
        <h1 class="display mb-4 text-3xl font-bold">Dodaj ogłoszenie</h1>
        <EventForm values={values} errors={errors} venues={venues} home={home} submitLabel="Opublikuj ogłoszenie" />
      </div>
    </div>
  </div>
</Layout>
