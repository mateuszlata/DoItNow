---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import EventForm from "@/components/events/EventForm.astro";
import { EMPTY_EVENT_FORM, readEventForm } from "@/lib/event-form";
import { createClient } from "@/lib/supabase";
import { createEvent, type EventFormValues, type FieldErrors } from "@/lib/services/events";

// Trasa jest chroniona w middleware, więc użytkownik jest zalogowany.
const user = Astro.locals.user;

let values: EventFormValues = EMPTY_EVENT_FORM;
let errors: FieldErrors = {};

if (Astro.request.method === "POST" && user) {
  values = await readEventForm(Astro.request);
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    errors = { form: "Brak konfiguracji bazy danych." };
  } else {
    const result = await createEvent(supabase, user.id, values);
    if (result.ok) {
      return Astro.redirect("/events?created=1");
    }
    errors = result.errors;
    Astro.response.status = 400;
  }
}
---

<Layout title="Dodaj ogłoszenie · Ktoś/Coś">
  <div class="bg-app min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-6 text-slate-900 backdrop-blur-xl">
        <h1 class="mb-4 text-2xl font-bold">Dodaj ogłoszenie</h1>
        <EventForm values={values} errors={errors} submitLabel="Opublikuj ogłoszenie" />
      </div>
    </div>
  </div>
</Layout>
