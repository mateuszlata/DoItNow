---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SlotGrid from "@/components/events/SlotGrid.astro";
import EventMap from "@/components/map/EventMap";
import { createClient } from "@/lib/supabase";
import { canEditEvent, getEventDetails, getPublicEvent, needsAnswer } from "@/lib/services/events";
import { STATUS_LABELS, canWithdrawAccepted, participationErrorMessage } from "@/lib/services/participations";
import { freeReserve, minimumLabel, missingToMinimum, teamSize } from "@/lib/capacity";
import { sportLabel } from "@/lib/sports";
import { formatEventDate } from "@/lib/time";
import type { EventDetails, PublicEvent } from "@/types";

const { user } = Astro.locals;
const id = Astro.params.id ?? "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let details: EventDetails | null = null;
let publicEvent: PublicEvent | null = null;
if (supabase) {
  if (user) {
    details = await getEventDetails(supabase, id, user.id);
  } else {
    publicEvent = await getPublicEvent(supabase, id);
  }
}

if (!details && !publicEvent) {
  Astro.response.status = 404;
}

// Wspólne liczby dla zalogowanych i gości (goście dostają je z ograniczonego widoku).
const summary = details
  ? {
      sport: details.sport,
      area: details.area,
      starts_at: details.starts_at,
      spots: details.spots,
      organizer_plays: details.organizer_plays,
      accepted_count: details.participants.length,
      reserve_spots: details.reserve_spots,
      reserve_count: details.reserves.length,
      min_people: details.min_people,
      requires_approval: details.requires_approval,
    }
  : publicEvent;

const SUCCESS_MESSAGES: Record<string, string> = {
  joined: "Zgłoszenie wysłane. Organizator musi je zaakceptować.",
  removed: "Usunięto osobę ze spotkania.",
  withdrawn: "Twoje zgłoszenie zostało wycofane.",
  accepted: "Zgłoszenie zaakceptowane.",
  rejected: "Zgłoszenie odrzucone.",
  updated: "Zmiany zostały zapisane.",
  cancelled: "Spotkanie zostało odwołane.",
  stayed: "Zostajesz w spotkaniu.",
  left: "Zrezygnowałeś ze spotkania.",
};
const okKey = Astro.url.searchParams.get("ok") ?? "";
const okMessage =
  okKey === "joined" && details?.my_participation?.status === "accepted"
    ? "Dołączyłeś — jesteś w składzie!"
    : okKey === "joined" && details?.my_participation?.status === "reserve"
      ? "Skład jest pełny — jesteś na liście rezerwowej i wskoczysz, gdy zwolni się miejsce."
      : okKey === "cancelled" && details?.status === "organizer_left"
        ? "Odwołałeś spotkanie. Zaakceptowani uczestnicy zdecydują, czy spotkają się bez Ciebie."
        : okKey === "stayed" && details?.organizer_id === user?.id
          ? "Zostajesz w spotkaniu i przejmujesz jego organizację."
          : SUCCESS_MESSAGES[okKey];
const errorMessage = participationErrorMessage(Astro.url.searchParams.get("error"));

const isPast = summary ? new Date(summary.starts_at).getTime() <= Date.now() : false;
const isCancelled = details?.status === "cancelled";
const organizerLeft = details?.status === "organizer_left";
const isOpen = details !== null && !isPast && details.status === "active";
const isOrganizer = details !== null && user !== null && details.organizer_id === user.id;
const myParticipation = details?.my_participation ?? null;
const myStatus = myParticipation?.status ?? null;
const mustAnswer = details !== null && needsAnswer(details, myStatus, myParticipation?.stay_confirmed ?? null);

const canJoin = isOpen && !isOrganizer && (myStatus === null || myStatus === "withdrawn");
// Oczekujące zgłoszenie i rezerwa nie zajmują miejsca, więc można je wycofać do startu;
// zaakceptowany uczestnik do 12 h przed — chyba że organizator odwołał spotkanie.
const canWithdraw =
  details !== null &&
  !isPast &&
  !isCancelled &&
  !mustAnswer &&
  (myStatus === "pending" ||
    myStatus === "reserve" ||
    (myStatus === "accepted" && (details.handover_at !== null || canWithdrawAccepted(details.starts_at))));
const withdrawLocked = isOpen && myStatus === "accepted" && !canWithdraw && !mustAnswer;

const free = details
  ? details.free_spots
  : publicEvent
    ? Math.max(publicEvent.spots - publicEvent.accepted_count, 0)
    : 0;
const reserveFree = summary ? freeReserve(summary) : 0;
const minimum = summary ? minimumLabel(summary) : null;
const minimumMet = summary ? missingToMinimum(summary) === 0 : false;
const navigateHref =
  details?.lat != null && details.lng != null
    ? `https://www.google.com/maps/dir/?api=1&destination=${String(details.lat)},${String(details.lng)}`
    : null;
---

<Layout title={summary ? `${sportLabel(summary.sport)} · Metando` : "Nie znaleziono · Metando"}>
  <div class="bg-app min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <a href="/events" class="mb-3 inline-block text-sm text-page-link font-semibold hover:underline">
        ← Wszystkie ogłoszenia
      </a>

      {okMessage && (
        <p class="mb-3 rounded-2xl border border-ok-line bg-ok-soft px-4 py-2 text-sm text-ok">{okMessage}</p>
      )}
      {errorMessage && (
        <p class="mb-3 rounded-2xl border border-bad-line bg-bad-soft px-4 py-2 text-sm text-bad">{errorMessage}</p>
      )}

      {!summary && (
        <div class="rounded-3xl border border-line bg-card shadow-card p-6 text-center text-ink">
          <h1 class="mb-2 text-xl font-bold">Nie znaleziono ogłoszenia</h1>
          <p class="text-sm text-ink-2">Ogłoszenie nie istnieje albo już się odbyło.</p>
        </div>
      )}

      {summary && (
        <article class="rounded-3xl border border-line bg-card shadow-card p-6 text-ink backdrop-blur-xl">
          {isCancelled && (
            <p class="mb-3 rounded-2xl bg-bad-soft px-3 py-2 text-sm text-bad">To spotkanie zostało odwołane.</p>
          )}
          {isPast && !isCancelled && (
            <p class="mb-3 rounded-2xl bg-card shadow-card px-3 py-2 text-sm text-ink-2">
              To spotkanie już się odbyło.
            </p>
          )}
          {organizerLeft && !isPast && (
            <p class="mb-3 rounded-2xl bg-warn-soft px-3 py-2 text-sm text-warn" data-testid="handover-status">
              {isOrganizer
                ? "Odwołałeś to spotkanie. Czekamy, czy ktoś z uczestników zostanie i przejmie organizację."
                : "Organizator zrezygnował. Spotkanie odbędzie się, jeśli uczestnicy zdecydują się zostać — pierwsza osoba, która zostanie, przejmuje organizację."}
            </p>
          )}

          {mustAnswer && details && (
            <section class="mb-4 rounded-xl border border-warn-line bg-warn-soft p-4" data-testid="handover-question">
              <p class="text-sm text-warn">
                <strong>Organizator odwołał spotkanie.</strong> Czy mimo to chcesz w nim zostać i spotkać się z osobami,
                które się zapisały?
              </p>
              <form method="POST" action={`/api/events/${details.id}/respond`} class="mt-3 flex flex-wrap gap-2">
                <button
                  type="submit"
                  name="stay"
                  value="yes"
                  class="rounded-full bg-green-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-green-500"
                >
                  Zostaję
                </button>
                <button
                  type="submit"
                  name="stay"
                  value="no"
                  class="rounded-full border border-line-strong bg-card shadow-card px-4 py-2 text-sm transition-colors hover:bg-card-2"
                >
                  Rezygnuję
                </button>
              </form>
            </section>
          )}

          <h1 class="display text-3xl font-bold">{sportLabel(summary.sport)}</h1>
          <p class="mt-1 text-date">{formatEventDate(summary.starts_at)}</p>

          <dl class="mt-4 grid gap-3 text-sm">
            <div>
              <dt class="text-ink-3">Okolica</dt>
              <dd>{summary.area}</dd>
            </div>
            {details && (
              <>
                <div>
                  <dt class="text-ink-3">Dokładne miejsce</dt>
                  <dd>{details.place}</dd>
                </div>
                <div>
                  <dt class="text-ink-3">Organizator</dt>
                  <dd>{organizerLeft ? "— (organizator zrezygnował)" : details.organizer_name}</dd>
                </div>
              </>
            )}
            <div>
              <dt class="text-ink-3">Wolne miejsca</dt>
              <dd data-testid="free-spots">
                <strong>{free}</strong> z {teamSize(summary)}
                {summary.organizer_plays && <span class="text-ink-3"> (łącznie z organizatorem)</span>}
              </dd>
            </div>
            {summary.reserve_spots > 0 && (
              <div>
                <dt class="text-ink-3">Lista rezerwowa</dt>
                <dd data-testid="reserve-summary">
                  wolne: <strong>{reserveFree}</strong> z {summary.reserve_spots}
                </dd>
              </div>
            )}
            <div>
              <dt class="text-ink-3">Dołączanie</dt>
              <dd data-testid="join-mode">
                {summary.requires_approval ? "po akceptacji organizatora" : "od razu, bez akceptacji"}
              </dd>
            </div>
            {minimum && (
              <div>
                <dt class="text-ink-3">Minimum</dt>
                <dd class:list={[minimumMet ? "text-ok" : "text-warn"]} data-testid="minimum">
                  {minimum}
                </dd>
              </div>
            )}
            {details?.description && (
              <div>
                <dt class="text-ink-3">Opis</dt>
                <dd class="whitespace-pre-line">{details.description}</dd>
              </div>
            )}
          </dl>

          {details?.lat != null && details.lng != null && (
            <section class="mt-4">
              <EventMap lat={details.lat} lng={details.lng} label={details.place} client:visible />
              {navigateHref && (
                <a
                  href={navigateHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-block text-sm text-link hover:underline"
                >
                  Nawiguj do miejsca spotkania ↗
                </a>
              )}
            </section>
          )}

          {details && !isOrganizer && !mustAnswer && (
            <section class="mt-6 rounded-xl border border-line bg-card-2 p-4">
              {myStatus && myStatus !== "withdrawn" && (
                <p class="mb-3 text-sm" data-testid="my-status">
                  Twoje zgłoszenie: <strong>{STATUS_LABELS[myStatus]}</strong>
                </p>
              )}
              {canJoin && (
                <form method="POST" action={`/api/events/${details.id}/join`}>
                  <button
                    type="submit"
                    class="w-full rounded-full bg-brand px-4 py-2 font-medium text-on-brand transition-colors hover:bg-brand-hover"
                  >
                    {details.requires_approval ? "Zgłoś się" : "Dołącz"}
                  </button>
                </form>
              )}
              {canWithdraw && (
                <form method="POST" action={`/api/events/${details.id}/withdraw`}>
                  <button
                    type="submit"
                    class="w-full rounded-full border border-line-strong bg-card shadow-card px-4 py-2 text-sm transition-colors hover:bg-card-2"
                  >
                    {myStatus === "accepted"
                      ? "Zrezygnuj z udziału"
                      : myStatus === "reserve"
                        ? "Zrezygnuj z rezerwy"
                        : "Wycofaj zgłoszenie"}
                  </button>
                </form>
              )}
              {withdrawLocked && (
                <p class="text-sm text-ink-2">Rezygnacja jest możliwa najpóźniej 12 h przed spotkaniem.</p>
              )}
              {!isOpen && !myStatus && <p class="text-sm text-ink-2">Zapisy na to spotkanie są zamknięte.</p>}
            </section>
          )}

          {isOrganizer && details && isOpen && (
            <section class="mt-6 flex flex-wrap items-center gap-3" data-testid="organizer-actions">
              {canEditEvent(details.starts_at) ? (
                <a
                  href={`/events/${details.id}/edit`}
                  class="rounded-full border border-line-strong bg-card shadow-card px-4 py-2 text-sm transition-colors hover:bg-card-2"
                >
                  Edytuj
                </a>
              ) : (
                <span class="text-sm text-ink-2">Edycja jest możliwa najpóźniej 12 h przed spotkaniem.</span>
              )}
              <form
                method="POST"
                action={`/api/events/${details.id}/cancel`}
                onsubmit="return confirm('Odwołać spotkanie? Jeśli są zaakceptowani uczestnicy, zdecydują, czy spotkają się bez Ciebie.')"
              >
                <button
                  type="submit"
                  class="rounded-full border border-bad-line bg-bad-soft px-4 py-2 text-sm text-bad transition-colors hover:bg-bad-soft"
                >
                  Odwołaj spotkanie
                </button>
              </form>
            </section>
          )}

          {isOrganizer && details && isOpen && (details.requires_approval || details.pending.length > 0) && (
            <section class="mt-6 rounded-xl border border-line bg-card-2 p-4">
              <h2 class="mb-2 font-semibold">Zgłoszenia do rozpatrzenia</h2>
              {details.pending.length === 0 ? (
                <p class="text-sm text-ink-3">Brak oczekujących zgłoszeń.</p>
              ) : (
                <>
                  {details.free_spots === 0 && reserveFree > 0 && (
                    <p class="mb-2 text-sm text-warn">
                      Skład jest pełny — zaakceptowane osoby trafią na listę rezerwową.
                    </p>
                  )}
                  {details.free_spots === 0 && reserveFree === 0 && (
                    <p class="mb-2 text-sm text-warn">
                      Skład i lista rezerwowa są pełne — możesz tylko odrzucać zgłoszenia.
                    </p>
                  )}
                  <ul class="grid gap-2">
                    {details.pending.map((p) => (
                      <li
                        class="flex flex-wrap items-center justify-between gap-2 text-sm"
                        data-testid="pending-request"
                      >
                        <span>{p.display_name}</span>
                        <form
                          method="POST"
                          action={`/api/participations/${p.participation_id}/decide`}
                          class="flex gap-2"
                        >
                          <input type="hidden" name="eventId" value={details.id} />
                          <button
                            type="submit"
                            name="decision"
                            value="accept"
                            disabled={details.free_spots === 0 && reserveFree === 0}
                            class="rounded-full bg-green-600 px-3 py-1 text-white transition-colors hover:bg-green-500 disabled:cursor-not-allowed disabled:opacity-40"
                          >
                            Akceptuj
                          </button>
                          <button
                            type="submit"
                            name="decision"
                            value="reject"
                            class="rounded-full border border-line-strong bg-card shadow-card px-3 py-1 transition-colors hover:bg-card-2"
                          >
                            Odrzuć
                          </button>
                        </form>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </section>
          )}

          {details && (
            <SlotGrid
              teamSize={teamSize(details)}
              organizerName={details.organizer_plays && !organizerLeft ? details.organizer_name : null}
              participants={details.participants}
              reserveSpots={details.reserve_spots}
              reserves={details.reserves}
              handover={details.handover_at !== null}
              removeFor={isOrganizer && isOpen ? details.id : undefined}
            />
          )}
          {!details && publicEvent && (
            <SlotGrid
              teamSize={teamSize(publicEvent)}
              organizerName={null}
              participants={[]}
              reserveSpots={publicEvent.reserve_spots}
              reserves={[]}
              handover={false}
              anonymous={{
                taken: publicEvent.accepted_count + (publicEvent.organizer_plays ? 1 : 0),
                reserved: publicEvent.reserve_count,
              }}
            />
          )}

          {!user && (
            <p class="mt-6 text-sm text-ink-2">
              Aby zobaczyć dokładne miejsce, organizatora i uczestników oraz się zgłosić,{" "}
              <a href="/auth/signin" class="text-link hover:underline">
                zaloguj się
              </a>
            </p>
          )}
        </article>
      )}
    </div>
  </div>
</Layout>
