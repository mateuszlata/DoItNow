---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SlotGrid from "@/components/events/SlotGrid.astro";
import EventMap from "@/components/map/EventMap";
import SportIcon from "@/components/SportIcon.astro";
import VenueStatus from "@/components/events/VenueStatus.astro";
import Countdown from "@/components/events/Countdown.astro";
import EventChat from "@/components/chat/EventChat";
import MatchLineup, { type LineupPlayerView } from "@/components/lineup/MatchLineup";
import { getLineup, type SavedLineup } from "@/lib/services/lineups";
import { supportsLineup } from "@/lib/lineup";
import { eventVersion } from "@/lib/services/live";
import InviteSection from "@/components/events/InviteSection.astro";
import WeatherBadge from "@/components/events/WeatherBadge";
import { WEATHER_ATTRIBUTION } from "@/lib/weather";
import GuestAnswerForm from "@/components/events/GuestAnswerForm.astro";
import { readDevice } from "@/lib/device";
import ChanceMeter from "@/components/events/ChanceMeter.astro";
import { chanceExplanation, chanceTips, meetingChance, type ChanceInput } from "@/lib/chance";
import { eventShareText, inviteShareText } from "@/lib/share";
import ShareMenu from "@/components/share/ShareMenu";
import { getMyInvite, inviteErrorMessage, releaseStaleInvites } from "@/lib/services/invites";
import { getChatPreview, isChatOpen, listMessages } from "@/lib/services/chat";
import { fitsLevel, levelMixLabel, levelRangeLabel, LEVEL_LABELS, type Level } from "@/lib/levels";
import { getLevels } from "@/lib/services/profiles";
import { isRouteSport, routeSummary } from "@/lib/route";
import EventQuestions from "@/components/events/EventQuestions.astro";
import { listQuestions } from "@/lib/services/questions";
import ChatPreview from "@/components/chat/ChatPreview";
import { authHref, safeNext } from "@/lib/next-path";
import { jerseyNumber } from "@/lib/jerseys";
import { createClient } from "@/lib/supabase";
import {
  canEditEvent,
  getEventDetails,
  getGuestEventDetails,
  getLevelMix,
  getPublicEvent,
  needsAnswer,
} from "@/lib/services/events";
import { STATUS_LABELS, isLastMinute, participationErrorMessage } from "@/lib/services/participations";
import { freeReserve, freeWord, minimumLabel, missingToMinimum, teamSize } from "@/lib/capacity";
import { sportLabel } from "@/lib/sports";
import { eventDayParts, formatEventDay, formatEventTime, formatTimeRange } from "@/lib/time";
import { formatPLN, shareCents } from "@/lib/money";
import type { ChatMessage, EventDetails, PublicEvent } from "@/types";

const { user } = Astro.locals;
// Goście z udostępnionego linku wracają tu po rejestracji lub logowaniu.
const backHere = safeNext(Astro.url.pathname);
const id = Astro.params.id ?? "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Nieodpowiedziane zaproszenia zwalniają się 12 h przed startem (przy okazji wejścia na stronę).
if (supabase) await releaseStaleInvites(supabase);
let details: EventDetails | null = null;
let publicEvent: PublicEvent | null = null;
// Gość bez konta, który powiedział „Będę” (rozpoznany po urządzeniu), widzi spotkanie jak członek składu.
const device = readDevice(Astro.cookies);
let guestName: string | null = null;
if (supabase) {
  if (user) {
    details = await getEventDetails(supabase, id, user.id);
  } else {
    const guest = device ? await getGuestEventDetails(supabase, id, device) : null;
    if (guest) {
      details = guest.details;
      guestName = guest.guestName;
    } else {
      publicEvent = await getPublicEvent(supabase, id);
    }
  }
}
const isGuest = guestName !== null;

if (!details && !publicEvent) {
  Astro.response.status = 404;
}

// Wspólne liczby dla zalogowanych i gości (goście dostają je z ograniczonego widoku).
const summary = details
  ? {
      sport: details.sport,
      area: details.area,
      starts_at: details.starts_at,
      spots: details.spots,
      organizer_plays: details.organizer_plays,
      accepted_count: details.participants.length,
      reserve_spots: details.reserve_spots,
      reserve_count: details.reserves.length,
      min_people: details.min_people,
      requires_approval: details.requires_approval,
      duration_minutes: details.duration_minutes,
      cost_cents: details.cost_cents,
      venue_status: details.venue_status,
      guest_count: details.guest_count,
      guest_confirmed: details.guest_confirmed,
      level_min: details.level_min,
      level_max: details.level_max,
      route_destination: details.route_destination,
      route_loop: details.route_loop,
      route_distance_km: details.route_distance_km,
      route_pace: details.route_pace,
    }
  : publicEvent;

// Odświeżanie na żywo: odcisk stanu spotkania w chwili renderowania (skrypt na dole porównuje go z serwerem).
// Gotowe wiadomości do udostępniania: opis spotkania + link (zamiast samego linku).
const eventUrl = `${Astro.url.origin}/events/${id}`;
const shareSubject = summary
  ? `Metando: ${sportLabel(summary.sport)} — ${formatEventDay(summary.starts_at)}`
  : "Metando";
const shareText = summary ? eventShareText(summary, Math.max(summary.spots - summary.accepted_count, 0), eventUrl) : "";

const liveVersion = supabase && summary ? await eventVersion(supabase, id, Boolean(user)) : null;

const SUCCESS_MESSAGES: Record<string, string> = {
  joined: "Zgłoszenie wysłane. Organizator musi je zaakceptować.",
  removed: "Usunięto osobę ze spotkania.",
  withdrawn: "Twoje zgłoszenie zostało wycofane.",
  accepted: "Zgłoszenie zaakceptowane.",
  rejected: "Zgłoszenie odrzucone.",
  updated: "Zmiany zostały zapisane.",
  cancelled: "Spotkanie zostało odwołane.",
  stayed: "Zostajesz w spotkaniu.",
  left: "Rezygnacja przyjęta — nie grasz w tym spotkaniu.",
  "guest-yes": "Jesteś w składzie! Organizator widzi Cię jako gościa.",
  "guest-no": "Dzięki za odpowiedź — Twoje miejsce trafi do innych graczy.",
};
const okKey = Astro.url.searchParams.get("ok") ?? "";
const okMessage =
  okKey === "joined" && details?.my_participation?.status === "accepted"
    ? "Jesteś w składzie!"
    : okKey === "joined" && details?.my_participation?.status === "reserve"
      ? "Skład jest pełny — jesteś na liście rezerwowej i wskoczysz, gdy zwolni się miejsce."
      : okKey === "cancelled" && details?.status === "organizer_left"
        ? "Spotkanie odwołane. Zaakceptowani uczestnicy zdecydują, czy spotkają się bez Ciebie."
        : okKey === "stayed" && details?.organizer_id === user?.id
          ? "Zostajesz w spotkaniu i przejmujesz jego organizację."
          : SUCCESS_MESSAGES[okKey];
const errorCode = Astro.url.searchParams.get("error");
const errorMessage = participationErrorMessage(errorCode) ?? inviteErrorMessage(errorCode);

// Podgląd linku przy udostępnianiu (Messenger, WhatsApp): sport, termin, okolica i ile osób brakuje.
function missingPeople(count: number): string {
  return count === 1 ? "Brakuje 1 osoby" : `Brakuje ${String(count)} osób`;
}
const share = summary
  ? {
      title: `${sportLabel(summary.sport)} · ${formatEventDay(summary.starts_at)}, ${formatTimeRange(summary.starts_at, summary.duration_minutes)} · ${summary.area}`,
      description:
        summary.spots - summary.accepted_count > 0
          ? `${missingPeople(summary.spots - summary.accepted_count)} w składzie. Dołącz w Metando jednym kliknięciem.`
          : "Skład w komplecie — zobacz spotkanie w Metando i zapisz się na rezerwę, jeśli są miejsca.",
      image: `/og/${summary.sport}.png`,
    }
  : null;

const isPast = summary ? new Date(summary.starts_at).getTime() <= Date.now() : false;
const isCancelled = details?.status === "cancelled";
const organizerLeft = details?.status === "organizer_left";
const isOpen = details !== null && !isPast && details.status === "active";
// Pytania do organizatora: odpowiedziane widzi każdy, swoje bez odpowiedzi — autor i organizator.
const questions = supabase && summary ? await listQuestions(supabase, id) : [];

const isOrganizer = details !== null && user !== null && details.organizer_id === user.id;
// Zaproszenia znajomych spoza Metando: własna pula i link oglądającego.
const myInvite = details && user && isOpen && supabase ? await getMyInvite(supabase, details.id, user.id) : null;
const inviteMessagePrefix = details ? inviteShareText(details, "").trimEnd() : "";
const myParticipation = details?.my_participation ?? null;
const myStatus = myParticipation?.status ?? null;
const inSquad = isOrganizer || myStatus === "accepted";
// Ile miejsc oglądający może jeszcze zarezerwować dla znajomych (zawsze zostaje jedno dla Metando).
const canAddInvites = details
  ? Math.max(0, Math.min(details.spots - details.participants.length, details.spots - 1))
  : 0;

// Szansa, że mecz się odbędzie (tylko dla nadchodzących, aktywnych spotkań).
const chanceInput: ChanceInput | null =
  summary && !isPast && (details ? details.status === "active" : true)
    ? {
        teamSize: teamSize(summary),
        minPeople: summary.min_people,
        confirmed: summary.accepted_count + (summary.organizer_plays ? 1 : 0) + summary.guest_confirmed,
        pendingInvites: Math.max(summary.guest_count - summary.guest_confirmed, 0),
        freeSpots: Math.max(summary.spots - summary.accepted_count, 0),
        hoursToStart: (new Date(summary.starts_at).getTime() - Date.now()) / 3_600_000,
      }
    : null;
const chance = chanceInput ? meetingChance(chanceInput) : null;
const mustAnswer = details !== null && needsAnswer(details, myStatus, myParticipation?.stay_confirmed ?? null);

const canJoin = user !== null && isOpen && !isOrganizer && (myStatus === null || myStatus === "withdrawn");
// Zalogowany, który wcześniej z tego urządzenia powiedział „Będę” jako gość: „Dołącz” przejmie to miejsce.
const myGuestName =
  canJoin && device && supabase && !details?.requires_approval
    ? ((await getGuestEventDetails(supabase, id, device))?.guestName ?? null)
    : null;
// Oczekujące zgłoszenie i rezerwa nie zajmują miejsca, więc można je wycofać do startu;
// zaakceptowany uczestnik do 12 h przed — chyba że organizator odwołał spotkanie.
const canWithdraw =
  details !== null &&
  !isPast &&
  !isCancelled &&
  !mustAnswer &&
  (myStatus === "pending" || myStatus === "reserve" || myStatus === "accepted");
// Rezygnacja zawsze możliwa; na ostatnią chwilę (< 12 h) z potwierdzeniem — zwolnione miejsce zajmie rezerwa.
const lateWithdrawal = myStatus === "accepted" && details !== null && isLastMinute(details.starts_at);
// Czat: organizator oraz osoby w składzie i na rezerwie (reguła is_event_member w bazie).
const isChatMember = details !== null && (isOrganizer || myStatus === "accepted" || myStatus === "reserve");
let chat: { messages: ChatMessage[]; syncedAt: string } | null = null;
if (isChatMember && supabase && details) {
  const syncedAt = new Date(Date.now() - 5000).toISOString();
  const result = await listMessages(supabase, details.id);
  if (result.ok) chat = { messages: result.data, syncedAt };
}
// Poziom: zakres spotkania, rozkład zadeklarowanych poziomów w składzie i — dla chętnego — czy jego poziom pasuje.
const levelMix = supabase && summary && !isPast ? await getLevelMix(supabase, id) : [];
const myLevel: Level | null =
  user && supabase && summary && canJoin ? ((await getLevels(supabase, user.id))[summary.sport] ?? null) : null;
const levelMismatch = summary !== null && !fitsLevel(myLevel, summary.level_min, summary.level_max);
// Bez konta: zajawka rozmowy składu (koszulki i kształt wiadomości; gość ze składu czyta organizatora).
const chatPreview = !user && supabase && !isPast ? await getChatPreview(supabase, id, device) : [];

// Składy na mecz (sporty z boiskiem lub kortem): grający organizator i przyjęci do składu — widzą je członkowie spotkania.
let lineupPlayers: LineupPlayerView[] = [];
let savedLineup: SavedLineup | null = null;
if (details && supabase && supportsLineup(details.sport) && isChatMember) {
  lineupPlayers = [
    ...(details.organizer_plays && !organizerLeft
      ? [
          {
            userId: details.organizer_id,
            name: details.organizer_name,
            kit: details.organizer_kit,
            position: details.organizer_position,
          },
        ]
      : []),
    ...details.participants.map((p) => ({ userId: p.user_id, name: p.display_name, kit: p.kit, position: p.position })),
  ];
  savedLineup = lineupPlayers.length >= 2 ? await getLineup(supabase, details.id) : null;
}

const free = details
  ? details.free_spots
  : publicEvent
    ? Math.max(publicEvent.spots - publicEvent.accepted_count, 0)
    : 0;
const reserveFree = summary ? freeReserve(summary) : 0;
const minimum = summary ? minimumLabel(summary) : null;
const navigateHref =
  details?.lat != null && details.lng != null
    ? `https://www.google.com/maps/dir/?api=1&destination=${String(details.lat)},${String(details.lng)}`
    : null;

const day = summary ? eventDayParts(summary.starts_at) : null;
// Pogoda na godzinę spotkania: dokładne miejsce dla członków, przybliżone (ok. 1 km) dla pozostałych.
const weatherPoint =
  details?.lat != null && details.lng != null
    ? { lat: details.lat, lng: details.lng }
    : publicEvent?.approx_lat != null && publicEvent.approx_lng != null
      ? { lat: publicEvent.approx_lat, lng: publicEvent.approx_lng }
      : null;
const team = summary ? teamSize(summary) : 0;
const missing = summary ? missingToMinimum(summary) : null;
// Numer koszulki oglądającego: kapitan (grający organizator) ma pierwszą, potem kolejność w składzie.
const captainOffset = details?.organizer_plays && !organizerLeft ? 1 : 0;
const myIndex = details && user ? details.participants.findIndex((p) => p.user_id === user.id) : -1;
const myNumber =
  isOrganizer && details?.organizer_plays
    ? jerseyNumber(0)
    : myIndex >= 0
      ? jerseyNumber(myIndex + captainOffset)
      : null;
const joinLabel = summary?.requires_approval
  ? "Zgłoś się"
  : free > 0
    ? `Dołącz · ${String(free)} ${freeWord(free)}`
    : "Dołącz na rezerwę";
// Bez konta można dołączyć jako gość, gdy nie trzeba akceptacji, a zostaje miejsce poza ostatnim (to dla graczy z kontem).
const guestCanJoin =
  publicEvent !== null && !isPast && !publicEvent.requires_approval && free >= 1 && publicEvent.spots > 1;
const showBar = !mustAnswer && (!user || (details !== null && (isOrganizer ? isOpen : true)));
---

<Layout
  title={summary ? `${sportLabel(summary.sport)} · Metando` : "Nie znaleziono · Metando"}
  shareTitle={share?.title}
  description={share?.description}
  image={share?.image}
>
  <div class="bg-app min-h-screen p-4 pb-40 lg:pb-10">
    <div class="mx-auto flex max-w-xl flex-col gap-5 lg:max-w-6xl">
      <Topbar hideNav />
      {liveVersion && <div hidden data-live-event={id} data-live-version={liveVersion} />}
      <div
        hidden
        data-live-banner
        role="status"
        class="sticky top-2 z-50 flex items-center justify-between gap-3 rounded-full bg-brand px-4 py-2 text-sm font-bold text-on-brand shadow-lg"
      >
        Coś się zmieniło w spotkaniu.
        <button type="button" data-live-reload class="rounded-full bg-ink px-3 py-1 text-xs text-card">
          Odśwież
        </button>
      </div>

      <div class="-mt-2 flex items-center justify-between gap-3">
        <a
          href="/events"
          aria-label="Wszystkie ogłoszenia"
          class="grid size-11 place-items-center rounded-full bg-page-2 text-page-ink transition-colors hover:bg-page-deep"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </a>
        {summary && (
          <span class="inline-flex items-center gap-2 rounded-full bg-brand px-3 py-1.5 text-[13px] font-extrabold tracking-wider text-on-brand uppercase">
            <SportIcon sport={summary.sport} size={16} strokeWidth={2.4} />
            {sportLabel(summary.sport)} · {team} {team === 1 ? "osoba" : team < 5 ? "osoby" : "osób"}
          </span>
        )}
        <ShareMenu variant="icon" text={shareText} url={eventUrl} subject={shareSubject} client:load />
      </div>

      {okMessage && (
        <p class="rounded-2xl border border-ok-line bg-ok-soft px-4 py-2.5 text-sm font-semibold text-ok">
          {okMessage}
        </p>
      )}
      {errorMessage && (
        <p class="rounded-2xl border border-bad-line bg-bad-soft px-4 py-2.5 text-sm font-semibold text-bad">
          {errorMessage}
        </p>
      )}

      {okKey === "created" && isOrganizer && (
        <section class="rounded-[20px] bg-brand p-5 text-on-brand" data-testid="created-share">
          <p class="display text-3xl">Gotowe! Ogłoszenie wisi</p>
          <p class="mt-1 text-sm">
            Najszybciej skompletujesz skład, wysyłając link znajomym, na grupę drużyny albo osiedla.
          </p>
          <ShareMenu
            variant="button"
            label="Udostępnij ogłoszenie"
            text={shareText}
            url={eventUrl}
            subject={shareSubject}
            className="mt-3 w-full"
            client:load
          />
        </section>
      )}

      {!summary && (
        <div class="rounded-[20px] bg-card p-6 text-center text-ink">
          <h1 class="display text-3xl">Nie znaleziono ogłoszenia</h1>
          <p class="mt-2 text-sm text-ink-2">Ogłoszenie nie istnieje albo już się odbyło.</p>
        </div>
      )}

      {summary && day && (
        <>
          {isCancelled && (
            <p class="rounded-2xl bg-bad-soft px-4 py-2.5 text-sm font-semibold text-bad">
              To spotkanie zostało odwołane.
            </p>
          )}
          {isPast && !isCancelled && (
            <p class="rounded-2xl bg-page-2 px-4 py-2.5 text-sm text-page-ink-2">To spotkanie już się odbyło.</p>
          )}
          {organizerLeft && !isPast && (
            <p class="rounded-2xl bg-warn-soft px-4 py-2.5 text-sm text-warn" data-testid="handover-status">
              {isOrganizer
                ? "To spotkanie zostało przez Ciebie odwołane. Czekamy, czy ktoś z uczestników zostanie i przejmie organizację."
                : "Organizator zrezygnował. Spotkanie odbędzie się, jeśli uczestnicy zdecydują się zostać — pierwsza osoba, która zostanie, przejmuje organizację."}
            </p>
          )}

          {mustAnswer && details && (
            <section class="rounded-[20px] bg-card p-4 text-ink" data-testid="handover-question">
              <p class="display text-2xl">Organizator odwołał spotkanie</p>
              <p class="mt-1 text-sm text-ink-2">
                Czy mimo to chcesz w nim zostać i spotkać się z osobami, które się zapisały?
              </p>
              <form method="POST" action={`/api/events/${details.id}/respond`} class="mt-3 flex gap-2">
                <button
                  type="submit"
                  name="stay"
                  value="yes"
                  class="h-12 flex-1 rounded-full bg-brand text-sm font-extrabold tracking-wide text-on-brand uppercase transition-colors hover:bg-brand-hover"
                >
                  Zostaję
                </button>
                <button
                  type="submit"
                  name="stay"
                  value="no"
                  class="h-12 flex-1 rounded-full bg-card-2 text-sm font-bold text-ink transition-colors hover:bg-line"
                >
                  Rezygnuję
                </button>
              </form>
            </section>
          )}

          <div class="flex flex-col gap-5 lg:grid lg:grid-cols-[minmax(0,1fr)_400px] lg:items-start lg:gap-6">
            <div class="contents lg:flex lg:min-w-0 lg:flex-col lg:gap-5">
              <div class="flex flex-col gap-2">
                <h1 class="display display-hero pl-1.5 text-[48px] leading-[0.86] text-page-ink">
                  {day.weekday}
                  <br />
                  {day.date} · {formatEventTime(summary.starts_at)}
                </h1>
                <Countdown startsAt={summary.starts_at} durationMinutes={summary.duration_minutes} large />
                {weatherPoint && !isPast && (
                  <div class="flex items-center gap-2">
                    <WeatherBadge
                      eventId={id}
                      startsAt={summary.starts_at}
                      durationMinutes={summary.duration_minutes}
                      size="large"
                      client:idle
                    />
                    <span class="text-[11px] text-page-ink-2">{WEATHER_ATTRIBUTION}</span>
                  </div>
                )}
                <p class="text-[15px] text-page-ink-2">
                  {summary.area}
                  {details && (
                    <>
                      {" · "}
                      {isRouteSport(details.sport) && "zbiórka: "}
                      <span class="font-bold text-page-ink">{details.place}</span>
                      {" · "}
                      {organizerLeft ? "organizator zrezygnował" : <>organizuje {details.organizer_name}</>}
                    </>
                  )}
                </p>
              </div>

              {details?.lat != null && details.lng != null && (
                <div class="relative isolate overflow-hidden rounded-[20px]">
                  <EventMap lat={details.lat} lng={details.lng} label={details.place} client:visible />
                  {navigateHref && (
                    <a
                      href={navigateHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="absolute right-3 bottom-3 z-[1000] grid h-10 place-items-center rounded-full bg-ink px-4 text-[13px] font-bold text-card"
                    >
                      Nawiguj
                    </a>
                  )}
                </div>
              )}

              <div class="grid grid-cols-3 gap-2 lg:grid-cols-4">
                <div class="rounded-2xl bg-card p-3 text-ink" data-testid="free-spots">
                  <div class="display number-shadow text-[44px] leading-[0.85] text-page">{free}</div>
                  <div class="mt-1.5 text-xs font-bold text-ink-2 uppercase">
                    {" "}
                    {freeWord(free)} z {team}
                  </div>
                </div>
                <div class="rounded-2xl bg-page-2 p-3" data-testid="minimum" title={minimum ?? "Bez minimum"}>
                  <div class="display text-[44px] leading-[0.85]">{summary.min_people ?? "—"}</div>
                  <div
                    class:list={[
                      "mt-1.5 text-xs font-bold uppercase",
                      missing === 0 ? "text-page-ink-2" : missing === null ? "text-page-ink-2" : "text-bench",
                    ]}
                  >
                    {missing === null ? "bez minimum" : missing === 0 ? "min. jest" : `min. · brak ${String(missing)}`}
                  </div>
                </div>
                <div class="rounded-2xl bg-page-2 p-3" data-testid="reserve-summary">
                  <div class="display text-[44px] leading-[0.85]">
                    {summary.reserve_spots > 0
                      ? `${String(summary.reserve_count)}/${String(summary.reserve_spots)}`
                      : "—"}
                  </div>
                  <div class="mt-1.5 text-xs font-bold text-page-ink-2 uppercase">
                    {summary.reserve_spots > 0 ? `rezerwa · ${String(reserveFree)} wolne` : "bez rezerwy"}
                  </div>
                </div>
                <div class="hidden rounded-2xl bg-page-2 p-3 lg:block" data-testid="level-tile">
                  <div class="display text-[44px] leading-[0.85]">
                    {summary.level_min === null
                      ? "—"
                      : summary.level_min === summary.level_max
                        ? summary.level_min
                        : `${String(summary.level_min)}–${String(summary.level_max)}`}
                  </div>
                  <div class="mt-1.5 text-xs font-bold text-page-ink-2 uppercase">
                    {summary.level_min === null ? "poziom · dla każdego" : "poziom gry"}
                  </div>
                </div>
              </div>
              <p class="-mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm text-page-ink" data-testid="time-and-cost">
                <span>
                  <strong>{formatTimeRange(summary.starts_at, summary.duration_minutes)}</strong>
                  <span class="text-page-ink-2"> · {summary.duration_minutes} min</span>
                </span>
                {summary.cost_cents != null && (
                  <span>
                    <strong class="text-brand">{formatPLN(shareCents(summary.cost_cents, team))} na osobę</strong>
                    <span class="text-page-ink-2"> · obiekt {formatPLN(summary.cost_cents)}</span>
                  </span>
                )}
              </p>
              {summary.venue_status && (
                <div class="-mt-2 flex flex-col gap-1">
                  <VenueStatus status={summary.venue_status} />
                  {details?.venue_status === "rejected" && details.venue_note && (
                    <span class="text-sm text-page-ink-2">Powód: {details.venue_note}</span>
                  )}
                  {details?.venue_status === "rejected" && isOrganizer && (
                    <span class="text-sm text-page-ink-2">
                      Zmień termin albo obiekt w „Edytuj” — nowy termin trafi do zarządcy do potwierdzenia.
                    </span>
                  )}
                </div>
              )}
              {routeSummary(summary) && (
                <p
                  class="-mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-page-ink"
                  data-testid="event-route"
                >
                  <span>
                    <span class="text-page-ink-2">Trasa: </span>
                    <strong>{routeSummary(summary)}</strong>
                  </span>
                  {details?.route_url && (
                    <a
                      href={details.route_url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="font-bold text-page-link hover:underline"
                    >
                      Zobacz trasę ↗
                    </a>
                  )}
                </p>
              )}
              <p class="-mt-2 text-[13px] text-page-ink-2" data-testid="join-mode">
                Dołączanie: {summary.requires_approval ? "po akceptacji organizatora" : "od razu, bez akceptacji"}
                {summary.organizer_plays && " · organizator gra w składzie"}
              </p>
              <p
                class:list={["-mt-2 text-[13px] text-page-ink", levelMix.length === 0 && "lg:hidden"]}
                data-testid="event-level"
              >
                <strong class="lg:font-normal lg:text-page-ink-2">
                  {levelRangeLabel(summary.level_min, summary.level_max)}
                </strong>
                {levelMix.length > 0 && <span class="text-page-ink-2"> · w składzie: {levelMixLabel(levelMix)}</span>}
              </p>

              {details?.description && (
                <section class="flex flex-col gap-1.5">
                  <h2 class="text-[13px] font-bold tracking-widest text-page-ink-2 uppercase">Od organizatora</h2>
                  <p class="text-[15px] leading-relaxed whitespace-pre-line">{details.description}</p>
                </section>
              )}

              <EventQuestions
                eventId={id}
                questions={questions}
                isOrganizer={isOrganizer}
                canAsk={user !== null && !isOrganizer && isOpen}
                signinHref={!user && !isPast ? authHref("signin", backHere) : null}
              />

              {isOrganizer && details && isOpen && (details.requires_approval || details.pending.length > 0) && (
                <section class="rounded-[20px] bg-card p-4 text-ink">
                  <h2 class="display mb-3 text-2xl">Zgłoszenia do rozpatrzenia</h2>
                  {details.pending.length === 0 ? (
                    <p class="text-sm text-ink-3">Brak oczekujących zgłoszeń.</p>
                  ) : (
                    <>
                      {details.free_spots === 0 && reserveFree > 0 && (
                        <p class="mb-2 text-sm text-warn">
                          Skład jest pełny — zaakceptowane osoby trafią na ławkę rezerwowych.
                        </p>
                      )}
                      {details.free_spots === 0 && reserveFree === 0 && (
                        <p class="mb-2 text-sm text-warn">Skład i ławka są pełne — możesz tylko odrzucać zgłoszenia.</p>
                      )}
                      <ul class="grid gap-2">
                        {details.pending.map((p) => (
                          <li
                            class="flex flex-wrap items-center justify-between gap-2 rounded-2xl bg-card-2 px-3 py-2 text-sm"
                            data-testid="pending-request"
                          >
                            <span class="font-bold">{p.display_name}</span>
                            <form
                              method="POST"
                              action={`/api/participations/${p.participation_id}/decide`}
                              class="flex gap-2"
                            >
                              <input type="hidden" name="eventId" value={details.id} />
                              <button
                                type="submit"
                                name="decision"
                                value="accept"
                                disabled={details.free_spots === 0 && reserveFree === 0}
                                class="h-9 rounded-full bg-brand px-4 font-bold text-on-brand transition-colors hover:bg-brand-hover disabled:cursor-not-allowed disabled:opacity-40"
                              >
                                Akceptuj
                              </button>
                              <button
                                type="submit"
                                name="decision"
                                value="reject"
                                class="h-9 rounded-full bg-card px-4 font-semibold text-ink transition-colors hover:bg-line"
                              >
                                Odrzuć
                              </button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </section>
              )}

              {chance && chanceInput && (
                <ChanceMeter
                  chance={chance}
                  explanation={chanceExplanation(chanceInput, chance)}
                  tips={
                    details && isChatMember
                      ? chanceTips(chanceInput, {
                          isOrganizer,
                          canInvite: isOpen && (isOrganizer || (inSquad && details.members_can_invite)),
                          reserveSpots: details.reserve_spots,
                        })
                      : []
                  }
                  editHref={isOrganizer && details ? `/events/${details.id}/edit` : undefined}
                />
              )}
              {details && user && isOpen && (
                <InviteSection
                  eventId={details.id}
                  userId={user.id}
                  isOrganizer={isOrganizer}
                  inSquad={inSquad}
                  membersCanInvite={details.members_can_invite}
                  my={myInvite}
                  canAdd={canAddInvites}
                  invites={details.invites}
                  groups={details.guest_groups}
                  origin={Astro.url.origin}
                  messagePrefix={inviteMessagePrefix}
                  subject={`Zaproszenie: ${shareSubject.replace("Metando: ", "")}`}
                />
              )}
              {details && (
                <SlotGrid
                  sport={details.sport}
                  teamSize={teamSize(details)}
                  organizerName={details.organizer_plays && !organizerLeft ? details.organizer_name : null}
                  organizerKit={details.organizer_kit}
                  participants={details.participants}
                  guestGroups={details.guest_groups}
                  organizerId={details.organizer_id}
                  reserveSpots={details.reserve_spots}
                  reserves={details.reserves}
                  handover={details.handover_at !== null}
                  removeFor={isOrganizer && isOpen ? details.id : undefined}
                  viewerId={user?.id}
                />
              )}
              {details && lineupPlayers.length >= 2 && (
                <MatchLineup
                  eventId={details.id}
                  sport={details.sport}
                  players={lineupPlayers}
                  canEdit={isOrganizer && isOpen}
                  initial={savedLineup}
                  client:load
                />
              )}
              {details && !isChatMember && myStatus === "pending" && (
                <p class="text-sm text-page-ink-2">Czat spotkania zobaczysz po akceptacji zgłoszenia.</p>
              )}
              {!details && publicEvent && (
                <SlotGrid
                  sport={publicEvent.sport}
                  teamSize={teamSize(publicEvent)}
                  organizerName={null}
                  participants={[]}
                  reserveSpots={publicEvent.reserve_spots}
                  reserves={[]}
                  handover={false}
                  anonymous={{
                    taken: publicEvent.accepted_count + (publicEvent.organizer_plays ? 1 : 0) + publicEvent.guest_count,
                    reserved: publicEvent.reserve_count,
                  }}
                />
              )}

              {myGuestName && (
                <section class="rounded-[20px] bg-card p-4 text-sm text-ink" data-testid="claim-guest">
                  <p class="font-bold">Jesteś już w składzie jako gość „{myGuestName}”</p>
                  <p class="mt-1 text-ink-2">
                    Kliknij „Dołącz” na dole — Twoje miejsce gościa przejdzie na konto i odblokuje się pisanie na
                    czacie.
                  </p>
                </section>
              )}

              {isGuest && details && (
                <section id="dolacz" class="rounded-[20px] bg-card p-5 text-ink" data-testid="guest-member">
                  <h2 class="display text-2xl leading-none">Jesteś w składzie jako gość</h2>
                  <p class="mt-2 text-sm text-ink-2">
                    Grasz jako <strong class="text-ink">{guestName}</strong>. Zmieniły się plany? Daj znać, a miejsce
                    trafi do innych.
                  </p>
                  {isOpen && (
                    <div class="mt-3">
                      <GuestAnswerForm
                        action={`/api/events/${details.id}/guest`}
                        name={guestName ?? ""}
                        answered="yes"
                      />
                    </div>
                  )}
                  <div class="mt-4 rounded-2xl bg-card-2 p-4 text-sm">
                    <p class="font-bold">Z kontem masz więcej</p>
                    <ul class="mt-1 list-disc pl-5 text-ink-2">
                      <li>piszesz na czacie spotkania,</li>
                      <li>masz własne barwy i numer w składzie,</li>
                      <li>zapisujesz się na kolejne mecze jednym kliknięciem.</li>
                    </ul>
                    <a
                      href={authHref("signup", backHere)}
                      class="mt-3 inline-grid h-10 place-items-center rounded-full bg-brand px-4 text-xs font-extrabold tracking-wide text-on-brand uppercase"
                    >
                      Załóż darmowe konto
                    </a>
                  </div>
                </section>
              )}

              {!user && !isGuest && guestCanJoin && (
                <section id="dolacz" class="rounded-[20px] bg-card p-5 text-ink" data-testid="guest-join">
                  <h2 class="display text-2xl leading-none">Dołącz bez zakładania konta</h2>
                  <p class="mt-2 mb-3 text-sm text-ink-2">
                    Podaj imię i kliknij „Będę” — organizator zobaczy Cię w składzie, a Ty dokładne miejsce i kto
                    jeszcze gra. Konto możesz założyć później, gdy zechcesz pisać na czacie.
                  </p>
                  <GuestAnswerForm action={`/api/events/${id}/guest`} showNo={false} />
                  <p class="mt-3 text-center text-xs text-ink-3">
                    Masz konto?{" "}
                    <a href={authHref("signin", backHere)} class="font-bold text-link underline">
                      Zaloguj się
                    </a>
                  </p>
                </section>
              )}

              {!user && !isGuest && !guestCanJoin && (
                <section id="dolacz" class="rounded-[20px] bg-page-2 p-5 text-page-ink" data-testid="guest-intro">
                  <h2 class="display text-2xl leading-none">Pierwszy raz w Metando?</h2>
                  <p class="mt-2 text-sm text-page-ink-2">
                    {publicEvent?.requires_approval
                      ? "W tym spotkaniu organizator akceptuje zgłoszenia, więc potrzebne jest konto. Załóż je w 30 sekund — wrócisz prosto tutaj."
                      : "W składzie nie ma już wolnego miejsca dla gości. Załóż darmowe konto w 30 sekund, a zapiszesz się na ostatnie miejsce albo na rezerwę."}
                  </p>
                  <a
                    href={authHref("signup", backHere)}
                    class="mt-3 inline-grid h-11 place-items-center rounded-full bg-brand px-5 text-sm font-extrabold tracking-wide text-on-brand uppercase"
                  >
                    Załóż konto i dołącz
                  </a>
                </section>
              )}
            </div>

            {/* Na komputerze: akcja i czat obok, przyklejone przy przewijaniu. */}
            <aside class="contents lg:sticky lg:top-4 lg:flex lg:max-h-[calc(100vh-2rem)] lg:flex-col lg:gap-5 lg:overflow-y-auto">
              {showBar && (
                <div class="fixed inset-x-0 bottom-0 z-40 bg-page-deep lg:static lg:overflow-hidden lg:rounded-[20px]">
                  <div class="sleeve" aria-hidden="true">
                    <span />
                    <span />
                  </div>
                  <div class="mx-auto flex max-w-xl flex-wrap items-center gap-2.5 px-4 pt-3.5 pb-5 lg:max-w-none">
                    {!user && (
                      <>
                        {isGuest ? (
                          <a
                            href={authHref("signup", backHere)}
                            class="grid h-14 flex-[2] place-items-center rounded-full bg-brand text-base font-extrabold tracking-wide text-on-brand uppercase"
                          >
                            Załóż konto
                          </a>
                        ) : guestCanJoin ? (
                          <a
                            href="#dolacz"
                            class="grid h-14 flex-[2] place-items-center rounded-full bg-brand text-base font-extrabold tracking-wide text-on-brand uppercase"
                          >
                            Dołącz bez konta
                          </a>
                        ) : (
                          <a
                            href={authHref("signup", backHere)}
                            class="grid h-14 flex-[2] place-items-center rounded-full bg-brand text-base font-extrabold tracking-wide text-on-brand uppercase"
                          >
                            Dołącz — załóż konto
                          </a>
                        )}
                        <a
                          href={authHref("signin", backHere)}
                          class="grid h-14 flex-1 place-items-center rounded-full bg-page-2 text-sm font-bold text-page-ink"
                        >
                          Mam konto
                        </a>
                      </>
                    )}

                    {isOrganizer && details && isOpen && (
                      <div class="flex w-full gap-2.5" data-testid="organizer-actions">
                        {canEditEvent(details.starts_at) ? (
                          <a
                            href={`/events/${details.id}/edit`}
                            class="grid h-14 flex-1 place-items-center rounded-full bg-card text-[15px] font-bold text-ink"
                          >
                            Edytuj
                          </a>
                        ) : (
                          <span class="flex-1 self-center text-xs text-page-ink-2">
                            Edycja możliwa najpóźniej 12 h przed spotkaniem.
                          </span>
                        )}
                        <form
                          method="POST"
                          action={`/api/events/${details.id}/cancel`}
                          class="flex flex-[1.4]"
                          onsubmit="return confirm('Odwołać spotkanie? Jeśli są zaakceptowani uczestnicy, zdecydują, czy spotkają się bez Ciebie.')"
                        >
                          <button
                            type="submit"
                            class="h-14 flex-1 rounded-full bg-[#3a2420] text-[15px] font-bold text-[#ffb4a6]"
                          >
                            Odwołaj spotkanie
                          </button>
                        </form>
                      </div>
                    )}

                    {details && !isOrganizer && (
                      <>
                        {myStatus && myStatus !== "withdrawn" && (
                          <span
                            class="flex min-h-14 flex-1 items-center gap-2 rounded-full bg-page-2 px-4 py-2 text-sm leading-tight text-page-ink"
                            data-testid="my-status"
                          >
                            <svg
                              width="18"
                              height="18"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="#FF7A1A"
                              stroke-width="2.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              <path d="M5 12l5 5 9-10"></path>
                            </svg>
                            <span>
                              <span class="sr-only">Twoje zgłoszenie: </span>
                              <strong class="first-letter:uppercase">{STATUS_LABELS[myStatus]}</strong>
                              {myStatus === "accepted" && myNumber && <> · nr {myNumber}</>}
                            </span>
                          </span>
                        )}
                        {canJoin && (
                          <form
                            method="POST"
                            action={`/api/events/${details.id}/join`}
                            class="flex flex-1"
                            onsubmit={
                              levelMismatch && myLevel !== null
                                ? `return confirm('${levelRangeLabel(summary.level_min, summary.level_max)}, a Twój poziom w tym sporcie to: ${LEVEL_LABELS[myLevel].toLowerCase()}. Na pewno dołączasz?')`
                                : undefined
                            }
                          >
                            <button
                              type="submit"
                              class="h-14 flex-1 rounded-full bg-brand text-base font-extrabold tracking-wide text-on-brand uppercase transition-colors hover:bg-brand-hover"
                            >
                              {joinLabel}
                            </button>
                          </form>
                        )}
                        {canWithdraw && (
                          <form
                            method="POST"
                            action={`/api/events/${details.id}/withdraw`}
                            onsubmit={
                              lateWithdrawal
                                ? "return confirm('Do spotkania zostało mniej niż 12 h. Na pewno rezygnujesz? Organizator dostanie powiadomienie, a Twoje miejsce zajmie ktoś z rezerwy.')"
                                : undefined
                            }
                          >
                            <button type="submit" class="h-14 rounded-full bg-card px-5 text-[15px] font-bold text-ink">
                              {myStatus === "accepted"
                                ? "Zrezygnuj"
                                : myStatus === "reserve"
                                  ? "Zejdź z ławki"
                                  : "Wycofaj zgłoszenie"}
                            </button>
                          </form>
                        )}
                        {!isOpen && !myStatus && (
                          <p class="w-full text-sm text-page-ink-2">Zapisy na to spotkanie są zamknięte.</p>
                        )}
                      </>
                    )}
                  </div>
                </div>
              )}
              {chat && details && user !== null && (
                <EventChat
                  eventId={details.id}
                  currentUserId={user.id}
                  isOrganizer={isOrganizer}
                  open={isChatOpen(details)}
                  initialMessages={chat.messages}
                  initialSyncedAt={chat.syncedAt}
                  shareText={shareText}
                  shareSubject={shareSubject}
                  shareUrl={eventUrl}
                  client:visible
                />
              )}
              {!user && chatPreview.length > 0 && (
                <ChatPreview
                  eventId={id}
                  messages={chatPreview}
                  guest={isGuest}
                  signupHref={authHref("signup", backHere)}
                  signinHref={authHref("signin", backHere)}
                  client:load
                />
              )}
            </aside>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  // Odświeżanie na żywo: co 15 s (gdy karta jest widoczna) porównujemy odcisk stanu spotkania z serwerem.
  // Po zmianie strona przeładowuje się w tym samym miejscu — chyba że ktoś właśnie pisze albo ma
  // niezapisane składy; wtedy pokazujemy pasek „Coś się zmieniło”.
  const marker = document.querySelector<HTMLElement>("[data-live-event]");
  const banner = document.querySelector<HTMLElement>("[data-live-banner]");
  if (marker && banner) {
    const eventId = marker.dataset.liveEvent ?? "";
    const version = marker.dataset.liveVersion ?? "";
    const scrollKey = `live-scroll:${eventId}`;

    try {
      const saved = sessionStorage.getItem(scrollKey);
      if (saved) {
        sessionStorage.removeItem(scrollKey);
        window.scrollTo(0, Number(saved));
      }
    } catch {
      // brak dostępu do sessionStorage — zostajemy na górze strony
    }

    const busy = () => {
      const active = document.activeElement;
      if (active instanceof HTMLTextAreaElement && active.value.trim()) return true;
      if (active instanceof HTMLInputElement && active.type !== "checkbox" && active.type !== "radio") return true;
      if (document.querySelector("[data-dirty]")) return true;
      const draft = document.querySelector<HTMLTextAreaElement>("#chat-input");
      return Boolean(draft?.value.trim());
    };

    const reload = () => {
      try {
        sessionStorage.setItem(scrollKey, String(window.scrollY));
      } catch {
        // bez zapamiętania przewinięcia
      }
      // Bez jednorazowych komunikatów (?ok=…, ?error=…), żeby nie pokazały się ponownie.
      const url = new URL(window.location.href);
      url.searchParams.delete("ok");
      url.searchParams.delete("error");
      window.location.replace(url.toString());
    };

    banner.querySelector("[data-live-reload]")?.addEventListener("click", reload);

    let changed = false;
    const check = async () => {
      if (document.visibilityState !== "visible") return;
      if (!changed) {
        try {
          const response = await fetch(`/api/events/${eventId}/version`, { cache: "no-store" });
          if (!response.ok) return;
          const data = (await response.json()) as { version?: string | null };
          changed = Boolean(data.version) && data.version !== version;
        } catch {
          return;
        }
      }
      if (!changed) return;
      if (busy()) banner.hidden = false;
      else reload();
    };

    window.setInterval(() => void check(), 15000);
    document.addEventListener("visibilitychange", () => void check());
  }
</script>
