---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { EVENTS_PAGE_SIZE, MAX_EVENTS_SHOWN, listUpcomingEvents } from "@/lib/services/events";
import { SPORTS, sportLabel } from "@/lib/sports";
import { formatEventDate } from "@/lib/time";
import type { EventListItem } from "@/types";
import SportCard from "@/components/events/SportCard.astro";
import EventMap from "@/components/map/EventMap";
import { freeReserve, freeSpots, minimumLabel, missingToMinimum, teamSize } from "@/lib/capacity";

const { user } = Astro.locals;
const sport = Astro.url.searchParams.get("sport") ?? "";
const day = Astro.url.searchParams.get("day") ?? "";
const created = Astro.url.searchParams.has("created");
// „Pokaż więcej” zwiększa liczbę widocznych ogłoszeń, zachowując filtry.
const requestedShow = Number.parseInt(Astro.url.searchParams.get("show") ?? "", 10);
const show = Number.isFinite(requestedShow)
  ? Math.min(Math.max(requestedShow, EVENTS_PAGE_SIZE), MAX_EVENTS_SHOWN)
  : EVENTS_PAGE_SIZE;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let events: EventListItem[] = [];
let hasMore = false;
let loadError = false;
if (supabase) {
  try {
    ({ events, hasMore } = await listUpcomingEvents(
      supabase,
      { sport, day },
      { authenticated: Boolean(user), limit: show },
    ));
  } catch (error) {
    // eslint-disable-next-line no-console -- server log for failed list queries
    console.error(error);
    loadError = true;
  }
}

const moreParams = new URLSearchParams();
if (sport) moreParams.set("sport", sport);
if (day) moreParams.set("day", day);
moreParams.set("show", String(Math.min(show + EVENTS_PAGE_SIZE, MAX_EVENTS_SHOWN)));
const moreHref = `/events?${moreParams.toString()}`;

/** Link pigułki sportu, zachowuje wybrany dzień. */
function filterHref(sportId: string, dayValue: string): string {
  const params = new URLSearchParams();
  if (sportId) params.set("sport", sportId);
  if (dayValue) params.set("day", dayValue);
  const query = params.toString();
  return query ? `/events?${query}` : "/events";
}

const inputClass =
  "rounded-full border border-line-strong bg-card px-4 py-2 text-sm text-ink focus:ring-2 focus:ring-brand focus:outline-none";
---

<Layout title="Ogłoszenia · Ktoś/Coś">
  <div class="bg-app min-h-screen p-4">
    <div class="mx-auto max-w-3xl">
      <Topbar title="W co dziś gramy?" />

      {created && (
        <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-4 py-2 text-sm text-ok">
          Ogłoszenie zostało dodane.
        </p>
      )}

      <nav class="-mx-4 mb-3 flex gap-2 overflow-x-auto px-4 pb-1" aria-label="Sport" data-testid="sport-chips">
        {[{ id: "", label: "Wszystkie" }, ...SPORTS].map((s) => (
          <a
            href={filterHref(s.id, day)}
            aria-current={s.id === sport ? "page" : undefined}
            class:list={[
              "shrink-0 rounded-full px-4 py-1.5 text-sm font-semibold whitespace-nowrap transition-colors",
              s.id === sport ? "bg-ink text-page" : "bg-card text-ink-2 shadow-card hover:text-ink",
            ]}
          >
            {s.label}
          </a>
        ))}
      </nav>

      <form method="GET" class="mb-5 flex flex-wrap items-center gap-2">
        {sport && <input type="hidden" name="sport" value={sport} />}
        <label class="sr-only" for="day">
          Dzień
        </label>
        <input id="day" type="date" name="day" value={day} class:list={inputClass} />
        <button
          type="submit"
          class="rounded-full border border-line-strong bg-card px-4 py-2 text-sm font-semibold text-ink transition-colors hover:bg-card-2"
        >
          Pokaż dzień
        </button>
        {(sport || day) && (
          <a href="/events" class="px-2 py-2 text-sm font-semibold text-link hover:underline">
            Wyczyść
          </a>
        )}
        {user && (
          <a
            href="/events/new"
            class="ml-auto rounded-full bg-brand px-5 py-2 text-sm font-bold text-on-brand transition-colors hover:bg-brand-hover"
          >
            + Dodaj ogłoszenie
          </a>
        )}
      </form>

      {!user && (
        <p class="mb-4 text-sm text-ink-3">
          Aby zobaczyć dokładne miejsce i szczegóły spotkań,{" "}
          <a href="/auth/signin" class="text-link hover:underline">
            zaloguj się
          </a>
        </p>
      )}

      {loadError && <p class="text-bad">Nie udało się wczytać ogłoszeń. Spróbuj odświeżyć stronę.</p>}

      {!loadError && events.length === 0 && (
        <p class="rounded-xl border border-line bg-card-2 p-6 text-center text-ink-2">
          Brak nadchodzących spotkań{sport || day ? " dla wybranych filtrów" : ""}.
        </p>
      )}

      <ul class="grid gap-3">
        {events.map((event) => (
          <SportCard sport={event.sport}>
            <h2 class="text-lg font-extrabold tracking-tight">
              <a href={`/events/${event.id}`} class="after:absolute after:inset-0 hover:underline">
                {sportLabel(event.sport)}
              </a>
            </h2>
            <p class="text-sm font-semibold text-date">{formatEventDate(event.starts_at)}</p>
            <p class="text-sm text-ink-2">
              {event.area}
              {event.place && <span class="text-ink-3"> · {event.place}</span>}
            </p>
            <div class="mt-3 flex items-baseline gap-1.5" data-testid="card-free-spots">
              <span class="text-2xl font-extrabold">{freeSpots(event)}</span>
              <span class="text-sm text-ink-2">wolnych z {teamSize(event)}</span>
            </div>
            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-track" aria-hidden="true">
              <div
                class="bg-fill h-full rounded-full"
                style={`width: ${String(Math.round(((teamSize(event) - freeSpots(event)) / Math.max(teamSize(event), 1)) * 100))}%`}
              />
            </div>
            {event.organizer_plays && <p class="mt-1 text-xs text-ink-3">Skład łącznie z organizatorem.</p>}
            {(minimumLabel(event) !== null || event.reserve_spots > 0) && (
              <p class="mt-1 flex flex-wrap gap-x-3 text-xs">
                {minimumLabel(event) && (
                  <span class:list={[missingToMinimum(event) === 0 ? "text-ok" : "text-warn"]}>
                    {minimumLabel(event)}
                  </span>
                )}
                {event.reserve_spots > 0 && (
                  <span class="text-bad">
                    Rezerwa: wolne {freeReserve(event)} z {event.reserve_spots}
                  </span>
                )}
              </p>
            )}
            {event.description && <p class="mt-2 text-sm whitespace-pre-line text-ink-2">{event.description}</p>}
            {event.lat != null && event.lng != null && (
              <details class="relative z-10 mt-3">
                <summary class="cursor-pointer text-sm text-link hover:underline">Pokaż na mapie</summary>
                <div class="mt-2">
                  <EventMap lat={event.lat} lng={event.lng} label={event.place ?? event.area} client:visible />
                </div>
              </details>
            )}
          </SportCard>
        ))}
      </ul>

      {hasMore && show < MAX_EVENTS_SHOWN && (
        <div class="mt-4 text-center">
          <a
            href={moreHref}
            data-testid="show-more"
            class="inline-block rounded-full border border-line-strong bg-card shadow-card px-4 py-2 text-sm text-ink transition-colors hover:bg-card-2"
          >
            Pokaż więcej
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
