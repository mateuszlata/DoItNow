---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Jersey from "@/components/Jersey.astro";
import SportIcon from "@/components/SportIcon.astro";
import { createClient } from "@/lib/supabase";
import { EVENTS_PAGE_SIZE, MAX_EVENTS_SHOWN, listUpcomingEvents } from "@/lib/services/events";
import { SPORTS, sportLabel } from "@/lib/sports";
import { WHEN_OPTIONS, formatEventDate, formatTimeRange } from "@/lib/time";
import { formatPLN, shareCents } from "@/lib/money";
import type { EventListItem } from "@/types";
import EventMap from "@/components/map/EventMap";
import { freeReserve, freeSpots, freeWord, minimumLabel, missingToMinimum, takenSpots, teamSize } from "@/lib/capacity";

const { user } = Astro.locals;
const sport = Astro.url.searchParams.get("sport") ?? "";
const day = Astro.url.searchParams.get("day") ?? "";
const whenParam = Astro.url.searchParams.get("when") ?? "";
const when = (WHEN_OPTIONS as readonly string[]).includes(whenParam) ? whenParam : "";
const created = Astro.url.searchParams.has("created");
// „Pokaż więcej” zwiększa liczbę widocznych ogłoszeń, zachowując filtry.
const requestedShow = Number.parseInt(Astro.url.searchParams.get("show") ?? "", 10);
const show = Number.isFinite(requestedShow)
  ? Math.min(Math.max(requestedShow, EVENTS_PAGE_SIZE), MAX_EVENTS_SHOWN)
  : EVENTS_PAGE_SIZE;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let events: EventListItem[] = [];
let hasMore = false;
let loadError = false;
if (supabase) {
  try {
    ({ events, hasMore } = await listUpcomingEvents(
      supabase,
      { sport, day, when },
      { authenticated: Boolean(user), limit: show },
    ));
  } catch (error) {
    // eslint-disable-next-line no-console -- server log for failed list queries
    console.error(error);
    loadError = true;
  }
}

/** Link filtra z zachowaniem pozostałych filtrów; `null` usuwa parametr. */
function filterHref(changes: Record<string, string | null>): string {
  const params = new URLSearchParams();
  const current: Record<string, string> = { sport, day, when };
  for (const [key, value] of Object.entries({ ...current, ...changes })) {
    if (value) params.set(key, value);
  }
  const query = params.toString();
  return query ? `/events?${query}` : "/events";
}

const moreHref = (() => {
  const href = filterHref({});
  const separator = href.includes("?") ? "&" : "?";
  return `${href}${separator}show=${String(Math.min(show + EVENTS_PAGE_SIZE, MAX_EVENTS_SHOWN))}`;
})();

const WHEN_LABELS: Record<string, string> = { "": "Wszystkie", today: "Dziś", tomorrow: "Jutro", weekend: "Weekend" };

/** Mini-koszulki składu na karcie (do 12 miejsc; większe składy pokazują pasek). */
function seats(event: EventListItem): boolean[] | null {
  const size = teamSize(event);
  if (size > 12) return null;
  const taken = takenSpots(event);
  return Array.from({ length: size }, (_, i) => i < taken);
}

/** Wezwanie do działania na karcie, zależnie od wolnych miejsc i rezerwy. */
function cta(event: EventListItem): { label: string; tone: "brand" | "dark" | "muted" } {
  if (freeSpots(event) > 0) return { label: event.requires_approval ? "Zgłoś się" : "Dołącz", tone: "brand" };
  if (freeReserve(event) > 0) return { label: "Na rezerwę", tone: "dark" };
  return { label: "Komplet", tone: "muted" };
}
---

<Layout title="Ogłoszenia · Metando">
  <div class="bg-app min-h-screen p-4 pb-32">
    <div class="mx-auto max-w-3xl">
      <Topbar title="W co dziś|gramy?" />

      {created && (
        <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-4 py-2 text-sm font-semibold text-ok">
          Ogłoszenie zostało dodane.
        </p>
      )}

      <nav
        class="-mx-4 mb-3 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none]"
        aria-label="Sport"
        data-testid="sport-chips"
      >
        {[{ id: "", label: "Wszystkie" }, ...SPORTS].map((s) => (
          <a
            href={filterHref({ sport: s.id || null })}
            aria-current={s.id === sport ? "page" : undefined}
            class:list={[
              "inline-flex h-11 shrink-0 items-center gap-2 rounded-full pr-4 pl-3 text-sm font-bold whitespace-nowrap transition-colors",
              s.id === sport ? "bg-brand text-on-brand" : "bg-page-2 text-page-ink hover:bg-page-deep",
            ]}
          >
            <SportIcon sport={s.id} />
            {s.label}
          </a>
        ))}
      </nav>

      <form method="GET" class="mb-5 flex gap-1.5 rounded-full bg-page-deep p-1" aria-label="Termin">
        {sport && <input type="hidden" name="sport" value={sport} />}
        {["", ...WHEN_OPTIONS].map((option) => (
          <a
            href={filterHref({ when: option || null, day: null })}
            aria-current={option === when && !(option === "" && day) ? "page" : undefined}
            class:list={[
              "grid h-10 flex-1 place-items-center rounded-full text-[13px] font-extrabold tracking-wide uppercase transition-colors",
              option === when && !(option === "" && day) ? "bg-card text-ink" : "text-page-ink-2 hover:text-page-ink",
            ]}
          >
            {WHEN_LABELS[option]}
          </a>
        ))}
        <label
          class:list={[
            "relative grid h-10 w-11 shrink-0 cursor-pointer place-items-center rounded-full",
            day ? "bg-card text-ink" : "bg-page-2 text-page-ink",
          ]}
          title="Wybierz dzień"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4"></path>
          </svg>
          <span class="sr-only">Dzień</span>
          <input
            type="date"
            name="day"
            value={day}
            class="absolute inset-0 cursor-pointer opacity-0"
            onchange="this.form.submit()"
          />
        </label>
      </form>

      {day && (
        <p class="mb-4 text-sm text-page-ink-2">
          Spotkania w dniu <strong class="text-page-ink">{day.split("-").reverse().join(".")}</strong> ·{" "}
          <a href={filterHref({ day: null })} class="font-semibold text-page-link hover:underline">
            pokaż wszystkie
          </a>
        </p>
      )}

      {!user && (
        <p class="mb-4 text-sm text-page-ink-2">
          Aby zobaczyć dokładne miejsce i szczegóły spotkań,{" "}
          <a href="/auth/signin" class="font-semibold text-page-link hover:underline">
            zaloguj się
          </a>
        </p>
      )}

      {loadError && (
        <p class="rounded-2xl bg-bad-soft p-4 text-bad">Nie udało się wczytać ogłoszeń. Spróbuj odświeżyć stronę.</p>
      )}

      {!loadError && events.length === 0 && (
        <div class="rounded-[20px] bg-page-2 p-6 text-center">
          <p class="display text-3xl text-page-ink">Pusto na boisku</p>
          <p class="mt-2 text-sm text-page-ink-2">
            Brak nadchodzących spotkań{sport || day || when ? " dla wybranych filtrów" : ""}. Wystaw własne — ktoś na
            pewno dołączy.
          </p>
        </div>
      )}

      <ul class="grid gap-4">
        {events.map((event) => {
          const full = freeSpots(event) === 0;
          const action = cta(event);
          const shirts = seats(event);
          const missing = missingToMinimum(event);
          return (
            <li class="overflow-hidden rounded-[20px] bg-card text-ink" data-sport={event.sport}>
              <div
                class:list={["flex items-center justify-between gap-3 px-3.5 py-2.5", full ? "bg-card-2" : "bg-brand"]}
              >
                <h2 class="display text-[28px] leading-none">
                  <a href={`/events/${event.id}`} class="inline-flex items-center gap-2 hover:underline">
                    <SportIcon sport={event.sport} size={22} strokeWidth={2.2} />
                    {sportLabel(event.sport)}
                  </a>
                </h2>
                <span class="display text-2xl">{formatTimeRange(event.starts_at, event.duration_minutes)}</span>
              </div>

              <div class="flex flex-col gap-3 p-3.5">
                <div class="flex flex-col gap-0.5 text-sm">
                  <span class="font-bold">{formatEventDate(event.starts_at)}</span>
                  <span class="text-ink-2">
                    {event.area}
                    {event.place && <> · {event.place}</>}
                  </span>
                </div>

                {event.lat != null && event.lng != null && (
                  <div class="relative isolate overflow-hidden rounded-2xl">
                    <EventMap
                      lat={event.lat}
                      lng={event.lng}
                      label={event.place ?? event.area}
                      preview
                      client:visible
                    />
                    <a href={`/events/${event.id}`} class="absolute inset-0 z-[450]" aria-hidden="true" tabindex="-1">
                      <span class="sr-only">Szczegóły ogłoszenia</span>
                    </a>
                  </div>
                )}

                <div class="flex items-end justify-between gap-3" data-testid="card-free-spots">
                  <div class="flex items-baseline gap-1.5">
                    <span
                      class:list={[
                        "display number-shadow text-[64px] leading-[0.8]",
                        full ? "text-ink-3" : "text-page",
                      ]}
                    >
                      {freeSpots(event)}
                    </span>
                    <span class="display text-xl text-ink-2">
                      {freeWord(freeSpots(event))} z {teamSize(event)}
                      {full && " · komplet"}
                    </span>
                  </div>
                  {shirts ? (
                    <div class="grid grid-cols-6 gap-[3px]" aria-hidden="true">
                      {shirts.map((taken) => (
                        <Jersey sport={event.sport} fill={taken ? "var(--ok)" : "#BFD9C8"} width={18} />
                      ))}
                    </div>
                  ) : (
                    <div class="mb-2 h-2 w-28 overflow-hidden rounded-full bg-track" aria-hidden="true">
                      <div
                        class="bg-fill h-full rounded-full"
                        style={`width: ${String(Math.round((takenSpots(event) / Math.max(teamSize(event), 1)) * 100))}%`}
                      />
                    </div>
                  )}
                </div>

                <div class="flex items-center justify-between gap-3">
                  <div class="flex min-w-0 flex-col gap-0.5 text-[13px]">
                    {minimumLabel(event) && (
                      <span class:list={["font-bold", missing === 0 ? "text-ok" : "text-warn"]}>
                        {missing === 0 ? "Minimum osiągnięte" : minimumLabel(event)}
                      </span>
                    )}
                    {event.cost_cents != null && (
                      <span class="font-bold text-ink" data-testid="card-cost">
                        {formatPLN(shareCents(event.cost_cents, teamSize(event)))} / os.
                        <span class="font-normal text-ink-3"> · obiekt {formatPLN(event.cost_cents)}</span>
                      </span>
                    )}
                    <span class="text-ink-3">
                      {event.reserve_spots > 0
                        ? `Rezerwa ${String(event.reserve_count)} z ${String(event.reserve_spots)}`
                        : "Bez rezerwy"}
                      {event.organizer_plays && " · organizator gra"}
                    </span>
                  </div>
                  <a
                    href={`/events/${event.id}`}
                    class:list={[
                      "grid h-[46px] shrink-0 place-items-center rounded-full px-5 text-sm font-extrabold tracking-wide uppercase transition-colors",
                      action.tone === "brand" && "bg-brand text-on-brand hover:bg-brand-hover",
                      action.tone === "dark" && "bg-ink text-card",
                      action.tone === "muted" && "bg-card-2 text-ink-3",
                    ]}
                  >
                    {action.label}
                  </a>
                </div>

                {event.description && <p class="line-clamp-2 text-sm text-ink-2">{event.description}</p>}
              </div>

              <div class="sleeve sleeve-dark pb-[3px]" aria-hidden="true">
                <span />
                <span />
              </div>
            </li>
          );
        })}
      </ul>

      {hasMore && show < MAX_EVENTS_SHOWN && (
        <div class="mt-5 text-center">
          <a
            href={moreHref}
            data-testid="show-more"
            class="inline-grid h-12 place-items-center rounded-full bg-page-2 px-6 text-sm font-bold text-page-ink transition-colors hover:bg-page-deep"
          >
            Pokaż więcej
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
