---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Jersey from "@/components/Jersey.astro";
import SportIcon from "@/components/SportIcon.astro";
import { createClient } from "@/lib/supabase";
import { EVENTS_PAGE_SIZE, MAX_EVENTS_SHOWN, listUpcomingEvents } from "@/lib/services/events";
import { SPORTS, sportLabel } from "@/lib/sports";
import { WHEN_OPTIONS, formatEventDay, formatTimeRange } from "@/lib/time";
import Countdown from "@/components/events/Countdown.astro";
import { formatPLN, shareCents } from "@/lib/money";
import type { EventListItem } from "@/types";
import EventMap from "@/components/map/EventMap";
import VenueStatus from "@/components/events/VenueStatus.astro";
import SportPicker from "@/components/SportPicker.astro";
import { getFavoriteSports, normalizeSports, parseSportsParam } from "@/lib/services/preferences";
import { freeReserve, freeSpots, freeWord, minimumLabel, missingToMinimum, takenSpots, teamSize } from "@/lib/capacity";
import { meetingChance, type Chance } from "@/lib/chance";

/** Szansa, że mecz się odbędzie — plakietka na karcie (src/lib/chance.ts). */
function cardChance(event: EventListItem): Chance {
  return meetingChance({
    teamSize: teamSize(event),
    minPeople: event.min_people,
    confirmed: event.accepted_count + (event.organizer_plays ? 1 : 0) + event.guest_confirmed,
    pendingInvites: Math.max(event.guest_count - event.guest_confirmed, 0),
    freeSpots: freeSpots(event),
    hoursToStart: (new Date(event.starts_at).getTime() - Date.now()) / 3_600_000,
  });
}
const CHANCE_TONE = {
  high: "bg-free text-white",
  medium: "bg-bench text-page-deep",
  low: "bg-bad-soft text-bad",
} as const;

const { user } = Astro.locals;
const day = Astro.url.searchParams.get("day") ?? "";
const whenParam = Astro.url.searchParams.get("when") ?? "";
const when = (WHEN_OPTIONS as readonly string[]).includes(whenParam) ? whenParam : "";
const created = Astro.url.searchParams.has("created");
const deleted = Astro.url.searchParams.has("deleted");
// „Pokaż więcej” zwiększa liczbę widocznych ogłoszeń, zachowując filtry.
const requestedShow = Number.parseInt(Astro.url.searchParams.get("show") ?? "", 10);
const show = Number.isFinite(requestedShow)
  ? Math.min(Math.max(requestedShow, EVENTS_PAGE_SIZE), MAX_EVENTS_SHOWN)
  : EVENTS_PAGE_SIZE;

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Sporty na liście: z adresu (`sports`, starsze `sport`), a bez niego — ulubione sporty zalogowanego.
// `all` pokazuje wszystkie sporty mimo zapisanych ulubionych.
const favorites = user && supabase ? await getFavoriteSports(supabase, user.id) : null;
const hasFavorites = favorites !== null && favorites.length > 0;
const sportsParam = parseSportsParam(Astro.url.searchParams.get("sports") ?? Astro.url.searchParams.get("sport"));
const showAll = Astro.url.searchParams.has("all");
const usingFavorites = sportsParam === null && !showAll && hasFavorites;
const selected: string[] = sportsParam ?? (usingFavorites ? favorites : []);
// Pierwsze wejście zalogowanego: pytamy, w co gra.
const askSports = user !== null && favorites === null;
const okKey = Astro.url.searchParams.get("ok");

let events: EventListItem[] = [];
let hasMore = false;
let loadError = false;
if (supabase) {
  try {
    ({ events, hasMore } = await listUpcomingEvents(
      supabase,
      { sports: selected, day, when },
      { authenticated: Boolean(user), limit: show },
    ));
  } catch (error) {
    // eslint-disable-next-line no-console -- server log for failed list queries
    console.error(error);
    loadError = true;
  }
}

/** Parametry adresu dla wybranych sportów: ulubione nie potrzebują parametru, „wszystkie” przy ulubionych — `all`. */
function sportsQuery(list: string[]): Record<string, string> {
  const same =
    favorites !== null &&
    hasFavorites &&
    list.length === favorites.length &&
    list.every((id) => favorites.includes(id));
  if (same) return {};
  if (list.length === 0) return hasFavorites ? { all: "1" } : {};
  return { sports: list.join(",") };
}

/** Link filtra z zachowaniem pozostałych filtrów; `null` usuwa parametr. */
function filterHref(changes: { sports?: string[]; when?: string | null; day?: string | null }): string {
  const params = new URLSearchParams(sportsQuery(changes.sports ?? selected));
  const nextWhen = changes.when === undefined ? when : changes.when;
  const nextDay = changes.day === undefined ? day : changes.day;
  if (nextWhen) params.set("when", nextWhen);
  if (nextDay) params.set("day", nextDay);
  const query = params.toString();
  return query ? `/events?${query}` : "/events";
}

/** Kliknięcie kafelka sportu dokłada go do wyboru albo z niego usuwa. */
function toggleSport(id: string): string[] {
  return normalizeSports(selected.includes(id) ? selected.filter((s) => s !== id) : [...selected, id]);
}

const moreHref = (() => {
  const href = filterHref({});
  const separator = href.includes("?") ? "&" : "?";
  return `${href}${separator}show=${String(Math.min(show + EVENTS_PAGE_SIZE, MAX_EVENTS_SHOWN))}`;
})();

const WHEN_LABELS: Record<string, string> = {
  "": "Każdy termin",
  today: "Dziś",
  tomorrow: "Jutro",
  weekend: "Weekend",
};

/** Mini-koszulki składu na karcie (do 12 miejsc; większe składy pokazują pasek). */
function seats(event: EventListItem): boolean[] | null {
  const size = teamSize(event);
  if (size > 12) return null;
  const taken = takenSpots(event);
  return Array.from({ length: size }, (_, i) => i < taken);
}

/** Wezwanie do działania na karcie, zależnie od wolnych miejsc i rezerwy. */
function cta(event: EventListItem): { label: string; tone: "brand" | "dark" | "muted" } {
  if (freeSpots(event) > 0) return { label: event.requires_approval ? "Zgłoś się" : "Dołącz", tone: "brand" };
  if (freeReserve(event) > 0) return { label: "Na rezerwę", tone: "dark" };
  return { label: "Komplet", tone: "muted" };
}
---

<Layout title="Ogłoszenia · Metando">
  <div class="bg-app min-h-screen p-4 pb-32">
    <div class="mx-auto max-w-3xl">
      <Topbar title="W co dziś|gramy?" />

      {deleted && (
        <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-4 py-2 text-sm font-semibold text-ok">
          Twoje konto zostało usunięte. Dziękujemy za wspólne granie!
        </p>
      )}

      {created && (
        <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-4 py-2 text-sm font-semibold text-ok">
          Ogłoszenie zostało dodane.
        </p>
      )}

      {okKey === "sports-saved" && (
        <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-4 py-2 text-sm font-semibold text-ok">
          Zapisaliśmy Twoje sporty. Zmienisz je w zakładce „Moje”.
        </p>
      )}
      {askSports && (
        <section class="mb-5 rounded-[20px] bg-card p-4 text-ink" data-testid="ask-sports">
          <h2 class="display text-2xl leading-none">W co grasz?</h2>
          <p class="mt-1 mb-3 text-sm text-ink-2">
            Zaznacz sporty, które Cię interesują — pokażemy przede wszystkim te spotkania.
          </p>
          <SportPicker selected={[]} next="/events" variant="onboarding" />
        </section>
      )}

      <div class="mb-1.5 flex items-baseline justify-between gap-3">
        <span class="text-[11px] font-extrabold tracking-widest text-page-ink-2 uppercase">Sport</span>
        {usingFavorites && (
          <span class="text-xs text-page-ink-2">
            Twoje sporty ·{" "}
            <a href="/my#moje-sporty" class="font-semibold text-page-link hover:underline">
              zmień
            </a>
          </span>
        )}
        {hasFavorites && !usingFavorites && (
          <a href={filterHref({ sports: favorites })} class="text-xs font-semibold text-page-link hover:underline">
            Wróć do moich sportów
          </a>
        )}
      </div>
      <nav
        class="-mx-4 mb-4 flex gap-2 overflow-x-auto px-4 pb-1 [mask-image:linear-gradient(to_right,black_85%,transparent)] [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:[mask-image:none]"
        aria-label="Sport"
        data-testid="sport-chips"
      >
        <a
          href={filterHref({ sports: [] })}
          aria-current={selected.length === 0 ? "page" : undefined}
          class:list={[
            "inline-flex h-10 shrink-0 items-center gap-2 rounded-full pr-4 pl-3 text-sm font-bold whitespace-nowrap transition-colors",
            selected.length === 0 ? "bg-card text-ink" : "bg-page-2 text-page-ink hover:bg-page-deep",
          ]}
        >
          <SportIcon />
          Wszystkie sporty
        </a>
        {SPORTS.map((s) => {
          const on = selected.includes(s.id);
          return (
            <a
              href={filterHref({ sports: toggleSport(s.id) })}
              data-selected={on ? "" : undefined}
              class:list={[
                "inline-flex h-10 shrink-0 items-center gap-2 rounded-full pr-4 pl-3 text-sm font-bold whitespace-nowrap transition-colors",
                on ? "bg-card text-ink" : "bg-page-2 text-page-ink hover:bg-page-deep",
              ]}
            >
              <SportIcon sport={s.id} />
              {s.label}
              {on && <span class="sr-only">(wybrany)</span>}
              {on && (
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12l5 5L20 7"></path>
                </svg>
              )}
            </a>
          );
        })}
      </nav>

      <span class="mb-1.5 block text-[11px] font-extrabold tracking-widest text-page-ink-2 uppercase">Kiedy</span>
      <form method="GET" class="mb-5 flex gap-1.5 rounded-full bg-page-deep p-1" aria-label="Termin">
        {Object.entries(sportsQuery(selected)).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        {["", ...WHEN_OPTIONS].map((option) => (
          <a
            href={filterHref({ when: option || null, day: null })}
            aria-current={option === when && !(option === "" && day) ? "page" : undefined}
            class:list={[
              "grid h-10 flex-1 place-items-center rounded-full text-[12px] font-extrabold tracking-wide whitespace-nowrap uppercase transition-colors sm:text-[13px]",
              option === when && !(option === "" && day) ? "bg-card text-ink" : "text-page-ink-2 hover:text-page-ink",
            ]}
          >
            {WHEN_LABELS[option]}
          </a>
        ))}
        <label
          class:list={[
            "relative grid h-10 w-11 shrink-0 cursor-pointer place-items-center rounded-full",
            day ? "bg-card text-ink" : "bg-page-2 text-page-ink",
          ]}
          title="Wybierz dzień"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h16v14H4zM4 10h16M8 3v4M16 3v4"></path>
          </svg>
          <span class="sr-only">Dzień</span>
          <input
            type="date"
            name="day"
            value={day}
            class="absolute inset-0 cursor-pointer opacity-0"
            onchange="this.form.submit()"
          />
        </label>
      </form>

      {day && (
        <p class="mb-4 text-sm text-page-ink-2">
          Spotkania w dniu <strong class="text-page-ink">{day.split("-").reverse().join(".")}</strong> ·{" "}
          <a href={filterHref({ day: null })} class="font-semibold text-page-link hover:underline">
            pokaż wszystkie
          </a>
        </p>
      )}

      {!user && (
        <p class="mb-4 text-sm text-page-ink-2">
          Aby zobaczyć dokładne miejsce i szczegóły spotkań,{" "}
          <a href="/auth/signin" class="font-semibold text-page-link hover:underline">
            zaloguj się
          </a>
        </p>
      )}

      {loadError && (
        <p class="rounded-2xl bg-bad-soft p-4 text-bad">Nie udało się wczytać ogłoszeń. Spróbuj odświeżyć stronę.</p>
      )}

      {!loadError && events.length === 0 && (
        <div class="rounded-[20px] bg-page-2 p-6 text-center">
          <p class="display text-3xl text-page-ink">Pusto na boisku</p>
          <p class="mt-2 text-sm text-page-ink-2">
            Brak nadchodzących spotkań{selected.length > 0 || day || when ? " dla wybranych filtrów" : ""}. Wystaw
            własne — ktoś na pewno dołączy.
          </p>
        </div>
      )}

      <ul class="grid gap-4">
        {events.map((event) => {
          const full = freeSpots(event) === 0;
          const action = cta(event);
          const shirts = seats(event);
          const missing = missingToMinimum(event);
          return (
            <li class="overflow-hidden rounded-[20px] bg-card text-ink" data-sport={event.sport}>
              <div
                class:list={["flex items-center justify-between gap-3 px-3.5 py-2.5", full ? "bg-card-2" : "bg-brand"]}
              >
                <h2 class="display text-[28px] leading-none">
                  <a href={`/events/${event.id}`} class="inline-flex items-center gap-2 hover:underline">
                    <SportIcon sport={event.sport} size={22} strokeWidth={2.2} />
                    {sportLabel(event.sport)}
                  </a>
                </h2>
                <span class="display text-2xl">{formatTimeRange(event.starts_at, event.duration_minutes)}</span>
              </div>

              <div class="flex flex-col gap-3 p-3.5">
                <div class="flex flex-col gap-1 text-[15px]">
                  <span class="flex flex-wrap items-center justify-between gap-2">
                    <span class="font-bold first-letter:uppercase">{formatEventDay(event.starts_at)}</span>
                    <Countdown startsAt={event.starts_at} durationMinutes={event.duration_minutes} />
                  </span>
                  <span class="text-ink-2">
                    {event.area}
                    {event.place && <> · {event.place}</>}
                  </span>
                </div>

                {event.lat != null && event.lng != null && (
                  <div class="relative isolate overflow-hidden rounded-2xl">
                    <EventMap
                      lat={event.lat}
                      lng={event.lng}
                      label={event.place ?? event.area}
                      preview
                      client:visible
                    />
                    <a href={`/events/${event.id}`} class="absolute inset-0 z-[450]" aria-hidden="true" tabindex="-1">
                      <span class="sr-only">Szczegóły ogłoszenia</span>
                    </a>
                  </div>
                )}

                <div class="flex items-end justify-between gap-3" data-testid="card-free-spots">
                  <div class="flex items-baseline gap-1.5">
                    <span
                      class:list={[
                        "display number-shadow text-[64px] leading-[0.8]",
                        full ? "text-ink-3" : "text-page",
                      ]}
                    >
                      {freeSpots(event)}
                    </span>
                    <span class="display text-xl text-ink-2">
                      {freeWord(freeSpots(event))} z {teamSize(event)}
                      {full && " · komplet"}
                    </span>
                  </div>
                  {shirts ? (
                    <div class="grid grid-cols-6 gap-[3px]" aria-hidden="true">
                      {shirts.map((taken) => (
                        <Jersey sport={event.sport} fill={taken ? "var(--ok)" : "#BFD9C8"} width={18} />
                      ))}
                    </div>
                  ) : (
                    <div class="mb-2 h-2 w-28 overflow-hidden rounded-full bg-track" aria-hidden="true">
                      <div
                        class="bg-fill h-full rounded-full"
                        style={`width: ${String(Math.round((takenSpots(event) / Math.max(teamSize(event), 1)) * 100))}%`}
                      />
                    </div>
                  )}
                </div>

                <div class="flex items-center justify-between gap-3">
                  <div class="flex min-w-0 flex-col gap-0.5 text-sm">
                    {minimumLabel(event) && (
                      <span class:list={["font-bold", missing === 0 ? "text-ok" : "text-warn"]}>
                        {missing === 0 ? "Minimum osiągnięte" : minimumLabel(event)}
                      </span>
                    )}
                    {(() => {
                      const chance = cardChance(event);
                      return (
                        <span
                          class:list={["w-fit rounded-full px-2 py-0.5 text-xs font-bold", CHANCE_TONE[chance.level]]}
                          title="Szansa, że mecz się odbędzie"
                          data-testid="card-chance"
                        >
                          Szansa na mecz: {chance.percent}%
                        </span>
                      );
                    })()}
                    <VenueStatus status={event.venue_status} compact />
                    {event.cost_cents != null && (
                      <span class="font-bold text-ink" data-testid="card-cost">
                        {formatPLN(shareCents(event.cost_cents, teamSize(event)))} / os.
                        <span class="font-normal text-ink-3"> · obiekt {formatPLN(event.cost_cents)}</span>
                      </span>
                    )}
                    <span class="text-ink-3">
                      {event.reserve_spots > 0
                        ? `Rezerwa ${String(event.reserve_count)} z ${String(event.reserve_spots)}`
                        : "Bez rezerwy"}
                      {event.organizer_plays && " · organizator gra"}
                    </span>
                  </div>
                  <a
                    href={`/events/${event.id}`}
                    class:list={[
                      "grid h-[46px] shrink-0 place-items-center rounded-full px-5 text-sm font-extrabold tracking-wide uppercase transition-colors",
                      action.tone === "brand" && "bg-brand text-on-brand hover:bg-brand-hover",
                      action.tone === "dark" && "bg-ink text-card",
                      action.tone === "muted" && "bg-card-2 text-ink-3",
                    ]}
                  >
                    {action.label}
                  </a>
                </div>

                {event.description && <p class="line-clamp-2 text-sm text-ink-2">{event.description}</p>}
              </div>

              <div class="sleeve sleeve-dark pb-[3px]" aria-hidden="true">
                <span />
                <span />
              </div>
            </li>
          );
        })}
      </ul>

      {hasMore && show < MAX_EVENTS_SHOWN && (
        <div class="mt-5 text-center">
          <a
            href={moreHref}
            data-testid="show-more"
            class="inline-grid h-12 place-items-center rounded-full bg-page-2 px-6 text-sm font-bold text-page-ink transition-colors hover:bg-page-deep"
          >
            Pokaż więcej
          </a>
        </div>
      )}

      <a
        href="/venues/new"
        data-testid="add-venue-entry"
        class="mt-6 flex items-center justify-between gap-4 rounded-[20px] bg-page-2 p-5 text-page-ink transition-colors hover:bg-page-deep"
      >
        <span class="flex flex-col gap-1">
          <span class="display text-2xl leading-none">Masz boisko, halę albo korty?</span>
          <span class="text-sm text-page-ink-2">
            Dodaj obiekt z cennikiem i godzinami otwarcia — gracze zarezerwują u Ciebie termin.
          </span>
        </span>
        <span class="shrink-0 rounded-full bg-brand px-4 py-2 text-sm font-extrabold tracking-wide text-on-brand uppercase">
          Dodaj obiekt
        </span>
      </a>
      <p class="mt-6 text-center text-xs text-page-ink-2">
        <a href="/regulamin" class="hover:underline">
          Regulamin
        </a>{" "}
        ·{" "}
        <a href="/prywatnosc" class="hover:underline">
          Polityka prywatności
        </a>
      </p>
    </div>
  </div>
</Layout>
