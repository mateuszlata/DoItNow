---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getEventDetails, getPublicEvent } from "@/lib/services/events";
import { sportLabel } from "@/lib/sports";
import { formatEventDate } from "@/lib/time";
import type { EventDetails, PublicEvent } from "@/types";

const { user } = Astro.locals;
const id = Astro.params.id ?? "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let details: EventDetails | null = null;
let publicEvent: PublicEvent | null = null;
if (supabase) {
  if (user) {
    details = await getEventDetails(supabase, id);
  } else {
    publicEvent = await getPublicEvent(supabase, id);
  }
}

const event = details ?? publicEvent;
if (!event) {
  Astro.response.status = 404;
}

const isPast = details ? new Date(details.starts_at).getTime() <= Date.now() : false;
const isCancelled = details?.status === "cancelled";
---

<Layout title={event ? `${sportLabel(event.sport)} · DoItNow` : "Nie znaleziono · DoItNow"}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-xl">
      <Topbar />
      <a href="/events" class="mb-3 inline-block text-sm text-purple-300 hover:underline">
        ← Wszystkie ogłoszenia
      </a>

      {!event && (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-white">
          <h1 class="mb-2 text-xl font-bold">Nie znaleziono ogłoszenia</h1>
          <p class="text-sm text-blue-100/70">Ogłoszenie nie istnieje albo już się odbyło.</p>
        </div>
      )}

      {event && (
        <article class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
          {isCancelled && (
            <p class="mb-3 rounded-lg bg-red-500/15 px-3 py-2 text-sm text-red-200">To spotkanie zostało odwołane.</p>
          )}
          {isPast && !isCancelled && (
            <p class="mb-3 rounded-lg bg-white/10 px-3 py-2 text-sm text-blue-100/80">To spotkanie już się odbyło.</p>
          )}

          <h1 class="text-2xl font-bold">{sportLabel(event.sport)}</h1>
          <p class="mt-1 text-purple-200">{formatEventDate(event.starts_at)}</p>

          <dl class="mt-4 grid gap-3 text-sm">
            <div>
              <dt class="text-blue-100/60">Okolica</dt>
              <dd>{event.area}</dd>
            </div>
            {details && (
              <>
                <div>
                  <dt class="text-blue-100/60">Dokładne miejsce</dt>
                  <dd>{details.place}</dd>
                </div>
                <div>
                  <dt class="text-blue-100/60">Organizator</dt>
                  <dd>{details.organizer_name}</dd>
                </div>
              </>
            )}
            <div>
              <dt class="text-blue-100/60">Wolne miejsca</dt>
              <dd>
                {details ? (
                  <>
                    <strong>{details.free_spots}</strong> z {details.spots}
                  </>
                ) : (
                  <>Potrzeba osób: {event.spots}</>
                )}
              </dd>
            </div>
            {details?.description && (
              <div>
                <dt class="text-blue-100/60">Opis</dt>
                <dd class="whitespace-pre-line">{details.description}</dd>
              </div>
            )}
          </dl>

          {details && (
            <section class="mt-6">
              <h2 class="mb-2 font-semibold">Uczestnicy</h2>
              {details.participants.length === 0 ? (
                <p class="text-sm text-blue-100/60">Nikt jeszcze nie dołączył.</p>
              ) : (
                <ul class="grid gap-1 text-sm">
                  {details.participants.map((p) => (
                    <li>{p.display_name}</li>
                  ))}
                </ul>
              )}
            </section>
          )}

          {!user && (
            <p class="mt-6 text-sm text-blue-100/70">
              <a href="/auth/signin" class="text-purple-300 hover:underline">
                Zaloguj się
              </a>
              , aby zobaczyć dokładne miejsce, organizatora i uczestników.
            </p>
          )}
        </article>
      )}
    </div>
  </div>
</Layout>
