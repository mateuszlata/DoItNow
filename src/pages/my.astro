---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { listMyEvents } from "@/lib/services/events";
import { STATUS_LABELS } from "@/lib/services/participations";
import { sportLabel } from "@/lib/sports";
import { formatEventDate } from "@/lib/time";
import type { MyEventItem } from "@/types";
import SportCard from "@/components/events/SportCard.astro";
import { minimumLabel, takenSpots, teamSize } from "@/lib/capacity";

// Trasa jest chroniona w middleware, więc użytkownik jest zalogowany.
const user = Astro.locals.user;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let organized: MyEventItem[] = [];
let joined: MyEventItem[] = [];
if (supabase && user) {
  ({ organized, joined } = await listMyEvents(supabase, user.id));
}

const now = Date.now();
const totalPending = organized
  .filter((e) => e.status === "active" && new Date(e.starts_at).getTime() > now)
  .reduce((sum, e) => sum + e.pending_count, 0);
const isPast = (e: MyEventItem) => new Date(e.starts_at).getTime() <= now;
---

<Layout title="Moje spotkania · Metando">
  <div class="bg-app min-h-screen p-4">
    <div class="mx-auto max-w-3xl">
      <Topbar title="Moje spotkania" />

      {totalPending > 0 && (
        <p class="mb-4 rounded-2xl border border-warn-line bg-warn-soft px-3 py-2 text-sm text-warn">
          Masz zgłoszenia czekające na decyzję: {totalPending}. Wejdź w ogłoszenie, aby je zaakceptować lub odrzucić.
        </p>
      )}

      <section class="mb-8">
        <h2 class="display mb-3 text-2xl font-bold">Organizuję</h2>
        {organized.length === 0 ? (
          <p class="text-sm text-page-ink-2">
            Nie masz jeszcze ogłoszeń.{" "}
            <a href="/events/new" class="text-page-link hover:underline">
              Dodaj pierwsze
            </a>
          </p>
        ) : (
          <ul class="grid gap-3">
            {organized.map((e) => (
              <SportCard sport={e.sport} dimmed={isPast(e) || e.status === "cancelled"}>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <a href={`/events/${e.id}`} class="font-semibold hover:underline">
                    {sportLabel(e.sport)}
                  </a>
                  <span class="text-sm text-ink-2">
                    Zajęte: {takenSpots(e)} z {teamSize(e)}
                  </span>
                </div>
                <p class="mt-1 text-sm text-date">{formatEventDate(e.starts_at)}</p>
                {e.status === "active" && minimumLabel(e) && <p class="mt-1 text-xs text-ink-2">{minimumLabel(e)}</p>}
                <p class="mt-1 text-sm text-ink-2">
                  {e.status === "cancelled"
                    ? "Odwołane"
                    : e.status === "organizer_left"
                      ? "Odwołane przez Ciebie — czeka, aż ktoś z uczestników przejmie organizację"
                      : isPast(e)
                        ? "Odbyło się"
                        : e.pending_count > 0
                          ? `⚠ Oczekujące zgłoszenia: ${e.pending_count} — kliknij i rozpatrz`
                          : "Brak oczekujących zgłoszeń"}
                </p>
              </SportCard>
            ))}
          </ul>
        )}
      </section>

      <section>
        <h2 class="display mb-3 text-2xl font-bold">Moje zgłoszenia</h2>
        {joined.length === 0 ? (
          <p class="text-sm text-page-ink-2">
            Nie zgłosiłeś się jeszcze na żadne spotkanie.{" "}
            <a href="/events" class="text-page-link hover:underline">
              Przeglądaj ogłoszenia
            </a>
          </p>
        ) : (
          <ul class="grid gap-3">
            {joined.map((e) => (
              <SportCard sport={e.sport} dimmed={isPast(e) || e.status === "cancelled"}>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <a href={`/events/${e.id}`} class="font-semibold hover:underline">
                    {sportLabel(e.sport)}
                  </a>
                  {e.my_status && <span class="text-sm text-ink-2">{STATUS_LABELS[e.my_status]}</span>}
                </div>
                {e.needs_answer && (
                  <p class="mt-2 rounded-2xl border border-warn-line bg-warn-soft px-3 py-2 text-sm text-warn">
                    Organizator odwołał spotkanie.{" "}
                    <a href={`/events/${e.id}`} class="font-medium text-warn underline">
                      Zdecyduj, czy zostajesz
                    </a>
                  </p>
                )}
                <p class="mt-1 text-sm text-date">{formatEventDate(e.starts_at)}</p>
                <p class="mt-1 text-sm text-ink-2">
                  {e.area} · {e.place}
                  {e.status === "cancelled" && " · Odwołane"}
                  {e.status === "organizer_left" && !e.needs_answer && " · Organizator zrezygnował"}
                </p>
              </SportCard>
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</Layout>
