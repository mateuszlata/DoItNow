---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { listMyEvents } from "@/lib/services/events";
import { STATUS_LABELS } from "@/lib/services/participations";
import { sportLabel } from "@/lib/sports";
import { formatEventDate } from "@/lib/time";
import type { MyEventItem } from "@/types";
import SportCard from "@/components/events/SportCard.astro";
import { minimumLabel, takenSpots, teamSize } from "@/lib/capacity";
import SportPicker from "@/components/SportPicker.astro";
import { getFavoriteSports } from "@/lib/services/preferences";
import KitCreator from "@/components/KitCreator";
import { getDisplayName, getKit, getPositions } from "@/lib/services/profiles";
import { POSITION_SPORTS, positionsFor } from "@/lib/lineup";
import { defaultKit } from "@/lib/kit";
import { isAdmin } from "@/lib/services/chat";
import InstallApp from "@/components/InstallApp";
import NotificationSettings from "@/components/NotificationSettings.astro";
import { DEFAULT_NOTIFICATION_SETTINGS, getNotificationSettings } from "@/lib/services/notifications";

// Trasa jest chroniona w middleware, więc użytkownik jest zalogowany.
const user = Astro.locals.user;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let organized: MyEventItem[] = [];
let joined: MyEventItem[] = [];
if (supabase && user) {
  ({ organized, joined } = await listMyEvents(supabase, user.id));
}

const now = Date.now();
const totalPending = organized
  .filter((e) => e.status === "active" && new Date(e.starts_at).getTime() > now)
  .reduce((sum, e) => sum + e.pending_count, 0);
const isPast = (e: MyEventItem) => new Date(e.starts_at).getTime() <= now;
const deleteError = Astro.url.searchParams.get("error");
const favorites = supabase && user ? await getFavoriteSports(supabase, user.id) : null;
const sportsSaved = Astro.url.searchParams.get("ok") === "sports-saved";
const kitStatus = Astro.url.searchParams.get("ok");
const kit = supabase && user ? await getKit(supabase, user.id) : defaultKit("");
const nick = (supabase && user ? await getDisplayName(supabase, user.id) : null) ?? "";
const admin = supabase ? await isAdmin(supabase) : false;
const positions = supabase && user ? await getPositions(supabase, user.id) : {};
const positionStatus = Astro.url.searchParams.get("ok");
const positionSport = Astro.url.searchParams.get("sport");
const notificationSettings =
  supabase && user ? await getNotificationSettings(supabase, user.id) : DEFAULT_NOTIFICATION_SETTINGS;
const notificationsSaved = Astro.url.searchParams.get("ok") === "notifications-saved";
const notificationsFailed = Astro.url.searchParams.get("error") === "notifications-failed";
---

<Layout title="Moje spotkania · Metando">
  <div class="bg-app min-h-screen p-4 pb-32">
    <div class="mx-auto max-w-3xl">
      <Topbar title="Moje spotkania" />
      {admin && (
        <a
          href="/admin"
          class="mb-4 inline-flex rounded-full bg-page-2 px-4 py-2 text-sm font-bold text-page-ink hover:bg-page-deep"
          data-testid="admin-link"
        >
          Panel admina →
        </a>
      )}

      {totalPending > 0 && (
        <p class="mb-4 rounded-2xl border border-warn-line bg-warn-soft px-3 py-2 text-sm text-warn">
          Masz zgłoszenia czekające na decyzję: {totalPending}. Wejdź w ogłoszenie, aby je zaakceptować lub odrzucić.
        </p>
      )}

      <section class="mb-8">
        <h2 class="display mb-3 text-2xl font-bold">Organizuję</h2>
        {organized.length === 0 ? (
          <p class="text-sm text-page-ink-2">
            Nie masz jeszcze ogłoszeń.{" "}
            <a href="/events/new" class="text-page-link hover:underline">
              Dodaj pierwsze
            </a>
          </p>
        ) : (
          <ul class="grid gap-3">
            {organized.map((e) => (
              <SportCard sport={e.sport} dimmed={isPast(e) || e.status === "cancelled"}>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <a href={`/events/${e.id}`} class="font-semibold hover:underline">
                    {sportLabel(e.sport)}
                  </a>
                  <span class="text-sm text-ink-2">
                    Zajęte: {takenSpots(e)} z {teamSize(e)}
                  </span>
                </div>
                <p class="mt-1 text-sm text-date">{formatEventDate(e.starts_at)}</p>
                {e.status === "active" && minimumLabel(e) && <p class="mt-1 text-xs text-ink-2">{minimumLabel(e)}</p>}
                <p class="mt-1 text-sm text-ink-2">
                  {e.status === "cancelled"
                    ? "Odwołane"
                    : e.status === "organizer_left"
                      ? "Odwołane przez Ciebie — czeka, aż ktoś z uczestników przejmie organizację"
                      : isPast(e)
                        ? "Odbyło się"
                        : e.pending_count > 0
                          ? `⚠ Oczekujące zgłoszenia: ${e.pending_count} — kliknij i rozpatrz`
                          : "Brak oczekujących zgłoszeń"}
                </p>
              </SportCard>
            ))}
          </ul>
        )}
      </section>

      <section>
        <h2 class="display mb-3 text-2xl font-bold">Moje zgłoszenia</h2>
        {joined.length === 0 ? (
          <p class="text-sm text-page-ink-2">
            Nie masz jeszcze zgłoszeń na spotkania.{" "}
            <a href="/events" class="text-page-link hover:underline">
              Przeglądaj ogłoszenia
            </a>
          </p>
        ) : (
          <ul class="grid gap-3">
            {joined.map((e) => (
              <SportCard sport={e.sport} dimmed={isPast(e) || e.status === "cancelled"}>
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <a href={`/events/${e.id}`} class="font-semibold hover:underline">
                    {sportLabel(e.sport)}
                  </a>
                  {e.my_status && <span class="text-sm text-ink-2">{STATUS_LABELS[e.my_status]}</span>}
                </div>
                {e.needs_answer && (
                  <p class="mt-2 rounded-2xl border border-warn-line bg-warn-soft px-3 py-2 text-sm text-warn">
                    Organizator odwołał spotkanie.{" "}
                    <a href={`/events/${e.id}`} class="font-medium text-warn underline">
                      Zdecyduj, czy zostajesz
                    </a>
                  </p>
                )}
                <p class="mt-1 text-sm text-date">{formatEventDate(e.starts_at)}</p>
                <p class="mt-1 text-sm text-ink-2">
                  {e.area} · {e.place}
                  {e.status === "cancelled" && " · Odwołane"}
                  {e.status === "organizer_left" && !e.needs_answer && " · Organizator zrezygnował"}
                </p>
              </SportCard>
            ))}
          </ul>
        )}
      </section>

      <a
        href="/venues"
        class="mt-10 flex items-center justify-between gap-3 rounded-[20px] bg-page-2 px-5 py-4 transition-colors hover:bg-page-deep"
      >
        <span>
          <span class="display block text-2xl">Moje obiekty</span>
          <span class="text-sm text-page-ink-2">Masz boisko lub halę? Dodaj cennik i godziny otwarcia.</span>
        </span>
        <span class="text-2xl text-brand" aria-hidden="true">
          →
        </span>
      </a>

      <form method="POST" action="/api/auth/signout" class="mt-6 text-center">
        <button
          type="submit"
          class="h-11 rounded-full bg-page-2 px-6 text-sm font-bold text-page-ink transition-colors hover:bg-page-deep"
        >
          Wyloguj się
        </button>
      </form>

      <section id="moj-stroj" class="mt-8 scroll-mt-4 rounded-[20px] bg-card p-5 text-ink">
        <h2 class="display text-2xl leading-none">Moje barwy</h2>
        <p class="mt-1 mb-4 text-sm text-ink-2">
          Twój strój to Twój znak rozpoznawczy w składzie i w czacie. Wybierz wzór, kolory i ulubiony numer.
        </p>
        {kitStatus === "kit-failed" && (
          <p class="mb-3 text-sm font-semibold text-bad">Nie udało się zapisać stroju. Spróbuj ponownie.</p>
        )}
        <KitCreator initialKit={kit} nick={nick} saved={kitStatus === "kit-saved"} client:load />
      </section>

      <section id="moja-pozycja" class="mt-8 scroll-mt-4 rounded-[20px] bg-card p-5 text-ink">
        <h2 class="display text-2xl leading-none">Moje pozycje</h2>
        <p class="mt-1 mb-3 text-sm text-ink-2">
          Organizator może podzielić skład na drużyny według pozycji. Gdzie lubisz grać?
        </p>
        {positionStatus === "position-failed" && (
          <p class="mb-3 text-sm font-semibold text-bad">Nie udało się zapisać pozycji. Spróbuj ponownie.</p>
        )}
        <div class="flex flex-col gap-4">
          {POSITION_SPORTS.map((sport) => {
            const current = positions[sport] ?? "obojetnie";
            const saved = positionStatus === "position-saved" && positionSport === sport;
            return (
              <form method="POST" action="/api/profile/position" class="flex flex-col gap-2" data-position-form>
                <input type="hidden" name="sport" value={sport} />
                <span class="text-sm font-bold text-ink-2">{sportLabel(sport)}</span>
                <div class="flex flex-wrap items-center gap-2">
                  {positionsFor(sport).map((option) => (
                    <label class="inline-flex h-9 cursor-pointer items-center rounded-full border border-line-strong bg-card px-3.5 text-sm font-bold text-ink transition-colors has-checked:border-ink has-checked:bg-ink has-checked:text-card has-focus-visible:ring-2 has-focus-visible:ring-brand">
                      <input
                        type="radio"
                        name="position"
                        value={option.id}
                        checked={current === option.id}
                        class="sr-only"
                      />
                      {option.label}
                    </label>
                  ))}
                  <button
                    type="submit"
                    data-save-button
                    class:list={[
                      "h-9 rounded-full px-4 text-xs font-extrabold tracking-wide uppercase transition-colors",
                      saved ? "bg-free text-white" : "bg-brand text-on-brand hover:bg-brand-hover",
                    ]}
                  >
                    {saved ? "✓ Zapisano" : "Zapisz"}
                  </button>
                </div>
              </form>
            );
          })}
        </div>
      </section>

      <div class="mt-8">
        <InstallApp variant="section" client:only="react" />
      </div>

      <section id="moje-sporty" class="mt-8 scroll-mt-4 rounded-[20px] bg-card p-5 text-ink">
        <h2 class="display text-2xl leading-none">Moje sporty</h2>
        <p class="mt-1 mb-3 text-sm text-ink-2">
          Lista ogłoszeń pokazuje najpierw te sporty. Bez zaznaczenia widzisz wszystkie.
        </p>
        <SportPicker selected={favorites ?? []} next="/my#moje-sporty" saved={sportsSaved} />
      </section>

      <section id="powiadomienia" class="mt-8 scroll-mt-4 rounded-[20px] bg-card p-5 text-ink">
        <h2 class="display text-2xl leading-none">Powiadomienia</h2>
        <p class="mt-1 mb-3 text-sm text-ink-2">Wybierz, o czym i jak chcesz wiedzieć.</p>
        {notificationsFailed && (
          <p class="mb-3 text-sm font-semibold text-bad">Nie udało się zapisać ustawień. Spróbuj ponownie.</p>
        )}
        <NotificationSettings settings={notificationSettings} saved={notificationsSaved} />
      </section>

      <details class="mt-8 rounded-[20px] bg-page-2 px-5 py-4" open={deleteError ? true : undefined}>
        <summary class="cursor-pointer text-sm font-bold text-page-ink-2">Usuń konto</summary>
        <div class="mt-3 text-sm text-page-ink-2">
          <p>
            Usuniemy Twoje konto i wszystkie powiązane dane: nick, zgłoszenia, ogłoszenia (także nadchodzące — ich
            uczestnicy je stracą) oraz obiekty. Tej operacji nie da się cofnąć.
          </p>
          {deleteError && (
            <p class="mt-2 font-semibold text-bad">
              {deleteError === "DELETE_CONFIRM"
                ? "Wpisz słowo USUŃ, aby potwierdzić."
                : "Nie udało się usunąć konta. Spróbuj ponownie."}
            </p>
          )}
          <form method="POST" action="/api/auth/delete-account" class="mt-3 flex flex-wrap gap-2">
            <label class="sr-only" for="confirm-delete">
              Wpisz USUŃ, aby potwierdzić
            </label>
            <input
              id="confirm-delete"
              type="text"
              name="confirm"
              autocomplete="off"
              placeholder="Wpisz USUŃ"
              class="h-11 min-w-0 flex-1 rounded-full border border-line-strong bg-card px-4 text-ink"
            />
            <button type="submit" class="h-11 rounded-full bg-[#3a2420] px-5 text-sm font-bold text-[#ffb4a6]">
              Usuń konto na zawsze
            </button>
          </form>
        </div>
      </details>
      <p class="mt-6 text-center text-xs text-page-ink-2">
        <a href="/regulamin" class="hover:underline">
          Regulamin
        </a>{" "}
        ·{" "}
        <a href="/prywatnosc" class="hover:underline">
          Polityka prywatności
        </a>
      </p>
    </div>
  </div>
</Layout>

<script>
  // Po zmianie pozycji przycisk „Zapisano” wraca do „Zapisz”.
  document.querySelectorAll<HTMLFormElement>("form[data-position-form]").forEach((form) => {
    form.addEventListener("change", () => {
      const button = form.querySelector<HTMLButtonElement>("[data-save-button]");
      if (!button?.classList.contains("bg-free")) return;
      button.textContent = "Zapisz";
      button.classList.remove("bg-free", "text-white");
      button.classList.add("bg-brand", "text-on-brand", "hover:bg-brand-hover");
    });
  });
</script>
