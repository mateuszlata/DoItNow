---
// Moderacja zgłoszonych wiadomości z czatów. Dostęp: konta wpisane do tabeli public.admins.
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { isAdmin, listReports } from "@/lib/services/chat";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!Astro.locals.user || !supabase || !(await isAdmin(supabase))) return Astro.redirect("/events");

const result = await listReports(supabase);
const reports = result.ok ? result.data : [];
const done = Astro.url.searchParams.get("ok");
const when = new Intl.DateTimeFormat("pl-PL", { dateStyle: "short", timeStyle: "short", timeZone: "Europe/Warsaw" });
---

<Layout title="Zgłoszenia · Metando">
  <div class="bg-app min-h-screen p-4 pb-32">
    <div class="mx-auto max-w-3xl">
      <Topbar title="Zgłoszone|wiadomości" />

      {done && (
        <p class="mb-4 rounded-2xl bg-ok-soft px-4 py-3 text-sm text-ok">
          {done === "hidden" ? "Wiadomość ukryta." : "Zgłoszenie zamknięte, wiadomość zostaje."}
        </p>
      )}
      {!result.ok && <p class="mb-4 rounded-2xl bg-bad-soft p-4 text-bad">Nie udało się wczytać zgłoszeń.</p>}
      {result.ok && reports.length === 0 && <p class="text-page-ink-2">Brak otwartych zgłoszeń.</p>}

      <ul class="grid gap-4">
        {reports.map((r) => (
          <li class="rounded-[20px] bg-card p-4 text-ink" data-testid="message-report">
            <p class="text-xs text-ink-3">
              {r.author_name} · {when.format(new Date(r.created_at))} · zgłoszeń: {r.report_count} ·{" "}
              <a href={`/events/${r.event_id}`} class="underline">
                spotkanie
              </a>
            </p>
            <p class="mt-2 rounded-2xl bg-card-2 px-3.5 py-2 text-sm whitespace-pre-wrap">{r.body}</p>
            {r.reasons.length > 0 && (
              <ul class="mt-2 list-disc pl-5 text-xs text-ink-2">
                {r.reasons.map((reason) => (
                  <li>{reason}</li>
                ))}
              </ul>
            )}
            <form method="POST" action={`/api/admin/reports/${r.message_id}`} class="mt-3 flex gap-2">
              <button name="action" value="hide" class="h-10 rounded-full bg-ink px-4 text-sm font-bold text-card">
                Ukryj wiadomość
              </button>
              <button name="action" value="dismiss" class="h-10 rounded-full bg-card-2 px-4 text-sm font-bold">
                Zostaw
              </button>
            </form>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
