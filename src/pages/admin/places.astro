---
// Podgląd zużycia darmowej puli Google Places: miesiąc, dziś i dzisiejszy przydział (budżet kroczący).
// Dostęp: konta z tabeli public.admins.
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { GOOGLE_MAPS_API_KEY } from "astro:env/server";
import { isAdmin } from "@/lib/services/chat";
import { createClient } from "@/lib/supabase";
import { PLACES_MONTHLY_LIMIT, PLACES_USER_HOURLY_LIMIT, quotaStats, type QuotaStats } from "@/lib/services/places";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!Astro.locals.user || !supabase || !(await isAdmin(supabase))) return Astro.redirect("/events");

const stats: QuotaStats[] = await quotaStats(supabase);
const LABELS: Record<string, string> = {
  autocomplete: "Podpowiedzi (Autocomplete)",
  details: "Szczegóły miejsca (Place Details)",
};
---

<Layout title="Statystyki Google · Metando">
  <div class="bg-app min-h-screen p-4 pb-32">
    <div class="mx-auto max-w-3xl">
      <Topbar title="Wyszukiwarka|Google" />

      <p class="mb-4 text-sm text-page-ink-2">
        Klucz Google:{" "}
        <strong class="text-page-ink">{GOOGLE_MAPS_API_KEY ? "ustawiony" : "brak — działa OpenStreetMap"}</strong>.
        Limit miesięczny {PLACES_MONTHLY_LIMIT} zapytań na rodzaj (darmowe 10 000 z marginesem),{" "}
        {PLACES_USER_HOURLY_LIMIT} na osobę na godzinę.
      </p>

      <ul class="grid gap-4">
        {stats.map((s) => (
          <li class="rounded-[20px] bg-card p-4 text-ink" data-testid="quota">
            <h2 class="display text-2xl">{LABELS[s.api] ?? s.api}</h2>
            <div class="mt-3 grid grid-cols-3 gap-2 text-center">
              <div class="rounded-2xl bg-card-2 p-3">
                <div class="display text-3xl">{s.used_month}</div>
                <div class="text-xs text-ink-3">w miesiącu / {PLACES_MONTHLY_LIMIT}</div>
              </div>
              <div class="rounded-2xl bg-card-2 p-3">
                <div class="display text-3xl">{s.used_today}</div>
                <div class="text-xs text-ink-3">dziś / {s.allowed_today}</div>
              </div>
              <div class="rounded-2xl bg-card-2 p-3">
                <div class="display text-3xl">{s.days_left}</div>
                <div class="text-xs text-ink-3">dni do końca miesiąca</div>
              </div>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-track" aria-hidden="true">
              <div
                class="bg-fill h-full rounded-full"
                style={`width: ${String(Math.min(100, Math.round((s.used_month / PLACES_MONTHLY_LIMIT) * 100)))}%`}
              />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
