---
// Zaproszenie od organizatora dla osoby bez konta: karta spotkania i odpowiedź „Będę” / „Nie będę”.
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import SportIcon from "@/components/SportIcon.astro";
import { TurnstileWidget } from "@/components/auth/TurnstileWidget";
import { TURNSTILE_SITE_KEY } from "astro:env/server";
import { createClient } from "@/lib/supabase";
import { readDevice } from "@/lib/device";
import { authHref } from "@/lib/next-path";
import { getInvite, inviteErrorMessage, releaseStaleInvites } from "@/lib/services/invites";
import { sportLabel } from "@/lib/sports";
import { formatEventDay, formatTimeRange } from "@/lib/time";

const token = Astro.params.token ?? "";
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) await releaseStaleInvites(supabase);
const result =
  supabase && /^[a-f0-9]{32,64}$/.test(token) ? await getInvite(supabase, token, readDevice(Astro.cookies)) : null;
const card = result?.ok ? result.card : null;
if (!card) Astro.response.status = 404;

const ok = Astro.url.searchParams.get("ok");
const error = inviteErrorMessage(Astro.url.searchParams.get("error"));
const eventPath = card ? `/events/${card.event_id}` : "/events";
const answered = card?.mine?.answer ?? null;
---

<Layout
  title={card ? `Zaproszenie: ${sportLabel(card.sport)} · Metando` : "Zaproszenie · Metando"}
  shareTitle={card ? `${card.organizer_name} zaprasza: ${sportLabel(card.sport)} · ${card.area}` : undefined}
  description={card ? "Daj znać jednym kliknięciem, czy będziesz — bez zakładania konta." : undefined}
  image={card ? `/og/${card.sport}.png` : undefined}
>
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-3xl border border-line bg-card p-7 text-ink shadow-card"
      data-testid="invite-card"
    >
      <a href="/events" class="mb-5 flex justify-center" aria-label="Metando">
        <Logo />
      </a>

      {!card && (
        <div class="text-center">
          <h1 class="display text-3xl">Zaproszenie nieaktualne</h1>
          <p class="mt-2 text-sm text-ink-2">Ten link wygasł albo jest nieprawidłowy. Poproś organizatora o nowy.</p>
          <a href="/events" class="mt-4 inline-block text-sm font-bold text-link underline">
            Zobacz inne spotkania
          </a>
        </div>
      )}

      {card && (
        <>
          <p class="text-center text-sm text-ink-2">
            <strong class="text-ink">{card.organizer_name}</strong> zaprasza Cię na
          </p>
          <h1 class="display mt-1 flex items-center justify-center gap-2 text-4xl leading-none">
            <SportIcon sport={card.sport} size={30} strokeWidth={2.2} />
            {sportLabel(card.sport)}
          </h1>
          <p class="mt-3 text-center font-bold first-letter:uppercase">
            {formatEventDay(card.starts_at)}, {formatTimeRange(card.starts_at, card.duration_minutes)}
          </p>
          <p class="text-center text-sm text-ink-2">{card.area}</p>
          <p class="mt-3 rounded-2xl bg-card-2 px-4 py-2 text-center text-sm">
            W składzie: <strong>{card.taken}</strong> z {card.team_size}
            {card.invited_pending > 0 && <> · czeka na odpowiedź: {card.invited_pending}</>}
          </p>

          {ok === "yes" && (
            <div class="mt-4 rounded-2xl bg-free-soft p-4 text-sm text-free" role="status">
              <p class="font-bold">Super! {card.organizer_name} wie, że będziesz.</p>
              <p class="mt-1 text-ink-2">
                Załóż konto w 30 sekund, a dostaniesz dostęp do czatu spotkania i własne barwy w składzie.
              </p>
              <a
                href={authHref("signup", eventPath)}
                class="mt-3 inline-grid h-10 place-items-center rounded-full bg-brand px-4 text-xs font-extrabold tracking-wide text-on-brand uppercase"
              >
                Załóż konto
              </a>
            </div>
          )}
          {ok === "no" && (
            <p class="mt-4 rounded-2xl bg-card-2 p-3 text-sm" role="status">
              Dzięki za odpowiedź — Twoje miejsce trafi do innych graczy.
            </p>
          )}
          {error && <p class="mt-4 rounded-2xl bg-bad-soft p-3 text-sm text-bad">{error}</p>}

          {card.open ? (
            <form
              method="POST"
              action={`/api/invites/${token}`}
              class="mt-5 flex flex-col gap-3"
              data-invite-form
              data-needs-check={TURNSTILE_SITE_KEY ? "" : undefined}
            >
              <label class="text-sm text-ink-2">
                Twoje imię
                <input
                  type="text"
                  name="name"
                  required
                  maxlength="40"
                  autocomplete="given-name"
                  value={card.mine?.name ?? ""}
                  placeholder="np. Kuba"
                  class="mt-1 w-full rounded-lg border border-line-strong bg-card px-3 py-2 text-ink focus:ring-2 focus:ring-brand focus:outline-none"
                />
              </label>
              {TURNSTILE_SITE_KEY && <TurnstileWidget siteKey={TURNSTILE_SITE_KEY} client:load />}
              <p class="text-center text-xs text-ink-3" data-check-status hidden={!TURNSTILE_SITE_KEY}>
                Sprawdzamy, czy nie jesteś botem — to potrwa chwilę…
              </p>
              <div class="grid grid-cols-2 gap-2">
                <button
                  type="submit"
                  name="answer"
                  value="yes"
                  data-answer
                  class:list={[
                    "h-12 rounded-full text-sm font-extrabold tracking-wide uppercase",
                    answered === "yes" ? "bg-free text-white" : "bg-brand text-on-brand",
                  ]}
                >
                  {answered === "yes" ? "✓ Będę" : "Będę"}
                </button>
                <button
                  type="submit"
                  name="answer"
                  value="no"
                  data-answer

                  class:list={[
                    "h-12 rounded-full text-sm font-bold",
                    answered === "no" ? "bg-ink text-card" : "bg-card-2 text-ink",
                  ]}
                >
                  {answered === "no" ? "✓ Nie będę" : "Nie będę"}
                </button>
              </div>
              {answered && (
                <p class="text-center text-xs text-ink-3">Możesz zmienić odpowiedź w każdej chwili przed meczem.</p>
              )}
            </form>
          ) : (
            <p class="mt-5 text-center text-sm text-ink-2">Zapisy na to spotkanie są już zamknięte.</p>
          )}

          <p class="mt-5 text-center text-xs text-ink-3">
            Masz konto w Metando?{" "}
            <a href={authHref("signin", eventPath)} class="font-bold text-link underline">
              Zaloguj się i dołącz
            </a>
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  // Odpowiedź wysyłamy dopiero po weryfikacji Turnstile (inaczej serwer ją odrzuci jako bota).
  const form = document.querySelector<HTMLFormElement>("form[data-invite-form][data-needs-check]");
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-check-status]");
    const buttons = form.querySelectorAll<HTMLButtonElement>("[data-answer]");
    const setReady = (ready: boolean) => {
      buttons.forEach((button) => {
        button.disabled = !ready;
        button.classList.toggle("opacity-50", !ready);
      });
    };
    setReady(false);
    form.addEventListener("turnstile-state", (event) => {
      const state = (event as CustomEvent<string>).detail;
      if (!status) return;
      if (state === "ok") {
        status.hidden = true;
        setReady(true);
      } else if (state === "expired") {
        status.hidden = false;
        status.textContent = "Weryfikacja wygasła — zaznacz ją ponownie.";
        setReady(false);
      } else {
        status.hidden = false;
        status.textContent =
          "Nie udało się sprawdzić, że nie jesteś botem. Wyłącz blokowanie skryptów na tej stronie (np. tarcze w Brave) albo otwórz link w innej przeglądarce.";
        setReady(false);
      }
    });
  }
</script>
