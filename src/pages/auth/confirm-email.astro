---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Konto założone",
      description: "Twoje konto jest gotowe. Możesz się zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź skrzynkę e-mail",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white shadow-sm p-8 text-center text-slate-900 backdrop-blur-xl">
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 text-brand-gradient text-2xl font-bold">{content.heading}</h1>
      <p class="mb-6 text-slate-700">{content.description}</p>
      <a href="/auth/signin" class="text-sm text-orange-600 hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
