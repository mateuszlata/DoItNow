---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
const info = Astro.url.searchParams.get("info");
---

<Layout title="Logowanie · Ktoś/Coś">
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-3xl border border-line bg-card shadow-card p-8 text-ink backdrop-blur-xl">
      <a href="/events" class="mb-4 block">
        <img src="/logo-full.webp" alt="Ktoś/Coś" width="480" height="417" class="logo-full mx-auto h-auto w-40" />
      </a>
      <h1 class="mb-6 text-brand-gradient text-center text-2xl font-bold">Zaloguj się</h1>
      {info && <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-3 py-2 text-sm text-ok">{info}</p>}
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-ink-3">
        Nie masz konta?{""}
        <a href="/auth/signup" class="text-link hover:underline">
          Załóż konto
        </a>
      </p>
    </div>
  </div>
</Layout>
