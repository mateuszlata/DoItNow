---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import SignInForm from "@/components/auth/SignInForm";
import { authHref, safeNext } from "@/lib/next-path";
import { TURNSTILE_SITE_KEY } from "astro:env/server";

const error = Astro.url.searchParams.get("error");
// Cel powrotu po zalogowaniu (np. spotkanie z udostępnionego linku).
const next = safeNext(Astro.url.searchParams.get("next"));
const info = Astro.url.searchParams.get("info");
---

<Layout title="Logowanie · Metando">
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-3xl border border-line bg-card shadow-card p-8 text-ink backdrop-blur-xl">
      <a href="/events" class="mb-6 flex justify-center" aria-label="Metando — ogłoszenia">
        <Logo size="hero" />
      </a>
      <h1 class="display mb-6 text-ink text-center text-2xl font-bold">Zaloguj się</h1>
      {info && <p class="mb-4 rounded-2xl border border-ok-line bg-ok-soft px-3 py-2 text-sm text-ok">{info}</p>}
      <SignInForm serverError={error} next={next} turnstileSiteKey={TURNSTILE_SITE_KEY} client:load />
      <p class="mt-4 text-center text-sm text-ink-3">
        Nie masz konta?{" "}
        <a href={authHref("signup", next)} class="text-link hover:underline">
          Załóż konto
        </a>
      </p>
      <p class="mt-3 text-center text-xs text-ink-3">
        <a href="/regulamin" class="hover:underline">
          Regulamin
        </a>{" "}
        ·{" "}
        <a href="/prywatnosc" class="hover:underline">
          Polityka prywatności
        </a>
      </p>
    </div>
  </div>
</Layout>
