---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import NewPasswordForm from "@/components/auth/NewPasswordForm";

// Po linku „Nie pamiętam hasła” użytkownik jest już zalogowany sesją z linku; bez niej link wygasł.
if (!Astro.locals.user) {
  return Astro.redirect(
    `/auth/signin?error=${encodeURIComponent("Link wygasł. Poproś o nowy w „Nie pamiętasz hasła?”.")}`,
  );
}
const error = Astro.url.searchParams.get("error");
---

<Layout title="Nowe hasło · Metando">
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-3xl border border-line bg-card p-8 text-ink shadow-card backdrop-blur-xl">
      <div class="mb-6 flex justify-center">
        <Logo size="hero" />
      </div>
      <h1 class="display mb-2 text-center text-2xl font-bold text-ink">Ustaw nowe hasło</h1>
      <p class="mb-5 text-center text-sm text-ink-2">Wpisz nowe hasło do konta {Astro.locals.user.email}.</p>
      <NewPasswordForm serverError={error} client:load />
    </div>
  </div>
</Layout>
