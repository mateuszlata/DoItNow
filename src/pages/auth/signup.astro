---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Rejestracja · Ktoś/Coś">
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white shadow-sm p-8 text-slate-900 backdrop-blur-xl">
      <a href="/events" class="mb-4 block">
        <img src="/logo-full.webp" alt="Ktoś/Coś" width="480" height="417" class="mx-auto h-auto w-40" />
      </a>
      <h1 class="mb-6 text-brand-gradient text-center text-2xl font-bold">Załóż konto</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-slate-500">
        Masz już konto?{""}
        <a href="/auth/signin" class="text-orange-600 hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
