---
// „W co grasz?” — wybór ulubionych sportów kafelkami z ptaszkiem. Zapis: /api/profile/sports.
import SportIcon from "@/components/SportIcon.astro";
import { SPORTS } from "@/lib/sports";

interface Props {
  selected: string[];
  /** Strona, na którą wracamy po zapisie. */
  next: string;
  /** Pierwsze pytanie na liście ogłoszeń (z opcją „Pomiń”) albo edycja w „Moje”. */
  variant?: "onboarding" | "settings";
  /** Wybór właśnie zapisany — przycisk pokazuje „Zapisano”, dopóki nic się nie zmieni. */
  saved?: boolean;
}

const { selected, next, variant = "settings", saved = false } = Astro.props;
---

<form
  method="POST"
  action="/api/profile/sports"
  class="flex flex-col gap-3"
  data-testid="sport-picker"
  data-saved={saved ? "" : undefined}
>
  <input type="hidden" name="next" value={next} />
  <fieldset>
    <legend class="sr-only">Sporty, które Cię interesują</legend>
    <div class="flex flex-wrap gap-2">
      {SPORTS.map((s) => (
        <label class="group inline-flex h-10 cursor-pointer items-center gap-2 rounded-full border border-line-strong bg-card px-3.5 text-sm font-bold text-ink transition-colors has-checked:border-ink has-checked:bg-ink has-checked:text-card has-focus-visible:ring-2 has-focus-visible:ring-brand">
          <input type="checkbox" name="sports" value={s.id} checked={selected.includes(s.id)} class="sr-only" />
          <SportIcon sport={s.id} size={16} />
          {s.label}
          <svg
            class="hidden group-has-checked:inline"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12l5 5L20 7"></path>
          </svg>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="submit"
      data-save-button
      class:list={[
        "h-11 rounded-full px-5 text-sm font-extrabold tracking-wide uppercase transition-colors",
        saved ? "bg-free text-white" : "bg-brand text-on-brand hover:bg-brand-hover",
      ]}
    >
      {saved ? "✓ Zapisano" : variant === "onboarding" ? "Pokaż moje sporty" : "Zapisz"}
    </button>
    {variant === "onboarding" && (
      <button
        type="submit"
        formaction="/api/profile/sports?skip=1"
        class="h-11 rounded-full px-4 text-sm font-bold text-ink-2 hover:text-ink"
      >
        Pomiń — pokazuj wszystko
      </button>
    )}
  </div>
</form>

<script>
  // Po zmianie wyboru przycisk „Zapisano” wraca do „Zapisz”.
  document.querySelectorAll<HTMLFormElement>("form[data-saved]").forEach((form) => {
    form.addEventListener("change", () => {
      const button = form.querySelector<HTMLButtonElement>("[data-save-button]");
      if (!button || !form.hasAttribute("data-saved")) return;
      form.removeAttribute("data-saved");
      button.textContent = "Zapisz";
      button.classList.remove("bg-free", "text-white");
      button.classList.add("bg-brand", "text-on-brand", "hover:bg-brand-hover");
    });
  });
</script>
