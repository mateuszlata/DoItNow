---
// Strój z numerem: miejsce w składzie (projekt D2). Krój zależy od sportu — koszulka piłkarska,
// koszykarska bez rękawów, polo do gier rakietowych, kolarska z zamkiem albo numer startowy biegacza.
import { sportKit, type Kit } from "@/lib/sports";
import { JERSEY_SHAPES } from "@/lib/kit";

interface Props {
  /** Id sportu wydarzenia (wybiera krój stroju). */
  sport?: string;
  /** Kolor stroju, wykończenia i numeru. */
  fill: string;
  trim?: string;
  numberColor?: string;
  /** Numer albo znak („+”, „R1”); pusty dla mini-strojów na kartach. */
  label?: string;
  /** Szerokość w px (wysokość wynika z proporcji). */
  width?: number;
}

const { sport = "", fill, trim, numberColor = "#0F3B2E", label = "", width = 58 } = Astro.props;
const kit: Kit = sportKit(sport);
const height = Math.round((width * 52) / 48);

const shape = JERSEY_SHAPES[kit];
---

<span class="relative inline-block shrink-0" style={`width: ${String(width)}px; height: ${String(height)}px`}>
  <svg width={width} height={height} viewBox="0 0 48 52" aria-hidden="true" class="absolute inset-0">
    <path d={shape.body} fill={fill}></path>
    {kit === "bib" && trim && (
      <>
        <circle cx="9" cy="14" r="2" fill={trim} />
        <circle cx="39" cy="14" r="2" fill={trim} />
        <circle cx="9" cy="38" r="2" fill={trim} />
        <circle cx="39" cy="38" r="2" fill={trim} />
      </>
    )}
    {shape.detail && trim && (
      <path d={shape.detail} fill="none" stroke={trim} stroke-width="2.5" stroke-linecap="round" />
    )}
    {shape.stripe && trim && <path d={shape.stripe} stroke={trim} stroke-width="3" />}
  </svg>
  {label && (
    <span
      class="display absolute inset-x-0 text-center leading-none"
      style={`top: ${String(Math.round(height * shape.numberTop))}px; font-size: ${String(Math.round(width * (kit === "bib" ? 0.46 : 0.41)))}px; color: ${numberColor}`}
      aria-hidden="true"
    >
      {label}
    </span>
  )}
</span>
