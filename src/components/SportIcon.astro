---
// Liniowa ikona sportu (24×24), dziedziczy kolor z tekstu.
import { ALL_SPORTS_ICON, sportIcon } from "@/lib/sports";

interface Props {
  /** Id sportu; puste — ikona „wszystkie”. */
  sport?: string;
  size?: number;
  strokeWidth?: number;
}

const { sport = "", size = 20, strokeWidth = 1.9 } = Astro.props;
const d = sport ? sportIcon(sport) : ALL_SPORTS_ICON;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d}></path>
</svg>
