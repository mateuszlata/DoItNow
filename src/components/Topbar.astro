---
import { createClient } from "@/lib/supabase";
import { getDisplayName } from "@/lib/services/profiles";

const { user } = Astro.locals;

let displayName: string | null = null;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  displayName = supabase ? await getDisplayName(supabase, user.id) : null;
}
---

<div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  <a href="/events" class="font-semibold text-white">
    DoItNow
  </a>
  {user ? (
    <div class="flex flex-wrap items-center gap-3">
      {displayName && <span class="text-blue-100/70">{displayName}</span>}
      <a href="/events" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Ogłoszenia
      </a>
      <a href="/my" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Moje spotkania
      </a>
      <a href="/events/new" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Dodaj ogłoszenie
      </a>
      <form method="POST" action="/api/auth/signout">
        <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Wyloguj
        </button>
      </form>
    </div>
  ) : (
    <div class="flex gap-3">
      <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Zaloguj
      </a>
      <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Załóż konto
      </a>
    </div>
  )}
</div>
