---
interface Props {
  label: string;
  version?: string;
}

const { label, version } = Astro.props;
---

<span class="inline-flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-1.5 font-mono text-slate-600 shadow-sm">
  {label}
  {version && <span class="rounded-full bg-orange-100 px-2 py-0.5 text-xs text-sky-700">{version}</span>}
</span>
