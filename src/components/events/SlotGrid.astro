---
// Skład jako okienka: zielone zajęte, pomarańczowe wolne, czerwone lista rezerwowa.
// Zalogowani widzą nicki; goście tylko kolory (bez danych osób, FR-001).
import type { Participant } from "@/types";

interface Props {
  teamSize: number;
  /** Nick grającego organizatora (pierwsze okienko) albo null, gdy organizator nie gra. */
  organizerName: string | null;
  participants: Participant[];
  reserveSpots: number;
  reserves: Participant[];
  /** Po odwołaniu przez organizatora oznaczamy osoby, które jeszcze nie odpowiedziały. */
  handover: boolean;
  /** Dla gości: liczby zajętych miejsc bez nicków. */
  anonymous?: { taken: number; reserved: number };
  /** Id ogłoszenia, gdy ogląda organizator: przy osobach pojawia się przycisk „Usuń”. */
  removeFor?: string;
}

const { teamSize, organizerName, participants, reserveSpots, reserves, handover, anonymous, removeFor } = Astro.props;

interface Slot {
  kind: "taken" | "free";
  name?: string;
  note?: string;
  participationId?: string;
}

const taken: Slot[] = anonymous
  ? Array.from({ length: anonymous.taken }, () => ({ kind: "taken" as const }))
  : [
      ...(organizerName ? [{ kind: "taken" as const, name: organizerName, note: "organizator" }] : []),
      ...participants.map((p) => ({
        kind: "taken" as const,
        name: p.display_name,
        participationId: p.participation_id,
        note: handover && p.stay_confirmed == null ? "nie potwierdził(a)" : undefined,
      })),
    ];
const team: Slot[] = [
  ...taken,
  ...Array.from({ length: Math.max(teamSize - taken.length, 0) }, () => ({ kind: "free" as const })),
];

const reserveTaken: Slot[] = anonymous
  ? Array.from({ length: anonymous.reserved }, () => ({ kind: "taken" as const }))
  : reserves.map((p, i) => ({
      kind: "taken" as const,
      name: p.display_name,
      note: `${String(i + 1)}. w kolejce`,
      participationId: p.participation_id,
    }));
const reserve: Slot[] = [
  ...reserveTaken,
  ...Array.from({ length: Math.max(reserveSpots - reserveTaken.length, 0) }, () => ({ kind: "free" as const })),
];

const base = "min-h-12 rounded-lg border px-2 py-1.5 text-xs leading-tight";
---

<section class="mt-6" data-testid="slots">
  <h2 class="mb-2 font-semibold">Skład</h2>
  <ul class="grid grid-cols-3 gap-2 sm:grid-cols-4" data-testid="participants">
    {team.map((slot) =>
      slot.kind === "taken" ? (
        <li class:list={[base, "border-green-300 bg-green-100 text-green-900"]} data-slot="taken">
          <span class="block truncate font-medium">{slot.name ?? "Zajęte"}</span>
          {slot.note && <span class="block truncate text-[11px] text-green-900">{slot.note}</span>}
          {removeFor && slot.participationId && (
            <form
              method="POST"
              action={`/api/participations/${slot.participationId}/remove`}
              onsubmit="return confirm('Usunąć tę osobę ze spotkania? Nie będzie mogła zgłosić się ponownie.')"
            >
              <input type="hidden" name="eventId" value={removeFor} />
              <button
                type="submit"
                class="mt-1 text-[11px] text-green-900 underline hover:text-slate-900"
                aria-label={`Usuń ${slot.name ?? ""}`}
              >
                Usuń
              </button>
            </form>
          )}
        </li>
      ) : (
        <li class:list={[base, "border-dashed border-orange-300 bg-orange-50 text-orange-900"]} data-slot="free">
          Wolne
        </li>
      ),
    )}
  </ul>

  {reserveSpots > 0 && (
    <>
      <h3 class="mt-4 mb-2 text-sm font-semibold">Lista rezerwowa</h3>
      <ul class="grid grid-cols-3 gap-2 sm:grid-cols-4" data-testid="reserves">
        {reserve.map((slot) =>
          slot.kind === "taken" ? (
            <li class:list={[base, "border-red-300 bg-red-100 text-red-900"]} data-slot="reserve">
              <span class="block truncate font-medium">{slot.name ?? "Rezerwa"}</span>
              {slot.note && <span class="block truncate text-[11px] text-red-900">{slot.note}</span>}
              {removeFor && slot.participationId && (
                <form
                  method="POST"
                  action={`/api/participations/${slot.participationId}/remove`}
                  onsubmit="return confirm('Usunąć tę osobę ze spotkania? Nie będzie mogła zgłosić się ponownie.')"
                >
                  <input type="hidden" name="eventId" value={removeFor} />
                  <button
                    type="submit"
                    class="mt-1 text-[11px] text-red-900 underline hover:text-slate-900"
                    aria-label={`Usuń ${slot.name ?? ""}`}
                  >
                    Usuń
                  </button>
                </form>
              )}
            </li>
          ) : (
            <li class:list={[base, "border-dashed border-red-300 bg-red-50 text-red-900"]} data-slot="reserve-free">
              Wolna rezerwa
            </li>
          ),
        )}
      </ul>
    </>
  )}

  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-slate-500">
    <span>
      <span class="mr-1 inline-block size-2.5 rounded-sm bg-green-500/60"></span>zajęte
    </span>
    <span>
      <span class="mr-1 inline-block size-2.5 rounded-sm bg-orange-500/60"></span>wolne
    </span>
    {reserveSpots > 0 && (
      <span>
        <span class="mr-1 inline-block size-2.5 rounded-sm bg-red-500/60"></span>rezerwa
      </span>
    )}
  </p>
</section>
