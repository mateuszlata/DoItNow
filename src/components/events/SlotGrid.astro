---
// Skład jako koszulki (projekt D2): zalogowani widzą graczy w ich barwach (strój = avatar) z nickami,
// goście — jednolite kremowe koszulki bez danych osób (FR-001). Ciemnozielone „+” to wolne miejsca,
// pod spodem ławka rezerwowych.
import Jersey from "@/components/Jersey.astro";
import KitJersey from "@/components/KitJersey";
import type { PlayerKit } from "@/lib/kit";
import { jerseyNumber } from "@/lib/jerseys";
import type { GuestGroup, Participant } from "@/types";

interface Props {
  teamSize: number;
  /** Nick grającego organizatora (pierwsza koszulka, kapitan) albo null, gdy organizator nie gra. */
  organizerName: string | null;
  /** Strój grającego organizatora. */
  organizerKit?: PlayerKit;
  participants: Participant[];
  reserveSpots: number;
  reserves: Participant[];
  /** Po odwołaniu przez organizatora oznaczamy osoby, które jeszcze nie odpowiedziały. */
  handover: boolean;
  /** Pule zaproszeń znajomych spoza Metando — goście stoją przy osobie, która ich zaprosiła. */
  guestGroups?: GuestGroup[];
  organizerId?: string;
  /** Dla gości: liczby zajętych miejsc bez nicków. */
  anonymous?: { taken: number; reserved: number };
  /** Id ogłoszenia, gdy ogląda organizator: przy osobach pojawia się przycisk „Usuń”. */
  removeFor?: string;
  /** Id oglądającego — jego koszulka jest pomarańczowa. */
  viewerId?: string;
  /** Sport wydarzenia — wybiera krój stroju. */
  sport?: string;
}

const {
  sport,
  teamSize,
  organizerName,
  organizerKit,
  participants,
  guestGroups = [],
  organizerId,
  reserveSpots,
  reserves,
  handover,
  anonymous,
  removeFor,
  viewerId,
} = Astro.props;

interface Slot {
  kind: "taken" | "free";
  number: string;
  name?: string;
  kit?: PlayerKit;
  note?: string;
  captain?: boolean;
  guest?: boolean;
  /** Zaproszony bez odpowiedzi („?”). */
  pending?: boolean;
  mine?: boolean;
  participationId?: string;
}

type Person = Omit<Slot, "kind" | "number"> & { userId?: string };

/** Goście jednej puli: potwierdzeni z imieniem i „?” bez odpowiedzi, z podpisem, kto ich zaprosił. */
function guestSlots(group: GuestGroup): Person[] {
  // Imion nie odmieniamy automatycznie, więc „zaprasza: Kuba” zamiast „od Kuby”.
  const from =
    group.inviter_id === viewerId
      ? "Twój gość"
      : group.inviter_id === organizerId
        ? `zaprasza: ${group.inviter_name} (organizator)`
        : `zaprasza: ${group.inviter_name}${group.in_squad ? "" : " (zrezygnował/a)"}`;
  return [
    ...group.confirmed.map((name) => ({ name, note: from, guest: true })),
    ...Array.from({ length: Math.max(group.reserved - group.confirmed.length, 0) }, () => ({
      name: "zaproszony",
      note: from,
      guest: true,
      pending: true,
    })),
  ];
}

const people: Person[] = [
  ...(organizerName ? [{ name: organizerName, kit: organizerKit, captain: true, userId: organizerId }] : []),
  ...participants.map((p) => ({
    name: p.display_name,
    kit: p.kit,
    mine: p.user_id === viewerId,
    participationId: p.participation_id,
    note: handover && p.stay_confirmed == null ? "nie potwierdził(a)" : undefined,
    userId: p.user_id,
  })),
];
// Goście zaraz za osobą, która ich zaprosiła; pule osób spoza składu — na końcu.
const placed = new Set<string>();
const withGuests: Person[] = people.flatMap((person) => {
  const group = guestGroups.find((g) => g.inviter_id === person.userId);
  if (!group) return [person];
  placed.add(group.inviter_id);
  return [person, ...guestSlots(group)];
});
const others = guestGroups.filter((g) => !placed.has(g.inviter_id)).flatMap(guestSlots);

const taken: Slot[] = anonymous
  ? Array.from({ length: anonymous.taken }, (_, i) => ({ kind: "taken" as const, number: jerseyNumber(i) }))
  : [...withGuests, ...others].map(({ userId: _userId, ...p }, i) => ({
      kind: "taken" as const,
      number: jerseyNumber(i),
      ...p,
    }));
const team: Slot[] = [
  ...taken,
  ...Array.from({ length: Math.max(teamSize - taken.length, 0) }, () => ({ kind: "free" as const, number: "+" })),
];

const bench: Slot[] = [
  ...(anonymous
    ? Array.from({ length: anonymous.reserved }, (_, i) => ({ kind: "taken" as const, number: `R${String(i + 1)}` }))
    : reserves.map((p, i) => ({
        kind: "taken" as const,
        number: `R${String(i + 1)}`,
        name: p.display_name,
        kit: p.kit,
        mine: p.user_id === viewerId,
        participationId: p.participation_id,
      }))),
];
const benchAll: Slot[] = [
  ...bench,
  ...Array.from({ length: Math.max(reserveSpots - bench.length, 0) }, (_, i) => ({
    kind: "free" as const,
    number: `R${String(bench.length + i + 1)}`,
  })),
];
---

<section class="flex flex-col gap-4 rounded-[20px] bg-page-2 px-3.5 py-4 text-page-ink" data-testid="slots">
  <h2 class="display display-hero text-[30px]">Skład</h2>
  <ul class="grid grid-cols-4 gap-x-1 gap-y-3" data-testid="participants">
    {team.map((slot) =>
      slot.kind === "taken" ? (
        <li
          class="relative flex flex-col items-center gap-1"
          data-slot={slot.pending ? "invited" : slot.guest ? "guest" : "taken"}
          title={
            slot.captain
              ? "organizator (kapitan)"
              : slot.pending
                ? "zaproszony przez organizatora — jeszcze nie odpowiedział"
                : slot.guest
                  ? "znajomy organizatora spoza Metando"
                  : undefined
          }
        >
          {slot.kit ? (
            <span class:list={["rounded-2xl p-0.5", slot.mine && "bg-brand/30 ring-2 ring-brand"]}>
              <KitJersey kit={slot.kit} sport={sport} width={54} />
            </span>
          ) : slot.pending ? (
            <Jersey sport={sport} fill="#1F5444" trim="#FFC58F" numberColor="#FFC58F" label="?" />
          ) : slot.guest ? (
            <Jersey sport={sport} fill="#2B6553" trim="#F3EAD3" numberColor="#F3EAD3" label="G" />
          ) : (
            <Jersey sport={sport} fill="#F3EAD3" trim="#FF7A1A" label={slot.number} />
          )}
          {slot.captain && (
            <span
              class="display absolute top-0 left-1 grid size-6 place-items-center rounded-full bg-brand text-sm text-on-brand shadow-[0_0_0_3px_var(--page-2)]"
              aria-hidden="true"
            >
              K
            </span>
          )}
          <span
            class:list={[
              "max-w-full truncate px-1 text-xs font-bold",
              slot.mine ? "text-brand" : slot.guest ? "text-page-ink-2" : "text-page-ink",
            ]}
          >
            {slot.name ?? "zajęte"}
            {slot.captain && <span class="sr-only"> (kapitan, organizator)</span>}
          </span>
          {slot.note && <span class="text-xs text-bench">{slot.note}</span>}
          {removeFor && slot.participationId && (
            <form
              method="POST"
              action={`/api/participations/${slot.participationId}/remove`}
              class="absolute -top-1.5 right-0"
              onsubmit="return confirm('Usunąć tę osobę ze spotkania? Nie będzie mogła zgłosić się ponownie.')"
            >
              <input type="hidden" name="eventId" value={removeFor} />
              <button
                type="submit"
                aria-label={`Usuń ${slot.name ?? ""}`}
                class="grid size-[26px] place-items-center rounded-full bg-bad text-white shadow-[0_0_0_3px_var(--page-2)]"
              >
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              </button>
            </form>
          )}
        </li>
      ) : (
        <li class="flex flex-col items-center gap-1" data-slot="free">
          <Jersey sport={sport} fill="#1F5444" trim="#2B6553" numberColor="#FF7A1A" label="+" />
          <span class="text-xs font-bold text-page-ink-2">wolne</span>
        </li>
      ),
    )}
  </ul>

  {reserveSpots > 0 && (
    <>
      <div class="sleeve" aria-hidden="true">
        <span />
        <span />
      </div>
      <div class="flex items-baseline justify-between">
        <h3 class="display text-[22px]">Ławka rezerwowych</h3>
        <span class="text-[13px] font-bold text-bench">
          {bench.length} z {reserveSpots}
        </span>
      </div>
      <ul class="flex flex-wrap justify-around gap-3" data-testid="reserves">
        {benchAll.map((slot) =>
          slot.kind === "taken" ? (
            <li class="relative flex flex-col items-center gap-1" data-slot="reserve">
              {slot.kit ? (
                <span class:list={["rounded-2xl p-0.5", slot.mine && "bg-brand/30 ring-2 ring-brand"]}>
                  <KitJersey kit={slot.kit} sport={sport} width={46} />
                </span>
              ) : (
                <Jersey sport={sport} fill="#FFC58F" numberColor="#0F3B2E" label={slot.number} width={50} />
              )}
              {slot.kit && (
                <span
                  class="display absolute top-0 -left-1 grid h-5 min-w-5 place-items-center rounded-full bg-bench px-1 text-xs text-page-deep shadow-[0_0_0_3px_var(--page-2)]"
                  aria-hidden="true"
                >
                  {slot.number}
                </span>
              )}
              <span class="max-w-20 truncate text-xs font-bold text-bench">{slot.name ?? "rezerwa"}</span>
              {removeFor && slot.participationId && (
                <form
                  method="POST"
                  action={`/api/participations/${slot.participationId}/remove`}
                  class="absolute -top-1.5 -right-2"
                  onsubmit="return confirm('Usunąć tę osobę z listy rezerwowej? Nie będzie mogła zgłosić się ponownie.')"
                >
                  <input type="hidden" name="eventId" value={removeFor} />
                  <button
                    type="submit"
                    aria-label={`Usuń ${slot.name ?? ""}`}
                    class="grid size-[26px] place-items-center rounded-full bg-bad text-white shadow-[0_0_0_3px_var(--page-2)]"
                  >
                    <svg
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.2"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </button>
                </form>
              )}
            </li>
          ) : (
            <li class="flex flex-col items-center gap-1" data-slot="reserve-free">
              <Jersey sport={sport} fill="#3D3A1E" numberColor="#FFC58F" label={slot.number} width={50} />
              <span class="text-xs font-bold text-bench">wolne</span>
            </li>
          ),
        )}
      </ul>
    </>
  )}
</section>
