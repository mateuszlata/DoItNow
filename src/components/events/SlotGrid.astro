---
// Skład jako koszulki z numerami (projekt D2): kremowe zajęte, pomarańczowa Twoja, ciemnozielone „+” wolne,
// a pod spodem ławka rezerwowych. Zalogowani widzą nicki; goście tylko koszulki (bez danych osób, FR-001).
import Jersey from "@/components/Jersey.astro";
import { jerseyNumber } from "@/lib/jerseys";
import type { Participant } from "@/types";

interface Props {
  teamSize: number;
  /** Nick grającego organizatora (pierwsza koszulka, kapitan) albo null, gdy organizator nie gra. */
  organizerName: string | null;
  participants: Participant[];
  reserveSpots: number;
  reserves: Participant[];
  /** Po odwołaniu przez organizatora oznaczamy osoby, które jeszcze nie odpowiedziały. */
  handover: boolean;
  /** Dla gości: liczby zajętych miejsc bez nicków. */
  anonymous?: { taken: number; reserved: number };
  /** Id ogłoszenia, gdy ogląda organizator: przy osobach pojawia się przycisk „Usuń”. */
  removeFor?: string;
  /** Id oglądającego — jego koszulka jest pomarańczowa. */
  viewerId?: string;
  /** Sport wydarzenia — wybiera krój stroju. */
  sport?: string;
}

const {
  sport,
  teamSize,
  organizerName,
  participants,
  reserveSpots,
  reserves,
  handover,
  anonymous,
  removeFor,
  viewerId,
} = Astro.props;

interface Slot {
  kind: "taken" | "free";
  number: string;
  name?: string;
  note?: string;
  captain?: boolean;
  mine?: boolean;
  participationId?: string;
}

const taken: Slot[] = anonymous
  ? Array.from({ length: anonymous.taken }, (_, i) => ({ kind: "taken" as const, number: jerseyNumber(i) }))
  : [
      ...(organizerName ? [{ name: organizerName, captain: true }] : []),
      ...participants.map((p) => ({
        name: p.display_name,
        mine: p.user_id === viewerId,
        participationId: p.participation_id,
        note: handover && p.stay_confirmed == null ? "nie potwierdził(a)" : undefined,
      })),
    ].map((p, i) => ({ kind: "taken" as const, number: jerseyNumber(i), ...p }));
const team: Slot[] = [
  ...taken,
  ...Array.from({ length: Math.max(teamSize - taken.length, 0) }, () => ({ kind: "free" as const, number: "+" })),
];

const bench: Slot[] = [
  ...(anonymous
    ? Array.from({ length: anonymous.reserved }, (_, i) => ({ kind: "taken" as const, number: `R${String(i + 1)}` }))
    : reserves.map((p, i) => ({
        kind: "taken" as const,
        number: `R${String(i + 1)}`,
        name: p.display_name,
        mine: p.user_id === viewerId,
        participationId: p.participation_id,
      }))),
];
const benchAll: Slot[] = [
  ...bench,
  ...Array.from({ length: Math.max(reserveSpots - bench.length, 0) }, (_, i) => ({
    kind: "free" as const,
    number: `R${String(bench.length + i + 1)}`,
  })),
];
---

<section class="flex flex-col gap-4 rounded-[20px] bg-page-2 px-3.5 py-4 text-page-ink" data-testid="slots">
  <h2 class="display display-hero text-[30px]">Skład</h2>
  <ul class="grid grid-cols-4 gap-x-1 gap-y-3" data-testid="participants">
    {team.map((slot) =>
      slot.kind === "taken" ? (
        <li
          class="relative flex flex-col items-center gap-1"
          data-slot="taken"
          title={slot.captain ? "organizator (kapitan)" : undefined}
        >
          <Jersey
            sport={sport}
            fill={slot.mine ? "#FF7A1A" : "#F3EAD3"}
            trim={slot.mine ? "#0F3B2E" : "#FF7A1A"}
            label={slot.number}
          />
          {slot.captain && (
            <span
              class="display absolute top-0 left-1 grid size-6 place-items-center rounded-full bg-brand text-sm text-on-brand shadow-[0_0_0_3px_var(--page-2)]"
              aria-hidden="true"
            >
              K
            </span>
          )}
          <span class:list={["max-w-full truncate px-1 text-xs font-bold", slot.mine ? "text-brand" : "text-page-ink"]}>
            {slot.name ?? "zajęte"}
            {slot.captain && <span class="sr-only"> (kapitan, organizator)</span>}
          </span>
          {slot.note && <span class="text-[11px] text-bench">{slot.note}</span>}
          {removeFor && slot.participationId && (
            <form
              method="POST"
              action={`/api/participations/${slot.participationId}/remove`}
              class="absolute -top-1.5 right-0"
              onsubmit="return confirm('Usunąć tę osobę ze spotkania? Nie będzie mogła zgłosić się ponownie.')"
            >
              <input type="hidden" name="eventId" value={removeFor} />
              <button
                type="submit"
                aria-label={`Usuń ${slot.name ?? ""}`}
                class="grid size-[26px] place-items-center rounded-full bg-bad text-white shadow-[0_0_0_3px_var(--page-2)]"
              >
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              </button>
            </form>
          )}
        </li>
      ) : (
        <li class="flex flex-col items-center gap-1" data-slot="free">
          <Jersey sport={sport} fill="#1F5444" trim="#2B6553" numberColor="#FF7A1A" label="+" />
          <span class="text-xs font-bold text-page-ink-2">wolne</span>
        </li>
      ),
    )}
  </ul>

  {reserveSpots > 0 && (
    <>
      <div class="sleeve" aria-hidden="true">
        <span />
        <span />
      </div>
      <div class="flex items-baseline justify-between">
        <h3 class="display text-[22px]">Ławka rezerwowych</h3>
        <span class="text-[13px] font-bold text-bench">
          {bench.length} z {reserveSpots}
        </span>
      </div>
      <ul class="flex flex-wrap justify-around gap-3" data-testid="reserves">
        {benchAll.map((slot) =>
          slot.kind === "taken" ? (
            <li class="relative flex flex-col items-center gap-1" data-slot="reserve">
              <Jersey
                sport={sport}
                fill={slot.mine ? "#FF7A1A" : "#FFC58F"}
                numberColor="#0F3B2E"
                label={slot.number}
                width={50}
              />
              <span class="max-w-20 truncate text-xs font-bold text-bench">{slot.name ?? "rezerwa"}</span>
              {removeFor && slot.participationId && (
                <form
                  method="POST"
                  action={`/api/participations/${slot.participationId}/remove`}
                  class="absolute -top-1.5 -right-2"
                  onsubmit="return confirm('Usunąć tę osobę z listy rezerwowej? Nie będzie mogła zgłosić się ponownie.')"
                >
                  <input type="hidden" name="eventId" value={removeFor} />
                  <button
                    type="submit"
                    aria-label={`Usuń ${slot.name ?? ""}`}
                    class="grid size-[26px] place-items-center rounded-full bg-bad text-white shadow-[0_0_0_3px_var(--page-2)]"
                  >
                    <svg
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.2"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </button>
                </form>
              )}
            </li>
          ) : (
            <li class="flex flex-col items-center gap-1" data-slot="reserve-free">
              <Jersey sport={sport} fill="#3D3A1E" numberColor="#FFC58F" label={slot.number} width={50} />
              <span class="text-xs font-bold text-bench">wolne</span>
            </li>
          ),
        )}
      </ul>
    </>
  )}
</section>
