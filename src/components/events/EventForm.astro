---
// Formularz ogłoszenia wspólny dla dodawania (FR-003) i edycji (FR-004).
import type { EventFormValues, FieldErrors } from "@/lib/services/events";
import { SPORTS } from "@/lib/sports";
import { nowLocalDateTime } from "@/lib/time";
import MapPicker from "@/components/map/MapPicker";

interface Props {
  values: EventFormValues;
  errors: FieldErrors;
  submitLabel: string;
}

const { values, errors, submitLabel } = Astro.props;

const minStartsAt = nowLocalDateTime();
const inputClass =
  "mt-1 w-full rounded-lg border bg-white shadow-sm px-3 py-2 text-slate-900 placeholder-slate-400 focus:ring-2 focus:outline-none";
const borderClass = (name: keyof FieldErrors) =>
  errors[name] ? "border-red-300 focus:ring-red-400" : "border-slate-300 focus:ring-orange-400";
---

{errors.form && <p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{errors.form}</p>}

<form method="POST" class="grid gap-4" novalidate>
  <label class="text-sm text-slate-700">
    Sport
    <select name="sport" required class:list={[inputClass, borderClass("sport")]}>
      <option value="" class="text-black">
        Wybierz…
      </option>
      {SPORTS.map((s) => (
        <option value={s.id} selected={s.id === values.sport} class="text-black">
          {s.label}
        </option>
      ))}
    </select>
    {errors.sport && <span class="mt-1 block text-xs text-red-600">{errors.sport}</span>}
  </label>

  <label class="text-sm text-slate-700">
    Data i godzina
    <input
      type="datetime-local"
      name="startsAt"
      required
      min={minStartsAt}
      value={values.startsAt}
      class:list={[inputClass, borderClass("startsAt")]}
    />
    {errors.startsAt && <span class="mt-1 block text-xs text-red-600">{errors.startsAt}</span>}
  </label>

  <label class="text-sm text-slate-700">
    Okolica / dzielnica
    <input
      type="text"
      name="area"
      required
      maxlength="80"
      placeholder="np. Mokotów"
      value={values.area}
      class:list={[inputClass, borderClass("area")]}
    />
    <span class="mt-1 block text-xs text-slate-500">Widoczna dla wszystkich, także niezalogowanych.</span>
    {errors.area && <span class="mt-1 block text-xs text-red-600">{errors.area}</span>}
  </label>

  <label class="text-sm text-slate-700">
    Dokładne miejsce
    <input
      type="text"
      name="place"
      required
      maxlength="200"
      placeholder="np. Orlik przy ul. Dolnej 5"
      value={values.place}
      class:list={[inputClass, borderClass("place")]}
    />
    <span class="mt-1 block text-xs text-slate-500">Widoczne tylko dla zalogowanych.</span>
    {errors.place && <span class="mt-1 block text-xs text-red-600">{errors.place}</span>}
  </label>

  <label class="text-sm text-slate-700">
    Ile osób łącznie w składzie?
    <input
      type="number"
      name="total"
      required
      min="1"
      max="50"
      placeholder="np. 12 przy grze 6 na 6"
      value={values.total}
      class:list={[inputClass, borderClass("total")]}
    />
    {errors.total && <span class="mt-1 block text-xs text-red-600">{errors.total}</span>}
  </label>

  <label class="flex items-start gap-2 text-sm text-slate-700">
    <input
      type="checkbox"
      name="organizerPlays"
      checked={values.organizerPlays === "on"}
      class="mt-0.5 size-4 accent-orange-600"
    />
    <span>
      Biorę udział w spotkaniu
      <span class="block text-xs text-slate-500">Zajmujesz jedno miejsce w składzie.</span>
    </span>
  </label>

  <label class="flex items-start gap-2 text-sm text-slate-700">
    <input
      type="checkbox"
      name="requiresApproval"
      checked={values.requiresApproval === "on"}
      class="mt-0.5 size-4 accent-orange-600"
    />
    <span>
      Wymagaj mojej akceptacji
      <span class="block text-xs text-slate-500">
        Bez zaznaczenia każdy zalogowany dołącza od razu; niechcianą osobę możesz usunąć.
      </span>
    </span>
  </label>

  <div class="grid grid-cols-2 gap-3">
    <label class="text-sm text-slate-700">
      Minimum osób (opcjonalnie)
      <input
        type="number"
        name="minPeople"
        min="1"
        max="50"
        placeholder="np. 8"
        value={values.minPeople}
        class:list={[inputClass, borderClass("minPeople")]}
      />
      <span class="mt-1 block text-xs text-slate-500">Ilu osób potrzeba, żeby zagrać.</span>
      {errors.minPeople && <span class="mt-1 block text-xs text-red-600">{errors.minPeople}</span>}
    </label>
    <label class="text-sm text-slate-700">
      Miejsca rezerwowe
      <input
        type="number"
        name="reserveSpots"
        min="0"
        max="50"
        placeholder="0"
        value={values.reserveSpots}
        class:list={[inputClass, borderClass("reserveSpots")]}
      />
      <span class="mt-1 block text-xs text-slate-500">Wskakują, gdy ktoś zrezygnuje.</span>
      {errors.reserveSpots && <span class="mt-1 block text-xs text-red-600">{errors.reserveSpots}</span>}
    </label>
  </div>

  <div class="text-sm text-slate-700">
    Miejsce na mapie (opcjonalnie)
    <div class="mt-1">
      <MapPicker initialLat={values.lat} initialLng={values.lng} client:visible />
    </div>
    <span class="mt-1 block text-xs text-slate-500">Widoczne tylko dla zalogowanych.</span>
    {errors.lat && <span class="mt-1 block text-xs text-red-600">{errors.lat}</span>}
  </div>

  <label class="text-sm text-slate-700">
    Opis (opcjonalnie)
    <textarea
      name="description"
      rows="3"
      maxlength="1000"
      placeholder="Poziom gry, co zabrać, jak się rozpoznać…"
      class:list={[inputClass, borderClass("description")]}
    >{values.description}</textarea>
    {errors.description && <span class="mt-1 block text-xs text-red-600">{errors.description}</span>}
  </label>

  <button
    type="submit"
    class="rounded-lg bg-orange-600 px-4 py-2 font-medium text-white transition-colors hover:bg-orange-700"
  >
    {submitLabel}
  </button>
</form>
