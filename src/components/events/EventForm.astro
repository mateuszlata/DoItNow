---
// Formularz ogłoszenia wspólny dla dodawania (FR-003) i edycji (FR-004). Spotkanie może odbyć się
// na obiekcie zarządcy — wtedy miejsce i pinezka pochodzą z obiektu, a koszt z jego cennika.
import type { EventFormValues, FieldErrors } from "@/lib/services/events";
import { formatHours } from "@/lib/services/venues";
import { formatPLN } from "@/lib/money";
import { SPORTS } from "@/lib/sports";
import { nowLocalDateTime } from "@/lib/time";
import type { VenueWithHours } from "@/types";
import MapPicker from "@/components/map/MapPicker";

interface Props {
  values: EventFormValues;
  errors: FieldErrors;
  submitLabel: string;
  /** Obiekty do wyboru (puste — bez wyboru obiektu). */
  venues?: VenueWithHours[];
}

const { values, errors, submitLabel, venues = [] } = Astro.props;

const minStartsAt = nowLocalDateTime();
const DURATIONS = [30, 45, 60, 90, 120, 150, 180, 240, 300, 360];
const durationLabel = (m: number) => (m < 60 ? `${String(m)} min` : `${String(m / 60).replace(".", ",")} h`);
const ownPlace = values.venueId === "";
const moreOpen =
  values.requiresApproval === "on" ||
  values.minPeople !== "" ||
  (values.reserveSpots !== "" && values.reserveSpots !== "0") ||
  values.description !== "" ||
  Boolean(errors.minPeople ?? errors.reserveSpots ?? errors.description);
const inputClass =
  "mt-1 w-full rounded-lg border bg-card px-3 py-2 text-ink placeholder-ink-3 focus:ring-2 focus:outline-none";
const borderClass = (name: keyof FieldErrors) =>
  errors[name] ? "border-bad-line focus:ring-red-400" : "border-line-strong focus:ring-brand";
---

{errors.form && <p class="mb-4 rounded-2xl bg-bad-soft px-3 py-2 text-sm text-bad">{errors.form}</p>}

<form method="POST" class="grid gap-4" novalidate data-event-form>
  <label class="text-sm text-ink-2">
    Sport
    <select name="sport" required class:list={[inputClass, borderClass("sport")]}>
      <option value="">Wybierz…</option>
      {SPORTS.map((s) => (
        <option value={s.id} selected={s.id === values.sport}>
          {s.label}
        </option>
      ))}
    </select>
    {errors.sport && <span class="mt-1 block text-xs text-bad">{errors.sport}</span>}
  </label>

  <div class="grid grid-cols-[1fr_auto] gap-3">
    <label class="text-sm text-ink-2">
      Data i godzina
      <input
        type="datetime-local"
        name="startsAt"
        required
        min={minStartsAt}
        value={values.startsAt}
        class:list={[inputClass, borderClass("startsAt")]}
      />
    </label>
    <label class="text-sm text-ink-2">
      Czas trwania
      <select name="durationMinutes" class:list={[inputClass, borderClass("durationMinutes")]}>
        {DURATIONS.map((m) => (
          <option value={String(m)} selected={String(m) === (values.durationMinutes || "90")}>
            {durationLabel(m)}
          </option>
        ))}
      </select>
    </label>
  </div>
  {errors.startsAt && <span class="-mt-3 block text-xs text-bad">{errors.startsAt}</span>}
  {errors.durationMinutes && <span class="-mt-3 block text-xs text-bad">{errors.durationMinutes}</span>}

  {venues.length > 0 && (
    <label class="text-sm text-ink-2">
      Obiekt (opcjonalnie)
      <select name="venueId" class:list={[inputClass, borderClass("venueId")]} data-venue-select>
        <option value="">Bez obiektu — wpiszę miejsce samodzielnie</option>
        {venues.map((v) => (
          <option
            value={v.id}
            selected={v.id === values.venueId}
            data-price={String(v.price_per_hour_cents)}
            data-hours={formatHours(v.hours)}
            data-sports={v.sports.join(",")}
          >
            {v.name} · {v.area} · {formatPLN(v.price_per_hour_cents)}/h
          </option>
        ))}
      </select>
      <span class="mt-1 block text-xs text-ink-3" data-venue-hours />
      <span class="mt-1 block text-xs text-ink-3" data-venue-count />
      {errors.venueId && <span class="mt-1 block text-xs text-bad">{errors.venueId}</span>}
    </label>
  )}
  <p class="-mt-2 text-xs text-ink-3">
    Zarządzasz obiektem?{" "}
    <a href="/venues/new" class="font-bold text-ink-2 underline">
      Dodaj go do Metando
    </a>
    .
  </p>

  <p class="rounded-2xl bg-card-2 px-4 py-3 text-sm text-ink" data-cost hidden>
    Koszt obiektu: <strong data-cost-total></strong> · na osobę <strong data-cost-share></strong>
    <span class="block text-xs text-ink-3">Koszt dzieli się równo na wszystkie miejsca w składzie.</span>
  </p>

  <div class="grid gap-4" data-own-place hidden={!ownPlace}>
    <label class="text-sm text-ink-2">
      Okolica / dzielnica
      <input
        type="text"
        name="area"
        maxlength="80"
        placeholder="np. Mokotów"
        value={values.area}
        class:list={[inputClass, borderClass("area")]}
      />
      <span class="mt-1 block text-xs text-ink-3">Widoczna dla wszystkich, także niezalogowanych.</span>
      {errors.area && <span class="mt-1 block text-xs text-bad">{errors.area}</span>}
    </label>

    <div class="text-sm text-ink-2">
      <MapPicker
        initialLat={values.lat}
        initialLng={values.lng}
        inputName="place"
        initialQuery={values.place}
        label="Dokładne miejsce"
        error={errors.place}
        client:load
      />
      <span class="mt-1 block text-xs text-ink-3">
        Wybierz podpowiedź albo opisz miejsce własnymi słowami i kliknij w mapę. Widoczne tylko dla zalogowanych.
      </span>
      {errors.lat && <span class="mt-1 block text-xs text-bad">{errors.lat}</span>}
    </div>
  </div>

  <label class="text-sm text-ink-2">
    Ile osób łącznie w składzie?
    <input
      type="number"
      name="total"
      required
      min="1"
      max="50"
      placeholder="np. 12 przy grze 6 na 6"
      value={values.total}
      class:list={[inputClass, borderClass("total")]}
    />
    {errors.total && <span class="mt-1 block text-xs text-bad">{errors.total}</span>}
  </label>

  <label class="flex items-start gap-2 text-sm text-ink-2">
    <input
      type="checkbox"
      name="organizerPlays"
      checked={values.organizerPlays === "on"}
      class="mt-0.5 size-4 accent-brand"
    />
    <span>
      Biorę udział w spotkaniu
      <span class="block text-xs text-ink-3">Zajmujesz jedno miejsce w składzie.</span>
    </span>
  </label>

  <label class="text-sm text-ink-2">
    Przyprowadzasz znajomych spoza Metando? (opcjonalnie)
    <input
      type="number"
      name="guests"
      min="0"
      max="49"
      placeholder="0"
      value={values.guests ?? ""}
      class:list={[inputClass, borderClass("guests")]}
    />
    <span class="mt-1 block text-xs text-ink-3">
      Zajmą miejsca w składzie — inni zobaczą je jako „gość organizatora”.
    </span>
    {errors.guests && <span class="mt-1 block text-xs text-bad">{errors.guests}</span>}
  </label>

  <details class="group rounded-2xl bg-card-2 px-4 py-3" open={moreOpen} data-more-options>
    <summary class="cursor-pointer text-sm font-bold text-ink">
      Więcej opcji
      <span class="font-normal text-ink-3"> — akceptacja zgłoszeń, minimum, rezerwa, opis</span>
    </summary>
    <div class="mt-4 grid gap-4">
      <label class="flex items-start gap-2 text-sm text-ink-2">
        <input
          type="checkbox"
          name="requiresApproval"
          checked={values.requiresApproval === "on"}
          class="mt-0.5 size-4 accent-brand"
        />
        <span>
          Wymagaj mojej akceptacji
          <span class="block text-xs text-ink-3">
            Bez zaznaczenia każdy zalogowany dołącza od razu; niechcianą osobę możesz usunąć.
          </span>
        </span>
      </label>

      <div class="grid grid-cols-2 gap-3">
        <label class="text-sm text-ink-2">
          Minimum osób (opcjonalnie)
          <input
            type="number"
            name="minPeople"
            min="1"
            max="50"
            placeholder="np. 8"
            value={values.minPeople}
            class:list={[inputClass, borderClass("minPeople")]}
          />
          <span class="mt-1 block text-xs text-ink-3">Ilu osób potrzeba, żeby zagrać.</span>
          {errors.minPeople && <span class="mt-1 block text-xs text-bad">{errors.minPeople}</span>}
        </label>
        <label class="text-sm text-ink-2">
          Miejsca rezerwowe
          <input
            type="number"
            name="reserveSpots"
            min="0"
            max="50"
            placeholder="0"
            value={values.reserveSpots}
            class:list={[inputClass, borderClass("reserveSpots")]}
          />
          <span class="mt-1 block text-xs text-ink-3">Wskakują, gdy ktoś zrezygnuje.</span>
          {errors.reserveSpots && <span class="mt-1 block text-xs text-bad">{errors.reserveSpots}</span>}
        </label>
      </div>

      <label class="text-sm text-ink-2">
        Opis (opcjonalnie)
        <textarea
          name="description"
          rows="3"
          maxlength="1000"
          placeholder="Poziom gry, co zabrać, jak się rozpoznać…"
          class:list={[inputClass, borderClass("description")]}
        >{values.description}</textarea>
        {errors.description && <span class="mt-1 block text-xs text-bad">{errors.description}</span>}
      </label>
    </div>
  </details>

  <button
    type="submit"
    class="h-12 rounded-full bg-brand px-4 font-bold text-on-brand transition-colors hover:bg-brand-hover"
  >
    {submitLabel}
  </button>
</form>

<script is:inline>
  // Wybór obiektu: chowa własne miejsce, pokazuje godziny otwarcia i podgląd kosztu na osobę.
  (() => {
    const form = document.querySelector("[data-event-form]");
    const select = form?.querySelector("[data-venue-select]");
    if (!form || !select) return;
    const ownPlace = form.querySelector("[data-own-place]");
    const hours = form.querySelector("[data-venue-hours]");
    const cost = form.querySelector("[data-cost]");
    const pln = (cents) =>
      new Intl.NumberFormat("pl-PL", { minimumFractionDigits: cents % 100 ? 2 : 0, maximumFractionDigits: 2 }).format(
        cents / 100,
      ) + " zł";
    const count = form.querySelector("[data-venue-count]");
    let lastSport = null;
    // Pokazuje tylko obiekty, które mają w ofercie wybrany sport.
    const filterBySport = () => {
      const sport = form.elements.sport.value;
      if (sport === lastSport) return;
      lastSport = sport;
      let matching = 0;
      for (const option of select.options) {
        if (!option.value) continue;
        const fits = !sport || option.dataset.sports.split(",").includes(sport);
        option.hidden = !fits;
        option.disabled = !fits;
        if (fits) matching++;
      }
      if (select.selectedOptions[0]?.disabled) select.value = "";
      count.textContent = !sport
        ? ""
        : matching === 0
          ? "Brak obiektów z tym sportem — wpisz miejsce poniżej."
          : "Obiekty z tym sportem: " + matching + ".";
    };
    const update = () => {
      filterBySport();
      const option = select.selectedOptions[0];
      const chosen = Boolean(select.value);
      ownPlace.hidden = chosen;
      hours.textContent = chosen ? "Otwarte: " + option.dataset.hours : "";
      const price = Number(option?.dataset.price ?? 0);
      const minutes = Number(form.elements.durationMinutes.value);
      const team = Number(form.elements.total.value);
      cost.hidden = !chosen;
      if (!chosen) return;
      const total = Math.round((price * minutes) / 60);
      cost.querySelector("[data-cost-total]").textContent = pln(total);
      cost.querySelector("[data-cost-share]").textContent = team > 0 ? pln(Math.ceil(total / team)) : "—";
    };
    form.addEventListener("input", update);
    form.addEventListener("change", update);
    update();
  })();
</script>
