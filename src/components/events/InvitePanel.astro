---
// Panel organizatora „Znajomi spoza Metando”: link zaproszenia (bez logowania) i odpowiedzi zaproszonych.
interface Props {
  eventId: string;
  /** Zarezerwowane miejsca dla znajomych (potwierdzeni + „?”). */
  guestCount: number;
  token: string | null;
  invites: { id: string; name: string; answer: "yes" | "no" }[];
  origin: string;
}

const { eventId, guestCount, token, invites, origin } = Astro.props;
const yes = invites.filter((i) => i.answer === "yes");
const no = invites.filter((i) => i.answer === "no");
const pending = Math.max(guestCount - yes.length, 0);
const link = token ? `${origin}/i/${token}` : null;
---

<section id="zaproszenia" class="scroll-mt-4 rounded-[20px] bg-card p-4 text-ink" data-testid="invite-panel">
  <h2 class="display text-2xl leading-none">Znajomi spoza Metando</h2>

  {guestCount === 0 && invites.length === 0 ? (
    <p class="mt-2 text-sm text-ink-2">
      Chcesz zaprosić znajomych bez konta? Zarezerwuj dla nich miejsca w{" "}
      <a href={`/events/${eventId}/edit`} class="font-bold text-link underline">
        edycji spotkania
      </a>
      , a dostaniesz link do wysłania.
    </p>
  ) : (
    <>
      <p class="mt-1 text-sm text-ink-2">
        Zarezerwowane miejsca: <strong>{guestCount}</strong> · będzie: <strong>{yes.length}</strong> · czeka:{" "}
        <strong>{pending}</strong>
        {no.length > 0 && <> · nie będzie: {no.length}</>}
      </p>
      <p class="mt-1 text-xs text-ink-3">
        Wyślij link znajomym — odpowiedzą „Będę” bez zakładania konta. Nieodpowiedziane miejsca zwolnią się 12 h przed
        startem.
      </p>

      {link ? (
        <div class="mt-3 flex flex-col gap-2">
          <input
            type="text"
            readonly
            value={link}
            aria-label="Link zaproszenia"
            class="w-full rounded-lg border border-line-strong bg-card-2 px-3 py-2 text-xs text-ink"
            data-invite-link
          />
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              data-invite-copy={link}
              class="h-10 rounded-full bg-brand px-4 text-sm font-extrabold tracking-wide text-on-brand uppercase"
            >
              Kopiuj link
            </button>
            <button type="button" data-invite-share={link} class="h-10 rounded-full bg-card-2 px-4 text-sm font-bold">
              Udostępnij
            </button>
          </div>
        </div>
      ) : (
        <form method="POST" action={`/api/events/${eventId}/invite`} class="mt-3">
          <button
            type="submit"
            class="h-10 rounded-full bg-brand px-4 text-sm font-extrabold tracking-wide text-on-brand uppercase"
          >
            Utwórz link zaproszenia
          </button>
        </form>
      )}

      {invites.length > 0 && (
        <ul class="mt-4 flex flex-col gap-1.5" data-testid="invite-responses">
          {invites.map((invite) => (
            <li class="flex items-center justify-between gap-3 text-sm">
              <span>
                {invite.answer === "yes" ? "✓" : "✗"} {invite.name}
                <span class="text-ink-3"> · {invite.answer === "yes" ? "będzie" : "nie będzie"}</span>
              </span>
              <form
                method="POST"
                action={`/api/invites/responses/${invite.id}/remove`}
                onsubmit="return confirm('Usunąć tę odpowiedź? Potwierdzone miejsce wróci do graczy z Metando.')"
              >
                <input type="hidden" name="eventId" value={eventId} />
                <button type="submit" class="text-xs text-ink-3 underline hover:text-bad">
                  Usuń
                </button>
              </form>
            </li>
          ))}
        </ul>
      )}
    </>
  )}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-invite-copy]").forEach((button) => {
    button.addEventListener("click", () => {
      const link = button.dataset.inviteCopy ?? "";
      void navigator.clipboard.writeText(link).then(() => {
        button.textContent = "✓ Skopiowano";
      });
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-invite-share]").forEach((button) => {
    button.addEventListener("click", () => {
      const url = button.dataset.inviteShare ?? "";
      if (typeof navigator.share === "function") {
        void navigator.share({ title: "Zaproszenie na mecz w Metando", url }).catch(() => undefined);
      } else {
        void navigator.clipboard.writeText(url).then(() => {
          button.textContent = "✓ Skopiowano";
        });
      }
    });
  });
</script>
