---
import {
  ANSWER_MAX_LENGTH,
  QUESTION_MAX_LENGTH,
  questionErrorMessage,
  type EventQuestion,
} from "@/lib/services/questions";
import EventAssistant from "@/components/events/EventAssistant";

interface Props {
  eventId: string;
  questions: EventQuestion[];
  isOrganizer: boolean;
  /** Zalogowany, nie organizator, spotkanie otwarte — może zadać pytanie. */
  canAsk: boolean;
  /** Link do logowania z powrotem na to spotkanie (dla osób bez konta). */
  signinHref: string | null;
  /** Pokazać asystenta AI (klucz API ustawiony, spotkanie nadchodzące). */
  assistant?: boolean;
}

const { eventId, questions, isOrganizer, canAsk, signinHref, assistant = false } = Astro.props;
const ok = Astro.url.searchParams.get("question-ok");
const errorCode = Astro.url.searchParams.get("question-error");
const draft = Astro.url.searchParams.get("question-draft") ?? "";
const okText: Record<string, string> = {
  ask: "Pytanie wysłane — organizator dostanie powiadomienie, a odpowiedź pojawi się tutaj.",
  answer: "Odpowiedź zapisana — widzą ją wszyscy oglądający spotkanie.",
  hide: "Pytanie ukryte.",
};
const answered = questions.filter((q) => q.answer !== null);
const waiting = questions.filter((q) => q.answer === null);
const when = new Intl.DateTimeFormat("pl-PL", {
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Warsaw",
});
const textarea =
  "w-full rounded-2xl border border-line-strong bg-card px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:ring-2 focus:ring-brand focus:outline-none";
const button =
  "h-10 rounded-full bg-brand px-4 text-xs font-extrabold tracking-wide text-on-brand uppercase transition-colors hover:bg-brand-hover";
---

{(questions.length > 0 || canAsk || signinHref) && (
  <section id="pytania" class="scroll-mt-4 rounded-[20px] bg-card p-4 text-ink" data-testid="event-questions">
    <h2 class="display text-2xl leading-none">Pytania do organizatora</h2>
    <p class="mt-1 text-xs text-ink-3">
      {isOrganizer
        ? "Twoje odpowiedzi widzą wszyscy oglądający spotkanie — bez nicku pytającego."
        : canAsk
          ? "Odpowiedzi organizatora widzą wszyscy. Twoje pytanie bez odpowiedzi widzisz tylko Ty i organizator."
          : "Odpowiedzi organizatora na pytania chętnych."}
    </p>

    {assistant && !isOrganizer && (
      <EventAssistant eventId={eventId} canAskOrganizer={canAsk} signinHref={signinHref} client:visible />
    )}

    {ok && okText[ok] && <p class="mt-3 rounded-2xl bg-ok-soft px-3 py-2 text-sm text-ok">{okText[ok]}</p>}
    {errorCode && (
      <p class="mt-3 rounded-2xl bg-bad-soft px-3 py-2 text-sm text-bad">{questionErrorMessage(errorCode)}</p>
    )}

    {waiting.length > 0 && (
      <ul class="mt-3 grid gap-2">
        {waiting.map((q) => (
          <li class="rounded-2xl border border-dashed border-line-strong px-3.5 py-2.5" data-testid="question-waiting">
            <p class="text-sm font-bold whitespace-pre-line">{q.body}</p>
            <p class="mt-0.5 text-xs text-ink-3">
              {when.format(new Date(q.created_at))} · {isOrganizer ? "czeka na Twoją odpowiedź" : "czeka na odpowiedź"}
            </p>
            {isOrganizer && (
              <form method="POST" action="/api/questions" class="mt-2 grid gap-2">
                <input type="hidden" name="action" value="answer" />
                <input type="hidden" name="eventId" value={eventId} />
                <input type="hidden" name="questionId" value={q.id} />
                <textarea
                  name="answer"
                  rows="2"
                  required
                  maxlength={ANSWER_MAX_LENGTH}
                  placeholder="Twoja odpowiedź…"
                  class:list={textarea}
                ></textarea>
                <div class="flex items-center gap-3">
                  <button type="submit" class:list={button}>
                    Odpowiedz
                  </button>
                  <button
                    type="submit"
                    formnovalidate
                    name="action"
                    value="hide"
                    class="text-xs font-semibold text-ink-3 underline"
                  >
                    Ukryj pytanie
                  </button>
                </div>
              </form>
            )}
          </li>
        ))}
      </ul>
    )}

    {answered.length > 0 && (
      <ul class="mt-3 grid gap-2">
        {answered.map((q) => (
          <li class="rounded-2xl bg-card-2 px-3.5 py-2.5" data-testid="question-answered">
            <p class="text-sm font-bold whitespace-pre-line">{q.body}</p>
            <p class="mt-1 text-sm whitespace-pre-line text-ink-2">
              <span class="font-bold text-ink">Organizator: </span>
              {q.answer}
            </p>
            {(isOrganizer || q.mine) && (
              <form method="POST" action="/api/questions" class="mt-1">
                <input type="hidden" name="action" value="hide" />
                <input type="hidden" name="eventId" value={eventId} />
                <input type="hidden" name="questionId" value={q.id} />
                <button type="submit" class="text-xs font-semibold text-ink-3 underline">
                  Ukryj
                </button>
              </form>
            )}
          </li>
        ))}
      </ul>
    )}

    {canAsk && (
      <form method="POST" action="/api/questions" class="mt-3 grid gap-2">
        <input type="hidden" name="action" value="ask" />
        <input type="hidden" name="eventId" value={eventId} />
        <label for="question-body" class="sr-only">
          Twoje pytanie
        </label>
        <textarea
          id="question-body"
          name="body"
          rows="2"
          required
          minlength="3"
          maxlength={QUESTION_MAX_LENGTH}
          placeholder="Np. czy jest parking? Czy mogę przyjść z dzieckiem?"
          class:list={textarea}
        >{draft}</textarea>
        <button type="submit" class:list={[button, "justify-self-start"]}>
          Zapytaj organizatora
        </button>
      </form>
    )}
    {signinHref && (
      <p class="mt-3 text-sm text-ink-2">
        <a href={signinHref} class="font-bold text-link underline">
          Zaloguj się
        </a>
        , aby zapytać organizatora.
      </p>
    )}
  </section>
)}
