---
// Karta ogłoszenia: kafelek z ikoną sportu w prawym górnym rogu, kolor sportu w zmiennej `--sport`
// (motyw a barwi nim całą kartę, pozostałe tylko kafelek).
import { sportVisual } from "@/lib/sports";

interface Props {
  sport: string;
  /** Wyszarzenie kart spotkań minionych lub odwołanych. */
  dimmed?: boolean;
}

const { sport, dimmed = false } = Astro.props;
const { emoji, color } = sportVisual(sport);
---

<li
  class:list={["bg-card-sport relative rounded-3xl border border-line p-5 text-ink", dimmed && "opacity-60"]}
  style={`--sport: ${color}`}
  data-sport={sport}
>
  <span
    aria-hidden="true"
    class="bg-sport-tile absolute top-4 right-4 flex size-11 items-center justify-center rounded-2xl text-2xl select-none"
    data-testid="sport-emoji"
  >
    {emoji}
  </span>
  <div class="pr-14">
    <slot />
  </div>
</li>
