---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** Opis strony i podglądu linku (Messenger, WhatsApp, wyszukiwarki). */
  description?: string;
  /** Tytuł podglądu linku, gdy ma być inny niż tytuł karty. */
  shareTitle?: string;
  /** Obrazek podglądu linku — ścieżka w /public (1200×630). */
  image?: string;
}

const DEFAULT_DESCRIPTION = "Metando — spotkaj się i zrób coś razem: znajdź ludzi do wspólnego sportu w Twoim mieście.";
const {
  title = "Metando",
  description = DEFAULT_DESCRIPTION,
  shareTitle = title,
  image = "/og/default.png",
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const imageUrl = new URL(image, Astro.url.origin).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a2e23" />
    <!-- Aplikacja na telefon (PWA): instalacja z przeglądarki, pełny ekran bez paska adresu. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Metando" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <script is:inline>
      // Android/Chrome zgłasza gotowość do instalacji zaraz po wczytaniu — zapamiętujemy ją dla przycisku
      // „Zainstaluj aplikację” (wyspa Reacta może się załadować później).
      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        window.__metandoInstall = event;
        window.dispatchEvent(new Event("metando-installable"));
      });
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Metando" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <script is:inline>
      // Diagnostyka układu na telefonach: ?diag=1 pokazuje rozmiary ekranu i elementy wystające poza stronę.
      if (new URLSearchParams(location.search).has("diag")) {
        window.addEventListener("load", () => {
          setTimeout(() => {
            const W = document.documentElement.clientWidth;
            const H = document.documentElement.scrollHeight;
            const name = (el) => {
              const cls = String(
                el.className && el.className.baseVal !== undefined ? el.className.baseVal : el.className || "",
              );
              return el.tagName.toLowerCase() + (cls ? "." + cls.split(" ").slice(0, 3).join(".") : "");
            };
            const inFixed = (el) => {
              for (let p = el; p; p = p.parentElement) if (getComputedStyle(p).position === "fixed") return true;
              return false;
            };
            const found = [];
            for (const el of document.querySelectorAll("body *")) {
              const r = el.getBoundingClientRect();
              if (r.width === 0 || r.right <= W + 1 || inFixed(el)) continue;
              const path = [];
              for (let p = el.parentElement, i = 0; p && i < 3; p = p.parentElement, i++) path.push(name(p));
              found.push({
                right: r.right,
                text: Math.round(r.right) + " W" + Math.round(r.width) + " " + name(el) + "  <  " + path.join(" < "),
              });
            }
            found.sort((a, b) => b.right - a.right);
            const rows = found.slice(0, 12).map((f) => f.text);
            const box = document.createElement("pre");
            box.style.cssText =
              "position:fixed;left:4px;right:4px;bottom:70px;z-index:99999;max-height:45vh;overflow:auto;margin:0;padding:8px;background:#fff;color:#000;font:11px/1.35 monospace;white-space:pre-wrap;border:2px solid #f00";
            box.textContent =
              "inner " +
              innerWidth +
              "x" +
              innerHeight +
              " client " +
              W +
              " scrollW " +
              document.documentElement.scrollWidth +
              " scrollH " +
              H +
              " dpr " +
              devicePixelRatio +
              " vv " +
              (window.visualViewport
                ? visualViewport.width.toFixed(0) +
                  "x" +
                  visualViewport.height.toFixed(0) +
                  " s" +
                  visualViewport.scale.toFixed(2)
                : "-") +
              "\n" +
              (rows.slice(0, 25).join("\n") || "brak wystających elementów");
            document.body.appendChild(box);
          }, 2500);
        });
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
