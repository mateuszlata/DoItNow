---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import AdvisorBubble from "@/components/AdvisorBubble";
import { ANTHROPIC_API_KEY } from "astro:env/server";

interface Props {
  title?: string;
  /** Opis strony i podglądu linku (Messenger, WhatsApp, wyszukiwarki). */
  description?: string;
  /** Tytuł podglądu linku, gdy ma być inny niż tytuł karty. */
  shareTitle?: string;
  /** Obrazek podglądu linku — ścieżka w /public (1200×630). */
  image?: string;
}

const DEFAULT_DESCRIPTION = "Metando — spotkaj się i zrób coś razem: znajdź ludzi do wspólnego sportu w Twoim mieście.";
const {
  title = "Metando",
  description = DEFAULT_DESCRIPTION,
  shareTitle = title,
  image = "/og/default.png",
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const imageUrl = new URL(image, Astro.url.origin).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a2e23" />
    <!-- Aplikacja na telefon (PWA): instalacja z przeglądarki, pełny ekran bez paska adresu. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Metando" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <script is:inline>
      // Android/Chrome zgłasza gotowość do instalacji zaraz po wczytaniu — zapamiętujemy ją dla przycisku
      // „Zainstaluj aplikację” (wyspa Reacta może się załadować później).
      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        window.__metandoInstall = event;
        window.dispatchEvent(new Event("metando-installable"));
      });
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Metando" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    {ANTHROPIC_API_KEY && <AdvisorBubble client:only="react" />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
