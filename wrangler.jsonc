{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doitnow",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Własna domena; Cloudflare sam tworzy rekordy DNS i certyfikaty. www przekierowuje middleware.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "metando.pl", "custom_domain": true },
    { "pattern": "www.metando.pl", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
