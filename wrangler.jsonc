{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doitnow",
  // Własne wejście: strony Astro i zadanie cykliczne (wysyłka powiadomień e-mail).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Własna domena; Cloudflare sam tworzy rekordy DNS i certyfikaty. www przekierowuje middleware.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "metando.pl", "custom_domain": true },
    { "pattern": "www.metando.pl", "custom_domain": true },
  ],
  // Co 5 minut: przypomnienia i wysyłka kolejki powiadomień e-mail (src/worker.ts).
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
